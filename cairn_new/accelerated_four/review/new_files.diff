+            'nvidia_smi_uuid': smi, 'physical_gpu_verified': uuid.removeprefix('GPU-') == smi.removeprefix('GPU-'),
+            'gpu_name': torch.cuda.get_device_name(device), 'compute_apps_on_this_gpu': [a for a in apps if smi in a],
