from pathlib import Path
import subprocess
import shutil
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
CONTROL = ROOT / 'dsn_pairout_cellout'
STATE = ROOT / 'logs/dsn_pairout_cellout/jobs'
OUTPUTS = CONTROL / 'outputs'
CONFIGS = CONTROL / 'configs'
APPROVAL = ROOT / 'logs/dsn_pairout_cellout/review_approval.json'
# Exact frame/source/cohort checks, byte-identical model/data copy record and
# CPU parameter inventory (tools/cohort_evidence.py). The packed DSN cross-pair
# GAT was numerically verified on GPU3 for these unchanged files and approved
# for accelerated_four; that evidence and those approvals are reused.
EVIDENCE = CONTROL / 'evidence/cohort_copy_evidence.json'
ORIGINAL = ROOT / 'accelerated_four/dsn'
PRIOR_GPU3_EVIDENCE = ROOT / 'benchmarks/gpu3_speed/evidence/gpu3_evidence.json'
PRIOR_APPROVALS = [ROOT / 'logs/gpu3_speed/review_approval.json', ROOT / 'logs/accelerated_four/review_approval.json']
# GPUs are shared with the live pure controls: require headroom, not idleness.
MIN_FREE_MIB = 8192
REVIEW_DIFF = CONTROL / 'review/implementation.diff'
ARMS = {'pairout': 6, 'cellout': 7}
NAMESPACE = 'dsn_pairout_cellout'
MAX_RECOVERIES = 3
# The ONLY schedule these jobs may verify or recover with. Literal here,
# independent of the trainer constant.
AUTHORIZED_SCHEDULE = {'epochs': 150, 'patience': 15, 'kl_warmup_fraction': .2,
                       'planned_updates': 177600, 'kl_warmup_updates': 35520}
AUTHORIZED_TRAIN_BATCHES = 1184
    write_json(archive / 'recovery.json', {'reason': reason, 'mode': mode, 'resume_from': source,
                                           'resume_epoch': state['epoch'], 'resume_update': state['update'],
                                           'history_records_kept': len(records), 'at': time.time()})
    return start(arm, config_path, mode, record['recoveries'], reason)


def gpu_busy(index):
    """Compute processes on a physical GPU (nvidia-smi index order)."""
    query = lambda *a: subprocess.run(['nvidia-smi', *a, '--format=csv,noheader'], capture_output=True,
                                      text=True, check=True).stdout.split('\n')
    uuid = dict(line.split(', ') for line in query('--query-gpu=index,uuid') if line)[str(index)]
    return [line for line in query('--query-compute-apps=gpu_uuid,pid,used_memory') if line.startswith(uuid)]


def gpu_free_mib(index):
    out = subprocess.run(['nvidia-smi', '-i', str(index), '--query-gpu=memory.free', '--format=csv,noheader,nounits'],
                         capture_output=True, text=True, check=True).stdout
    return int(out.strip())


def launch_refusals():
    """Initial launch gate: Codex approval newer than code/diff/evidence, passing
    cohort/copy evidence, dsn/model.py+data.py still byte-identical to the
    verified accelerated_four copies (prior GPU3 evidence and approvals), at
    least MIN_FREE_MIB free on the shared GPU6/7, and both arms without any
    record or output state."""
    code = [p for p in CONTROL.rglob('*') if p.is_file() and p.suffix in ('.py', '.sh', '.yaml', '.md')
            and 'outputs' not in p.parts and 'evidence' not in p.parts and '.cache' not in p.parts]
    if not APPROVAL.exists():
        yield f'missing Codex review approval {APPROVAL}'
    else:
        approval = read_json(APPROVAL)
        if approval.get('approved') is not True:
            yield 'review_approval.json: approved is not true'
        if 'codex' not in str(approval.get('reviewer', '')).lower():
            yield 'review_approval.json: reviewer must be Codex'
        newest = max(code + [EVIDENCE, REVIEW_DIFF], key=lambda p: p.stat().st_mtime if p.exists() else 0)
        if newest.exists() and APPROVAL.stat().st_mtime < newest.stat().st_mtime:
            yield f'approval is older than {newest}'
    if not EVIDENCE.exists() or read_json(EVIDENCE).get('passed') is not True:
        yield f'evidence {EVIDENCE} missing or not passed'
    for name in ['model.py', 'data.py']:
        if not filecmp.cmp(CONTROL / 'dsn' / name, ORIGINAL / name, shallow=False):
            yield f'dsn/{name} is not byte-identical to the verified {ORIGINAL / name}'
    if read_json(PRIOR_GPU3_EVIDENCE).get('all_numerical_checks_passed') is not True:
        yield f'prior GPU3 evidence {PRIOR_GPU3_EVIDENCE} not passed'
    for prior in PRIOR_APPROVALS:
        if read_json(prior).get('approved') is not True:
            yield f'prior approval {prior} not approved'
    if not REVIEW_DIFF.exists():
        yield f'missing {REVIEW_DIFF} (run dsn_pairout_cellout/tools/make_review.sh)'
    for arm, gpu in ARMS.items():
        if (STATE / arm / 'record.json').exists():
            yield f'{arm}: existing job record; use --status and bounded --recover'
        existing = [n for n in ['last.pt', 'best.pt', 'history.jsonl', 'test_complete.json']
                    if (OUTPUTS / arm / n).exists()]
        if existing:
            yield f'{arm}: output already has {existing}; --fresh needs an empty output'
        free = gpu_free_mib(gpu)
        if free < MIN_FREE_MIB:
            yield f'{arm}: physical GPU{gpu} has only {free} MiB free (< {MIN_FREE_MIB}): {gpu_busy(gpu)}'

