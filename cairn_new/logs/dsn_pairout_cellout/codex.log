    assert audit['passed'] is True and audit['pairout_cellout_frames_identical'] is True
    protocol = audit['protocols'][config['protocol']]
    assert all(protocol[k] is True for k in ['all_rows_exact', 'all_columns_order_dtypes_exact', 'event_names_exact',
                                             'global_drug_ids_exact', 'pair_index_exact'])
    assert config['nai_cap'] == preparation['nai']['cap']
    return preparation


def workspace_path(value):
    path = Path(value)
    path = (ROOT / path).resolve() if not path.is_absolute() else path.resolve()
    if not path.is_relative_to(ROOT):
        raise ValueError(f'Write/data workspace must remain inside {ROOT}: {path}')
    return path


def save_json(path, value):
    temporary = path.with_name(path.name + '.tmp')
    temporary.write_text(json.dumps(value, indent=2, allow_nan=False) + '\n')
    temporary.replace(path)


def save_checkpoint(path, checkpoint):
    # A killed writer must leave the preceding epoch checkpoint usable.
    temporary = path.with_name(path.name + '.tmp')
    torch.save(checkpoint, temporary)
    temporary.replace(path)


def rng_state():
    return {'python': random.getstate(), 'numpy': np.random.get_state(), 'torch': torch.get_rng_state(),
            'cuda': torch.cuda.get_rng_state_all()}


def restore_rng(state):
    random.setstate(state['python'])
    np.random.set_state(state['numpy'])
    torch.set_rng_state(state['torch'].cpu())
    torch.cuda.set_rng_state_all([value.cpu() for value in state['cuda']])


def top_k_accuracy(y, probabilities, k=5):
    # Report-only metric from the exported probabilities; never used for selection.
    top = np.argsort(-probabilities, axis=1, kind='stable')[:, :k]
    return float((top == y[:, None]).any(1).mean())


@torch.no_grad()
def evaluate(model, loader, device, config, beta):
    model.eval()
    totals = {name: 0. for name in ['ce', 'rec', 'kl', 'loss']}
    probabilities, targets, original_rows = [], [], []
    # Reconstruction uses normal Gaussian samples; evaluation sampling never
    # changes training RNG. Classifier always uses deterministic mu.
    with torch.random.fork_rng(devices=[0]):
        torch.manual_seed(config['seed'] + 10000)
        for raw in loader:
            batch = to_device(raw, device)
            output = model(batch)
            ce = F.cross_entropy(output['logits'], batch['label'])
            loss = ce + config['reconstruction_weight'] * output['rec'] + beta * output['kl']
            count = len(batch['label'])
            for name, value in [('ce', ce), ('rec', output['rec']), ('kl', output['kl']), ('loss', loss)]:
                totals[name] += float(value) * count
            probabilities.append(output['logits'].softmax(-1).cpu().numpy())
            targets.append(raw['label'].numpy())
            original_rows.append(raw['row_index'].numpy())
    n = len(loader.dataset)
    totals = {k: v / n for k, v in totals.items()}
    probs, y = np.concatenate(probabilities), np.concatenate(targets)
    totals['macro_f1_85'] = validation_selection_metric(y, probs)
    totals['kl_beta'] = beta
    return totals, probs, y, np.concatenate(original_rows)


def export_test(model, dataset, loader, device, config, output, best):
    totals, probabilities, y, original_rows = evaluate(model, loader, device, config, config['kl_weight'])
    metrics, per_class, confusion = classification_metrics(y, probabilities)
    metrics.update({'top5_accuracy': top_k_accuracy(y, probabilities), 'loss_terms': totals,
                    'checkpoint': 'best.pt', 'selected_epoch': best['epoch'],
                    'selected_validation_macro_f1_85': best['best_metric'], 'selection': 'validation only',
                    'protocol': config['protocol'], 'ddi_split_note': DDI_SPLIT_NOTE,
                    'parameters': sum(p.numel() for p in model.parameters()),
                    'training_seconds': sum(json.loads(line)['seconds'] for line in
                                            (output / 'history.jsonl').read_text().splitlines())})
    frame = dataset.frame.copy()
    assert np.array_equal(original_rows, dataset.rows)
    frame.insert(0, 'frozen_row_index', original_rows)
    frame['predicted_event_id'] = probabilities.argmax(1)
    frame['predicted_probability'] = probabilities.max(1)
    frame.to_parquet(output / 'test_predictions.parquet', index=False)
    np.savez_compressed(output / 'test_probabilities.npz', probabilities=probabilities,
                        event_ids=np.arange(85), labels=y, frozen_row_indices=original_rows)
    events = pd.read_csv(workspace_path(config['prepared']) / 'ddi_events.csv')
    per_class.merge(events, on='event_id', how='left').to_csv(output / 'test_per_class.csv', index=False)
    pd.DataFrame(confusion, index=np.arange(85), columns=np.arange(85)).rename_axis('true_event_id').to_csv(output / 'test_confusion.csv')
    save_json(output / 'test_metrics.json', metrics)
    print(json.dumps({'phase': 'best_checkpoint_test', **metrics}), flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', required=True)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument('--fresh', action='store_true')
    mode.add_argument('--resume', action='store_true')
    mode.add_argument('--test-only', action='store_true')
    args = parser.parse_args()
    config = yaml.safe_load(workspace_path(args.config).read_text())
    # This is checked before the first CUDA operation. Only the assigned one
    # physical device is visible, including RNG and allocator operations.
    assigned = GPU[config['protocol']]
    if config['gpu'] != assigned or os.environ.get('CUDA_VISIBLE_DEVICES') != str(assigned):
        raise ValueError(f'This arm requires CUDA_VISIBLE_DEVICES={assigned} and config gpu={assigned}')
    torch.set_num_threads(config['cpu_threads'])
    random.seed(config['seed'])
    np.random.seed(config['seed'])
    torch.manual_seed(config['seed'])
    device = torch.device('cuda:0')
    prepared = workspace_path(config['prepared'])
    output_dir = workspace_path(config['output'])
    # Own output only; DSN/accelerated/production checkpoints are never read.
    if not output_dir.is_relative_to(OUTPUTS):
        raise ValueError(f'Output must remain inside {OUTPUTS}')
    output_dir.mkdir(parents=True, exist_ok=True)
    if args.fresh and any((output_dir / n).exists() for n in ['last.pt', 'best.pt', 'history.jsonl']):
        raise ValueError('--fresh requires an empty output; recovery uses --resume or --test-only')
    if not args.fresh:
        own = torch.load(output_dir / ('best.pt' if args.test_only else 'last.pt'), map_location='cpu', weights_only=False)
        if own['config'].get('namespace') != NAMESPACE or Path(own['config']['output']) != output_dir:
            raise ValueError('Checkpoint is not this rareddie_pairout_cellout run')
    saved = own if args.resume else None
    if args.test_only:
        assert own['config']['gpu'] == assigned and own['config']['protocol'] == config['protocol']
        # Evaluation restores the authoritative training configuration.
        config = own['config']
        del own
    if args.fresh:
        # Seeded state immediately before model construction (exact, restorable).
        torch.save(rng_state(), output_dir / 'initial_rng.pt')
    preparation = preparation_gate(prepared, config)
    if config['ddi_split_note'] != DDI_SPLIT_NOTE:
        raise ValueError(f'ddi_split_note must state: {DDI_SPLIT_NOTE}')
    if not args.test_only:
        config.update({'prepared': str(prepared), 'output': str(output_dir), 'generator': GENERATOR,
                       'namespace': NAMESPACE, 'ablation': ABLATION, 'with_path': False,
                       'selection_metric': 'fixed85 validation macroF1', 'test_selection': False,
                       'cohort_source_identity': preparation['source_identity'],
                       'source_provenance': json.loads((ROOT / 'docs/source_provenance.json').read_text())})
    assets = torch.load(prepared / 'assets.pt', map_location='cpu', weights_only=False)
    model = RareDDIEControl(assets).to(device)
    optimizer = torch.optim.AdamW(model.parameters(), lr=config['learning_rate'], weight_decay=config['weight_decay'])
    collate = Collator(assets)
    datasets = {split: DDIDataset(prepared, config['protocol'], split) for split in ['train', 'val']}
    loaders = {split: DataLoader(dataset, batch_size=config['batch_size'], shuffle=split == 'train',
                                 num_workers=config['num_workers'], collate_fn=collate, pin_memory=True,
                                 persistent_workers=False)
               for split, dataset in datasets.items()}
    assert len(loaders['train']) == TRAIN_BATCHES
    if args.fresh:
        config['planned_updates'] = config['epochs'] * len(loaders['train'])
        config['kl_warmup_updates'] = max(1, math.ceil(config['kl_warmup_fraction'] * config['planned_updates']))
    # Every mode (fresh, resume, test-only) runs only the authorized schedule.
    if any(config[k] != v for k, v in SCHEDULE.items()):
        raise ValueError(f'Schedule must be {SCHEDULE}')
    if args.fresh:
        (output_dir / 'config.yaml').write_text(yaml.safe_dump(config, sort_keys=False))
        save_json(output_dir / 'model_inventory.json', parameter_inventory(model))
    if saved is not None and saved['config'] != config:
        raise ValueError('Resume configuration differs from last.pt; preserve batch size and schedule')
    warmup_updates = config['kl_warmup_updates']
    best_metric, bad_epochs, update, start_epoch = -1., 0, 0, 1
    if args.resume:
        model.load_state_dict(saved['model'])
        optimizer.load_state_dict(saved['optimizer'])
        # Construct model/loaders BEFORE restoring RNG. With nonpersistent
        # workers, each epoch consumes the same iterator base seed on resume;
        # there are no random transforms. Shuffling uses this restored RNG.
        restore_rng(saved['rng'])
        best_metric, bad_epochs, update = saved['best_metric'], saved['bad_epochs'], saved['update']
        start_epoch = saved['epoch'] + 1
        del saved
    mode_name = 'fresh' if args.fresh else 'resume' if args.resume else 'test-only'
    will_train = not args.test_only and bad_epochs < config['patience'] and start_epoch <= config['epochs']
    # Liveness/start line only (device query and print; no RNG use).
    print(json.dumps({'phase': 'start', 'mode': mode_name,
                      'start_epoch': start_epoch, 'update': update, 'best_metric': best_metric,
                      'bad_epochs': bad_epochs, 'epochs': config['epochs'], 'patience': config['patience'],
                      'will_train': will_train, 'planned_updates': config['planned_updates'],
                      'kl_warmup_updates': warmup_updates, 'train_batches': len(loaders['train']),
                      'train_rows': len(datasets['train']), 'validation_rows': len(datasets['val']),
                      'batch_size': config['batch_size'], 'seed': config['seed'], 'protocol': config['protocol'],
                      'with_path': config['with_path'], 'output': str(output_dir),
                      'cuda_visible_devices': os.environ.get('CUDA_VISIBLE_DEVICES'),
                      'device_uuid': str(torch.cuda.get_device_properties(device).uuid), 'pid': os.getpid(),
                      'started_at': time.time()}), flush=True)
    start_update = update
    if will_train:
        for epoch in range(start_epoch, config['epochs'] + 1):
            started = time.time()
            model.train()
            totals = {name: 0. for name in ['ce', 'rec', 'kl', 'loss', 'kl_weighted']}
            count = 0
            for raw in loaders['train']:
                batch = to_device(raw, device)
                optimizer.zero_grad(set_to_none=True)
                result = model(batch)
                ce = F.cross_entropy(result['logits'], batch['label'])
                beta = config['kl_weight'] * min(1., (update + 1) / warmup_updates)
                loss = ce + config['reconstruction_weight'] * result['rec'] + beta * result['kl']
                loss.backward()
                # Actual full-training first-update loss terms and gradients.
                if update == 0:
                    grads = {name: p.grad for name, p in model.named_parameters() if p.requires_grad}
                    save_json(output_dir / 'first_update.json', {
                        'labels': len(batch['label']),
                        'loss_terms': {'ce': float(ce), 'rec': float(result['rec']), 'kl': float(result['kl']),
                                       'beta': beta, 'loss': float(loss)},
                        'logits_finite': bool(torch.isfinite(result['logits']).all()),
                        # Actual molecule-only batch: no DSN cross edges, no path graph.
                        'batch_keys': sorted(batch), 'output_keys': sorted(result),
                        'cross_edges_present': 'cross_edges' in batch, 'path_graph_present': 'path_graph' in batch,
                        'gradient_norms': {group: float(torch.stack([g.detach().square().sum() for n, g in grads.items()
                                                                     if g is not None and n.startswith(prefixes)]).sum().sqrt())
                                           for group, prefixes in GROUPS.items()},
                        'all_gradients_finite': all(bool(torch.isfinite(g).all()) for g in grads.values() if g is not None),
                        # Original forward never consumes the last block's norm2 output.
                        'trainable_without_gradient': [n for n, g in grads.items() if g is None]})
                optimizer.step()
                n = len(batch['label'])
                for name, value in [('ce', ce), ('rec', result['rec']), ('kl', result['kl']),
                                    ('loss', loss), ('kl_weighted', beta * result['kl'])]:
                    totals[name] += float(value.detach()) * n
                count += n
                update += 1
                if update == start_update + 1 or update % PROGRESS_EVERY == 0:
                    # From already-synchronized running totals; no RNG use.
                    print(json.dumps({'phase': 'train_progress', 'epoch': epoch, 'update': update,
                                      'epoch_rows': count, 'epoch_seconds': time.time() - started,
                                      'beta': beta, 'running_ce': totals['ce'] / count,
                                      'running_loss': totals['loss'] / count}), flush=True)
            train = {k: v / count for k, v in totals.items()}
            train['kl_beta_final'] = beta
            val, val_probabilities, val_y, _ = evaluate(model, loaders['val'], device, config, beta)
            val['accuracy'] = float((val_probabilities.argmax(1) == val_y).mean())
            del val_probabilities, val_y
            improved = val['macro_f1_85'] > best_metric
            if improved:
                best_metric, bad_epochs = val['macro_f1_85'], 0
            else:
                bad_epochs += 1
            record = {'epoch': epoch, 'update': update, 'train': train, 'validation': val,
                      'best_validation_macro_f1_85': best_metric, 'improved': improved,
                      'bad_epochs': bad_epochs, 'seconds': time.time() - started}
            with (output_dir / 'history.jsonl').open('a') as stream:
                stream.write(json.dumps(record, allow_nan=False) + '\n')
            print(json.dumps(record, allow_nan=False), flush=True)
            checkpoint = {'epoch': epoch, 'update': update, 'model': model.state_dict(),
                          'optimizer': optimizer.state_dict(), 'config': config, 'best_metric': best_metric,
                          'bad_epochs': bad_epochs, 'metrics': record, 'rng': rng_state()}
            if improved:
                save_checkpoint(output_dir / 'best.pt', checkpoint)
            save_checkpoint(output_dir / 'last.pt', checkpoint)
            if bad_epochs >= config['patience']:
                break
    # Test is constructed and read by the training process only after validation
    # selection has finished.
    best = torch.load(output_dir / 'best.pt', map_location=device, weights_only=False)
    model.load_state_dict(best['model'])
    test_data = DDIDataset(prepared, config['protocol'], 'test')
    test_loader = DataLoader(test_data, batch_size=config['batch_size'], shuffle=False,
                             num_workers=config['num_workers'], collate_fn=collate, pin_memory=True)
    export_test(model, test_data, test_loader, device, config, output_dir, best)
    (output_dir / 'test_config.yaml').write_text(yaml.safe_dump(
        {**best['config'], 'evaluation_batch_size': config['batch_size'], 'evaluation_checkpoint': 'best.pt'},
        sort_keys=False))
    save_json(output_dir / 'test_complete.json', {
        'checkpoint': 'best.pt', 'selected_epoch': best['epoch'], 'selected_update': best['update'],
        'rows': len(test_data), 'protocol': config['protocol'], 'ddi_split_note': DDI_SPLIT_NOTE,
        'completed_at': time.time()})


if __name__ == '__main__':
    main()
"""Frozen-row datasets; raw molecules and packed label-free pair subgraphs."""
from pathlib import Path
import numpy as np
import pandas as pd
import torch
from torch.utils.data import Dataset
from torch_geometric.data import Batch


class DDIDataset(Dataset):
    def __init__(self, prepared, protocol, split):
        directory = Path(prepared) / protocol
        frame = pd.read_parquet(directory / 'ddi.parquet')
        rows = np.flatnonzero(frame.split.eq(split).to_numpy())
        self.frame = frame.iloc[rows].copy()
        self.rows = rows
        self.pair_ids = np.load(directory / 'pair_indices.npy')[rows]
        self.a = self.frame.drug_a.to_numpy(np.int64)
        self.b = self.frame.drug_b.to_numpy(np.int64)
        self.y = self.frame.event_id.to_numpy(np.int64)

    def __len__(self):
        return len(self.rows)

    def __getitem__(self, i):
        return int(self.a[i]), int(self.b[i]), int(self.y[i]), int(self.rows[i]), int(self.pair_ids[i])


class Collator:
    def __init__(self, assets, prepared, with_path):
        self.graphs, self.with_path = assets['graphs'], with_path
        if with_path:
            self.paths = {name: np.load(Path(prepared) / f'{name}.npy', mmap_mode='r')
                          for name in ['nodes', 'edges', 'node_ptr', 'edge_ptr', 'endpoints', 'path_mask']}

    def __call__(self, rows):
        a, b, y, original_rows, pairs = zip(*rows)
        ga = [self.graphs[i] for i in a]
        gb = [self.graphs[i] for i in b]
        cross, h_offset, t_offset = [], 0, 0
        for h, t in zip(ga, gb):
            # np.meshgrid(x1,x2) ordering in original DSN preprocessing.
            hi, ti = torch.meshgrid(torch.arange(h.num_nodes), torch.arange(t.num_nodes), indexing='xy')
            edges = torch.stack([hi.flatten(), ti.flatten()])
            # Default GATConv per pair: drop the LOCAL diagonal, then append
            # min(n_h, n_t) LOCAL loops. Offsetting afterwards keeps global
            # row==col edges between different offsets as ordinary edges.
            edges = edges[:, edges[0] != edges[1]]
            loops = torch.arange(min(h.num_nodes, t.num_nodes)).repeat(2, 1)
            edges = torch.cat([edges, loops], 1)
            edges[0] += h_offset
            edges[1] += t_offset
            cross.append(edges)
            h_offset += h.num_nodes
            t_offset += t.num_nodes
        result = {'graph_a': Batch.from_data_list(ga), 'graph_b': Batch.from_data_list(gb),
                  'cross_edges': torch.cat(cross, 1), 'drug_a': torch.tensor(a), 'drug_b': torch.tensor(b),
                  'label': torch.tensor(y), 'row_index': torch.tensor(original_rows)}
        if self.with_path:
            edge_rows, edge_pairs, head_nodes, tail_nodes, masks = [], [], [], [], []
            offset = 0
            for batch_idx, pair_id in enumerate(pairs):
                start, end = self.paths['edge_ptr'][pair_id:pair_id + 2]
                edges = np.array(self.paths['edges'][start:end], dtype=np.int64)
                edges[:, :2] += offset
                edge_rows.append(edges)
                edge_pairs.append(np.full(len(edges), batch_idx, np.int64))
                endpoints = self.paths['endpoints'][pair_id] + offset
                head_nodes.append(int(endpoints[0]))
                tail_nodes.append(int(endpoints[1]))
                masks.append(bool(self.paths['path_mask'][pair_id]))
                ns, ne = self.paths['node_ptr'][pair_id:pair_id + 2]
                offset += int(ne - ns)
            edges = torch.from_numpy(np.concatenate(edge_rows))
            result['path_graph'] = {'edge_index': edges[:, :2].T.contiguous(), 'relations': edges[:, 2],
                                    'multiplicity': edges[:, 3].float(),
                                    'edge_pair': torch.from_numpy(np.concatenate(edge_pairs)),
                                    'head_nodes': torch.tensor(head_nodes), 'tail_nodes': torch.tensor(tail_nodes),
                                    'path_mask': torch.tensor(masks), 'n_nodes': offset}
        return result


def to_device(value, device):
    if isinstance(value, dict):
        return {k: to_device(v, device) for k, v in value.items()}
    if isinstance(value, list):
        return [to_device(v, device) for v in value]
    if hasattr(value, 'to'):
        return value.to(device, non_blocking=True)
    return value
    # Original class, references/DSN-DDI/drugbank_test/layers.py. Same
    # parameters; per-pair self loops arrive explicitly in the packed edges.
    def __init__(self, input_dim):
        super().__init__()
        self.input_dim = input_dim
        self.inter = GATConv((input_dim, input_dim), 32, 2, add_self_loops=False)

    def forward(self, h_data, t_data, b_graph):
        edge_index = b_graph.edge_index
        h_input = F.elu(h_data.x)
        t_input = F.elu(t_data.x)
        t_rep = self.inter((h_input, t_input), edge_index)
        h_rep = self.inter((t_input, h_input), edge_index[[1, 0]])
        return h_rep, t_rep


class CSEBlock(nn.Module):
    def __init__(self):
        super().__init__()
        # RareDDIE MVN_DDI_Block: two 2x64 TransformerConvs, bond64.
        self.feature_conv = TransformerConv(128, 64, 2, edge_dim=64, dropout=0.)
        self.lin_up = Linear(64, 64, bias=True, weight_initializer='glorot')
        self.feature_conv2 = TransformerConv(128, 64, 2, edge_dim=64, dropout=0.)
        self.lin_up2 = Linear(64, 64, bias=True, weight_initializer='glorot')
        self.readout = SAGPooling(128, min_score=-1)
        self.norm = LayerNorm(128)
        self.norm2 = LayerNorm(128)
        self.re_shape_e = Linear(64, 128, bias=True, weight_initializer='glorot')
        # PyG2.0.4 upstream SAGPooling has no extra select scalar.
        self.readout.select.weight.data.fill_(1.)
        self.readout.select.weight.requires_grad_(False)
        self.interAtt = InterGraphAttention(128)
        self.inter_projection = Linear(192, 128, bias=True, weight_initializer='glorot')

    def inter_pair_batch(self, h, t, cross_edges):
        # One call on the packed batch: cross_edges holds only within-pair
        # edges (global offsets) with each pair's own min(n_h, n_t) local loops.
        return self.interAtt(SimpleNamespace(x=h.x), SimpleNamespace(x=t.x),
                             SimpleNamespace(edge_index=cross_edges))

    def forward(self, h, t, cross_edges):
        # Original ne_update order.
        h.x = self.feature_conv(h.x, h.edge_index, h.edge_attr)
        t.x = self.feature_conv(t.x, t.edge_index, t.edge_attr)
        h.x = F.elu(self.norm(h.x, h.batch))
        t.x = F.elu(self.norm(t.x, t.batch))
        h.edge_attr = self.lin_up(h.edge_attr)
        super().__init__()
        self.feature_dim = feature_dim
        self.presence_dim = presence_dim
        self.encoder = nn.Sequential(nn.Linear(feature_dim + presence_dim, 256), nn.GELU())
        self.mu = nn.Linear(256, 128)
        self.logvar = nn.Linear(256, 128)
        self.decoder = nn.Sequential(nn.Linear(128, 256), nn.GELU(), nn.Linear(256, feature_dim))

    def forward(self, pair, path_masks):
        # Equalize each continuous 128-dimensional branch at the PVR boundary;
        # CSE/NAI/path formulas upstream remain unchanged. No learned affine.
        branches = pair.reshape(len(pair), self.feature_dim // 128, 128)
        valid = torch.ones(branches.shape[:2], dtype=torch.bool, device=pair.device)
        if self.presence_dim:
            valid = torch.cat([valid[:, :2], path_masks], dim=1)
        branches = F.layer_norm(branches, (128,)) * valid[:, :, None]
        continuous = branches.flatten(1)
        encoder_input = (torch.cat([continuous, path_masks.to(pair.dtype)], dim=1)
                         if self.presence_dim else continuous)
        encoded = self.encoder(encoder_input)
        mu, logvar = self.mu(encoded), self.logvar(encoded)
        z = mu + torch.exp(.5 * logvar) * torch.randn_like(mu)
        reconstructed = self.decoder(z)
        branch_mse = (reconstructed.reshape_as(branches) - branches.detach()).square().mean(-1)
        # Average over the actual valid branches PER SAMPLE, then over samples.
        # Every pair has equal weight regardless of missing path directions.
        # Flags and absent continuous branches have no reconstruction loss.
        rec = ((branch_mse * valid).sum(1) / valid.sum(1)).mean()
        kl = -.5 * (1 + logvar - mu.square() - logvar.exp()).mean()
        return mu, rec, kl


class DSNRareDDI(nn.Module):
    def __init__(self, assets, config):
        super().__init__()
        self.fin_entities = nn.Embedding.from_pretrained(assets['fin_entities'].clone(), freeze=False)
        self.fin_relations = nn.Embedding.from_pretrained(assets['fin_relations'].clone(), freeze=False)
        self.register_buffer('neighbor_entities', assets['neighbor_entities'])
        self.register_buffer('neighbor_relations', assets['neighbor_relations'])
        self.cse = CSE()
        self.nai = NAI()
        self.with_path = config['with_path']
        if self.with_path:
            self.path = EmerGNNPath(len(assets['fin_relation_ids']), config['path_depth'])
        self.pvr = PairVAE(512, 2) if self.with_path else PairVAE(256)
        self.classifier = nn.Sequential(nn.LayerNorm(128), nn.Linear(128, 256), nn.GELU(),
                                        nn.Dropout(.2), nn.Linear(256, 85))

    def neighbors(self, drugs):
        entity, relation = self.neighbor_entities[drugs], self.neighbor_relations[drugs]
        valid = (entity >= 0) & (relation >= 0)
        mask = valid[:, :, None]
        return self.fin_entities(entity.clamp_min(0)) * mask, self.fin_relations(relation.clamp_min(0)) * mask, valid

    def forward(self, batch):
        head, tail = self.cse(batch)
        # Original uses the SAME right-minus-left guide on BOTH endpoints.
        guide = tail - head
        nai_h = self.nai(*self.neighbors(batch['drug_a']), head, guide)
        nai_t = self.nai(*self.neighbors(batch['drug_b']), tail, guide)
        pair = torch.cat([nai_h, nai_t], -1)
        masks = torch.empty((len(head), 0), dtype=torch.bool, device=head.device)
        if self.with_path:
            # Original source is a projected molecular vector; adapt to the live
            # DSN-conditioned CSE molecular vector, keeping source-only init.
            path, masks = self.path(head, tail, batch['path_graph'])
            pair = torch.cat([pair, path], -1)
        mu, rec, kl = self.pvr(pair, masks)
        return {'logits': self.classifier(mu), 'rec': rec, 'kl': kl, 'path_mask': masks}
"""RareDDIE-only control of the accelerated_four no-path model.

Identical to accelerated_four.dsn.model.DSNRareDDI(with_path=False) except the
CSE: the transplanted DSN InterGraphAttention and its 192->128
inter_projection are removed entirely (no modules, no parameters, no cross
edges). Each block is therefore the original RareDDIE MVN_DDI_Block order
(references/RareDDIE/models_t_struc.py): ne_update, feature_conv2, lin_up2,
GlobalPool, normalize/ELU, norm2/ELU. The 128-d atom states from feature_conv2
enter SAGPooling untouched. The molecular TransformerConv attention is kept.
NAI, PVR and the classifier are the validated accelerated_four modules.
"""
import torch
from torch import nn
import torch.nn.functional as F
from torch_geometric.nn import TransformerConv, SAGPooling, LayerNorm, Linear, global_add_pool
from accelerated_four.dsn.model import NAI, PairVAE


class CSEBlock(nn.Module):
    def __init__(self):
        super().__init__()
        # RareDDIE MVN_DDI_Block: two 2x64 TransformerConvs, bond64. re_shape is
        # never reached by the original forward and is not built.
        self.feature_conv = TransformerConv(128, 64, 2, edge_dim=64, dropout=0.)
        self.lin_up = Linear(64, 64, bias=True, weight_initializer='glorot')
        self.feature_conv2 = TransformerConv(128, 64, 2, edge_dim=64, dropout=0.)
        self.lin_up2 = Linear(64, 64, bias=True, weight_initializer='glorot')
        self.readout = SAGPooling(128, min_score=-1)
        self.norm = LayerNorm(128)
        self.norm2 = LayerNorm(128)
        self.re_shape_e = Linear(64, 128, bias=True, weight_initializer='glorot')
        # PyG2.0.4 upstream SAGPooling has no extra select scalar.
        self.readout.select.weight.data.fill_(1.)
        self.readout.select.weight.requires_grad_(False)

    def forward(self, h, t):
        # Original ne_update order.
        h.x = self.feature_conv(h.x, h.edge_index, h.edge_attr)
        t.x = self.feature_conv(t.x, t.edge_index, t.edge_attr)
        h.x = F.elu(self.norm(h.x, h.batch))
        t.x = F.elu(self.norm(t.x, t.batch))
        h.edge_attr = self.lin_up(h.edge_attr)
        t.edge_attr = self.lin_up(t.edge_attr)
        h.edge_attr = F.elu(h.edge_attr)
        t.edge_attr = F.elu(t.edge_attr)
        # Original second convolution and bond update, then GlobalPool.
        h.x = self.feature_conv2(h.x, h.edge_index, h.edge_attr)
        t.x = self.feature_conv2(t.x, t.edge_index, t.edge_attr)
        h.edge_attr = self.lin_up2(h.edge_attr)
        t.edge_attr = self.lin_up2(t.edge_attr)
        h_atoms, _, _, h_batch, _, _ = self.readout(h.x, h.edge_index, edge_attr=h.edge_attr, batch=h.batch)
        t_atoms, _, _, t_batch, _, _ = self.readout(t.x, t.edge_index, edge_attr=t.edge_attr, batch=t.batch)
        h_pool = global_add_pool(h_atoms, h_batch, size=h.num_graphs)
        t_pool = global_add_pool(t_atoms, t_batch, size=t.num_graphs)
        # Original h_data_edge batch: one row per directed bond, molecule order.
        h_bond = global_add_pool(h.edge_attr, h.batch[h.edge_index[0]], size=h.num_graphs)
        t_bond = global_add_pool(t.edge_attr, t.batch[t.edge_index[0]], size=t.num_graphs)
        h_bond = F.elu(self.re_shape_e(h_bond))
        t_bond = F.elu(self.re_shape_e(t_bond))
        h_pool, t_pool = h_pool * h_bond, t_pool * t_bond
        h_pool = F.elu(F.normalize(h_pool, p=2, dim=1))
        t_pool = F.elu(F.normalize(t_pool, p=2, dim=1))
        h.x = F.elu(self.norm2(h.x, h.batch))
        t.x = F.elu(self.norm2(t.x, t.batch))
        h.edge_attr, t.edge_attr = F.elu(h.edge_attr), F.elu(t.edge_attr)
        return h, t, h_pool, t_pool


class CSE(nn.Module):
    def __init__(self):
        super().__init__()
        self.initial_node_feature = Linear(55, 128, bias=True, weight_initializer='glorot')
        self.initial_edge_feature = Linear(17, 64, bias=True, weight_initializer='glorot')
        self.initial_node_norm = LayerNorm(128)
        self.blocks = nn.ModuleList([CSEBlock(), CSEBlock()])

    def forward(self, batch):
        # clone keeps the immutable molecular cache unmodified.
        h, t = batch['graph_a'].clone(), batch['graph_b'].clone()
        h.x = self.initial_node_feature(h.x)
        t.x = self.initial_node_feature(t.x)
        h.x = self.initial_node_norm(h.x, h.batch)
        t.x = self.initial_node_norm(t.x, t.batch)
        h.x, t.x = F.elu(h.x), F.elu(t.x)
        h.edge_attr = self.initial_edge_feature(h.edge_attr)
        t.edge_attr = self.initial_edge_feature(t.edge_attr)
        h.edge_attr, t.edge_attr = F.elu(h.edge_attr), F.elu(t.edge_attr)
        repr_h, repr_t = [], []
        for block in self.blocks:
            h, t, rh, rt = block(h, t)
            repr_h.append(rh)
            repr_t.append(rt)
        return .6 * repr_h[0] + .4 * repr_h[-1], .6 * repr_t[0] + .4 * repr_t[-1]


class RareDDIEControl(nn.Module):
    def __init__(self, assets):
        super().__init__()
        self.fin_entities = nn.Embedding.from_pretrained(assets['fin_entities'].clone(), freeze=False)
        self.fin_relations = nn.Embedding.from_pretrained(assets['fin_relations'].clone(), freeze=False)
        self.register_buffer('neighbor_entities', assets['neighbor_entities'])
        self.register_buffer('neighbor_relations', assets['neighbor_relations'])
        self.cse = CSE()
        self.nai = NAI()
        self.pvr = PairVAE(256)
        self.classifier = nn.Sequential(nn.LayerNorm(128), nn.Linear(128, 256), nn.GELU(),
                                        nn.Dropout(.2), nn.Linear(256, 85))

    def neighbors(self, drugs):
        entity, relation = self.neighbor_entities[drugs], self.neighbor_relations[drugs]
        valid = (entity >= 0) & (relation >= 0)
        mask = valid[:, :, None]
        return self.fin_entities(entity.clamp_min(0)) * mask, self.fin_relations(relation.clamp_min(0)) * mask, valid

    def forward(self, batch):
        head, tail = self.cse(batch)
        # Original uses the SAME right-minus-left guide on BOTH endpoints.
        guide = tail - head
        nai_h = self.nai(*self.neighbors(batch['drug_a']), head, guide)
        nai_t = self.nai(*self.neighbors(batch['drug_b']), tail, guide)
        pair = torch.cat([nai_h, nai_t], -1)
        mu, rec, kl = self.pvr(pair, pair.new_empty((len(pair), 0), dtype=torch.bool))
        # Deterministic mu_ab classifier, as in the no-path comparator.
        return {'logits': self.classifier(mu), 'rec': rec, 'kl': kl}


GROUPS = {'fin_entities': ('fin_entities.',), 'fin_relations': ('fin_relations.',), 'cse': ('cse.',),
          'nai': ('nai.',), 'pvr': ('pvr.',), 'classifier': ('classifier.',)}
FORBIDDEN = ('inter', 'path', 'gat', 'cross')


def parameter_inventory(model):
    """Every named parameter with its group; proves no DSN/path parameters exist."""
    rows = [{'name': name, 'shape': list(p.shape), 'numel': p.numel(), 'requires_grad': p.requires_grad,
             'group': next(g for g, prefixes in GROUPS.items() if name.startswith(prefixes))}
            for name, p in model.named_parameters()]
    lowered = [r['name'].lower() for r in rows]
    convs = {name: type(m).__name__ for name, m in model.cse.named_modules() if isinstance(m, TransformerConv)}
    return {
        'parameters': sum(r['numel'] for r in rows),
        'trainable_parameters': sum(r['numel'] for r in rows if r['requires_grad']),
        'groups': {g: sum(r['numel'] for r in rows if r['group'] == g) for g in GROUPS},
        'frozen': [r['name'] for r in rows if not r['requires_grad']],
        'forbidden_name_matches': [n for n in lowered if any(word in n for word in FORBIDDEN)],
        'dsn_inter_attention_present': any('interatt' in n for n in lowered),
        'inter_projection_present': any('inter_projection' in n for n in lowered),
        'path_modules_present': any(n.startswith('path.') for n in lowered),
        'molecular_transformer_convs': convs,
        'fin_trainable': model.fin_entities.weight.requires_grad and model.fin_relations.weight.requires_grad,
        'pair_input': model.pvr.feature_dim, 'latent': model.pvr.mu.out_features,
        'classifier': [str(m) for m in model.classifier],
        'tensors': rows}

