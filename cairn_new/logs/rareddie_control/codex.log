        guide = tail - head
        nai_h = self.nai(*self.neighbors(batch['drug_a']), head, guide)
        nai_t = self.nai(*self.neighbors(batch['drug_b']), tail, guide)
        pair = torch.cat([nai_h, nai_t], -1)
        masks = torch.empty((len(head), 0), dtype=torch.bool, device=head.device)
        if self.with_path:
