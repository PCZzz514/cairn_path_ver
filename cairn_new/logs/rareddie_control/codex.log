import torch
from torch import nn
import torch.nn.functional as F
from torch.nn.modules.container import ModuleList
from torch_geometric.nn import (
                                TransformerConv,
                                SAGPooling,
                                LayerNorm,
                                global_add_pool,
                                Linear,
                                )
from layers import (
                    RESCAL,
                    MergeFD,
                    CoAttentionLayer,
                    )
import time
import copy


class MVN_DDI(nn.Module):
    def __init__(self, in_node_features, in_edge_features, hidd_dim, kge_dim, rel_total, heads_out_feat_params, blocks_params, edge_feature,dp):
        super().__init__()
        self.in_node_features = in_node_features[0]
        self.in_node_features_fp = in_node_features[1]
        self.in_node_features_desc = in_node_features[2]
        self.in_edge_features = in_edge_features
        self.hidd_dim = hidd_dim
        self.kge_dim = kge_dim
        self.rel_total = rel_total
        self.n_blocks = len(blocks_params)
        
        self.initial_node_feature = Linear(self.in_node_features, self.hidd_dim ,bias=True, weight_initializer='glorot')
        self.initial_edge_feature = Linear(self.in_edge_features, edge_feature ,bias=True, weight_initializer='glorot')
        self.initial_node_norm = LayerNorm(self.hidd_dim)

        self.blocks = []
        for i, (head_out_feats, n_heads) in enumerate(zip(heads_out_feat_params, blocks_params)):
            block = MVN_DDI_Block(self.hidd_dim, n_heads, head_out_feats, edge_feature, dp)
            self.add_module(f"block{i}", block)
            self.blocks.append(block)
        self.fdmer = MergeFD(self.in_node_features_fp, self.in_node_features_desc, self.kge_dim)


    def forward(self, triples):
        triples_c = copy.deepcopy(triples)
        h_data, h_data_fin, h_data_desc, t_data, t_data_fin, t_data_desc, rels, h_data_edge, t_data_edge = triples_c

        h_data.x = self.initial_node_feature(h_data.x)
        t_data.x = self.initial_node_feature(t_data.x)
        h_data.x = self.initial_node_norm(h_data.x, h_data.batch)
        t_data.x = self.initial_node_norm(t_data.x, t_data.batch)
        h_data.x = F.elu(h_data.x)
        t_data.x = F.elu(t_data.x)

        h_data.edge_attr = self.initial_edge_feature(h_data.edge_attr)
        t_data.edge_attr = self.initial_edge_feature(t_data.edge_attr)
        h_data.edge_attr = F.elu(h_data.edge_attr)
        t_data.edge_attr = F.elu(t_data.edge_attr)

        repr_h = []
        repr_t = []
        for i, block in enumerate(self.blocks):
            out = block(h_data,t_data,h_data_edge, t_data_edge)
            h_data = out[0]
            t_data = out[1]
            h_global_graph_emb = out[2]
            t_global_graph_emb = out[3]
            repr_h.append(h_global_graph_emb)
            repr_t.append(t_global_graph_emb)
        _, _, h_data_fin, h_data_desc, t_data_fin, t_data_desc = self.fdmer(h_data_fin,h_data_desc,t_data_fin,t_data_desc)

        h_data_fin=0.6*repr_h[0]+0.4*repr_h[-1]
        t_data_fin=0.6*repr_t[0]+0.4*repr_t[-1]
        return h_data_fin,t_data_fin



class MVN_DDI_Block(nn.Module):
    def __init__(self, in_features, n_heads, head_out_feats, edge_feature, dp):
        super().__init__()
        self.n_heads = n_heads
        self.in_features = in_features
        self.out_features = head_out_feats
        self.feature_conv = TransformerConv(in_features, head_out_feats, n_heads, edge_dim=edge_feature,dropout=dp)
        self.lin_up = Linear(64, 64, bias=True, weight_initializer='glorot')
        
        self.feature_conv2 = TransformerConv(in_features, head_out_feats, n_heads, edge_dim=edge_feature,dropout=dp)
        self.lin_up2 = Linear(64, 64, bias=True, weight_initializer='glorot')
        
        self.readout = SAGPooling(n_heads * head_out_feats, min_score=-1)
        self.re_shape = Linear(64 + 128, 128, bias=True, weight_initializer='glorot')
        self.norm = LayerNorm(n_heads * head_out_feats)
        self.norm2 = LayerNorm(n_heads * head_out_feats)
        
        self.re_shape_e = Linear(64, 128, bias=True, weight_initializer='glorot')
    
    def forward(self, h_data,t_data,h_data_edge, t_data_edge):
        h_data, t_data = self.ne_update(h_data, t_data)
        h_data.x = self.feature_conv2(h_data.x, h_data.edge_index, h_data.edge_attr)
        t_data.x = self.feature_conv2(t_data.x, t_data.edge_index, t_data.edge_attr)
        h_data.edge_attr = self.lin_up2(h_data.edge_attr)
        t_data.edge_attr = self.lin_up2(t_data.edge_attr)

        h_global_graph_emb, t_global_graph_emb = self.GlobalPool(h_data, t_data, h_data_edge, t_data_edge)
        h_global_graph_emb = nn.ELU()(F.normalize(h_global_graph_emb, 2, 1))
        t_global_graph_emb = nn.ELU()(F.normalize(t_global_graph_emb, 2, 1))

        h_data.x = F.elu(self.norm2(h_data.x, h_data.batch))
        t_data.x = F.elu(self.norm2(t_data.x, t_data.batch))
        h_data.edge_attr = F.elu(h_data.edge_attr)
        t_data.edge_attr = F.elu(t_data.edge_attr)

        return h_data, t_data, h_global_graph_emb, t_global_graph_emb

    def ne_update(self, h_data, t_data):
        h_data.x = self.feature_conv(h_data.x, h_data.edge_index, h_data.edge_attr)
        t_data.x = self.feature_conv(t_data.x, t_data.edge_index, t_data.edge_attr)
        h_data.x = F.elu(self.norm(h_data.x, h_data.batch))
        t_data.x = F.elu(self.norm(t_data.x, t_data.batch))

        h_data.edge_attr = self.lin_up(h_data.edge_attr)
        t_data.edge_attr = self.lin_up(t_data.edge_attr)
        h_data.edge_attr = F.elu(h_data.edge_attr)
        t_data.edge_attr = F.elu(t_data.edge_attr)

        return h_data, t_data

    def GlobalPool(self, h_data, t_data,h_data_edge, t_data_edge):
        h_att_x, att_edge_index, att_edge_attr, h_att_batch, att_perm, h_att_scores= self.readout(h_data.x, h_data.edge_index, edge_attr=h_data.edge_attr, batch=h_data.batch)
        t_att_x, att_edge_index, att_edge_attr, t_att_batch, att_perm, t_att_scores= self.readout(t_data.x, t_data.edge_index, edge_attr=t_data.edge_attr, batch=t_data.batch)
        h_global_graph_emb = global_add_pool(h_att_x, h_att_batch)
        t_global_graph_emb = global_add_pool(t_att_x, t_att_batch)

        h_data_edge.x = h_data.edge_attr
        t_data_edge.x = t_data.edge_attr
        h_global_graph_emb_edge = global_add_pool(h_data_edge.x, batch=h_data_edge.batch)
        t_global_graph_emb_edge = global_add_pool(t_data_edge.x, batch=t_data_edge.batch)
        h_global_graph_emb_edge = F.elu(self.re_shape_e(h_global_graph_emb_edge))
        t_global_graph_emb_edge = F.elu(self.re_shape_e(t_global_graph_emb_edge))

        h_global_graph_emb = h_global_graph_emb * h_global_graph_emb_edge
        t_global_graph_emb = t_global_graph_emb * t_global_graph_emb_edge
        return h_global_graph_emb, t_global_graph_emb

"""RareDDIE_official85: the official active RareDDIE CSE -> FIN/NAI -> VAE(PVR) query path, direct fixed85 head.

Authored by Claude Opus5.5 (claude-opus-5-5), 2026-10-11, docs/RareDDIE_official85_plan.md.
Source: references/RareDDIE_source/RareDDIE-f658cae053af1e93eecc88ad77dc3af2e33cf527/RareDDIE,
matcher_structure_acc_fp_neigh_VAE_struc.py (EmbedMatcher) and models_t_struc.py (MVN_DDI), imported read-only
by .source.load_official. Reused unchanged: the MVN_DDI class and its blocks (ne_update, GlobalPool), the VAE class
and its methods, CustomDropout, and the function EmbedMatcher.neighbor_encoder (bound here as a method).
EmbedMatcher itself is not instantiated: its constructor builds unused modules and a hard-coded CUDA pad tensor.

Constructed in the official __init__ order, for the modules on the active forward path only: symbol_emb (FIN
relations, then entities, then a zero PAD row; fine-tuned), gcn_w (xavier_normal_), Dropout(0.5), MVN_DDI with
the official arguments, fc, Bilinear, Linear_self, Linear_nei, Linear_weak_rel, VAE(256).
Adaptations (each one is documented in the plan):
- fc ends in Linear(64, 85) raw logits applied to the query z, instead of Linear(64, 1) on |mean support z - z|.
  There is no support set, so the support VAE pass and its reconstruction term are gone.
- MVN_DDI.forward is replaced by `structure`. It is the same statements without the MergeFD line, whose outputs
  the official forward overwrites; fdmer is deleted after construction (it is built last, so no other initial
  value changes). There are no fingerprint or descriptor inputs.
- PyG 2.7 SAGPooling scales the GraphConv score by a learnable SelectTopK.weight before the softmax. The official
  PyG 2.0.4 has no such scalar, so it is set to 1 and frozen.
- The tensors that the official forward never reaches (block*.re_shape, block1.norm2) are frozen. In the official
  Adam they have grad None and never change.
"""
from __future__ import annotations

import copy

import torch
from torch import nn
import torch.nn.functional as F
import torch.nn.init as init

from .source import load_official

OFFICIAL = load_official()
# EmbedMatcher.__init__ constants: MVN_DDI([n_atom_feats, 2048, 200], 17, kge_dim, kge_dim, rel_total,
# [64, 64], [2, 2], 64, 0.0), fc dropout 0.5, neighbour Dropout(0.5).
N_ATOM_FEATS, N_EDGE_FEATS, KGE_DIM = 55, 17, 128
MVN_ARGS = ([N_ATOM_FEATS, 2048, 200], N_EDGE_FEATS, KGE_DIM, KGE_DIM, 0, [64, 64], [2, 2], 64, 0.0)
HEAD_DROPOUT = 0.5
# Tensors that the official active forward never reaches.
INACTIVE = ("model.block0.re_shape.", "model.block1.re_shape.", "model.block1.norm2.")
SAG_SELECT = ("model.block0.readout.select.weight", "model.block1.readout.select.weight")
GROUPS = {"fin_symbol_emb": ("symbol_emb.",), "cse": ("model.",),
          "nai": ("gcn_w.", "Bilinear.", "Linear_self.", "Linear_nei.", "Linear_weak_rel."),
          "pvr_vae": ("vaemodel.",), "fixed85_head": ("fc.",)}


def official_connections(bundle):
    """Official build_connection layout: connections[drug, slot] = (relation symbol, entity symbol), PAD-filled.

    Unified symbol ids, as in Trainer.load_embed: relations first, then entities, then PAD = num_symbols.
    Relation r -> r, FIN entity e -> R + e. The id is the FIN row, so the mapping can be inverted.
    """
    relations = len(bundle["fin_relations"])
    entities = len(bundle["fin_entities"])
    pad = relations + entities
    entity, relation = bundle["target_fin_idx"], bundle["target_relation_idx"]
    valid = entity >= 0
    connections = torch.stack([torch.where(valid, relation, pad), torch.where(valid, entity + relations, pad)], -1)
    degrees = valid.sum(dim=1).float()
    return connections, degrees, {"relations": relations, "entities": entities, "num_symbols": pad, "pad_idx": pad}


def symbol_embeddings(bundle):
    """Trainer.load_embed table: FIN relation rows, FIN entity rows, then one zero PAD row."""
    relations = bundle["fin_relations"]
    return torch.cat([relations, bundle["fin_entities"], relations.new_zeros(1, relations.shape[1])])


class RareDDIEOfficial85(nn.Module):
    def __init__(self, bundle: dict, config: dict):
        super().__init__()
        embed_dim = int(config["official"]["embed_dim"])
        connections, degrees, symbols = official_connections(bundle)
        if connections.shape[1] != int(config["official"]["max_neighbor"]):
            raise ValueError(f"neighbour width {connections.shape[1]} != max_neighbor {config['official']['max_neighbor']}")
        num_symbols = symbols["num_symbols"]
        embed = symbol_embeddings(bundle)
        self.embed_dim = embed_dim
        self.pad_idx = num_symbols
        self.num_symbols = num_symbols
        self.symbol_emb = nn.Embedding(num_symbols + 1, embed_dim, padding_idx=num_symbols)
        self.gcn_w = nn.Linear(2 * embed_dim, embed_dim)
        self.dropout = nn.Dropout(0.5)
        init.xavier_normal_(self.gcn_w.weight)
        self.symbol_emb.weight.data.copy_(embed)  # use_pretrain
        if not config["official"]["fine_tune"]:
            self.symbol_emb.weight.requires_grad = False
        self.model = OFFICIAL.MVN_DDI(*MVN_ARGS)
        del self.model.fdmer
        self.fc = nn.Sequential(
            nn.Linear(64, 128),
            nn.ReLU(),
            OFFICIAL.CustomDropout(HEAD_DROPOUT),
            nn.Linear(128, 64),
            nn.ReLU(),
            nn.Linear(64, int(bundle["num_ddi_classes"])),
        )
        self.Bilinear = nn.Bilinear(embed_dim, embed_dim, 1, bias=False)
        self.Linear_self = nn.Linear(embed_dim, embed_dim, bias=False)
        self.Linear_nei = nn.Linear(embed_dim, embed_dim, bias=False)
        self.Linear_weak_rel = nn.Linear(embed_dim, embed_dim, bias=False)
        self.vaemodel = OFFICIAL.VAE(emb_dim=embed_dim * 2)
        self.register_buffer("connections", connections)
        self.register_buffer("degrees", degrees)
        for block in self.model.blocks:
            block.readout.select.weight.data.fill_(1.0)  # PyG 2.0.4 SAGPooling: softmax(GraphConv score)
            block.readout.select.weight.requires_grad_(False)
        for name, parameter in self.named_parameters():
            if name.startswith(INACTIVE):
                parameter.requires_grad_(False)

    neighbor_encoder = OFFICIAL.EmbedMatcher.neighbor_encoder

    def structure(self, batch):
        """MVN_DDI.forward without its discarded MergeFD line; the blocks are the official modules."""
        mvn = self.model
        h_data, t_data, h_data_edge, t_data_edge = copy.deepcopy(
            (batch["graph_a"], batch["graph_b"], batch["edges_a"], batch["edges_b"]))

        h_data.x = mvn.initial_node_feature(h_data.x)
        t_data.x = mvn.initial_node_feature(t_data.x)
        h_data.x = mvn.initial_node_norm(h_data.x, h_data.batch)
        t_data.x = mvn.initial_node_norm(t_data.x, t_data.batch)
        h_data.x = F.elu(h_data.x)
        t_data.x = F.elu(t_data.x)

        h_data.edge_attr = mvn.initial_edge_feature(h_data.edge_attr)
        t_data.edge_attr = mvn.initial_edge_feature(t_data.edge_attr)
        h_data.edge_attr = F.elu(h_data.edge_attr)
        t_data.edge_attr = F.elu(t_data.edge_attr)

        repr_h = []
        repr_t = []
        for i, block in enumerate(mvn.blocks):
            out = block(h_data, t_data, h_data_edge, t_data_edge)
            h_data = out[0]
            t_data = out[1]
            h_global_graph_emb = out[2]
            t_global_graph_emb = out[3]
            repr_h.append(h_global_graph_emb)
            repr_t.append(t_global_graph_emb)

        h_data_fin = 0.6 * repr_h[0] + 0.4 * repr_h[-1]
        t_data_fin = 0.6 * repr_t[0] + 0.4 * repr_t[-1]
        return h_data_fin, t_data_fin

    def forward(self, batch):
        """EmbedMatcher.forward query path; the head classifies the query z."""
        query_left_, query_right_ = self.structure(batch)
        drug_a, drug_b = batch["drug_a"], batch["drug_b"]
        query_left = self.neighbor_encoder(self.connections[drug_a], self.degrees[drug_a],
                                           query_left_, query_right_ - query_left_)
        query_right = self.neighbor_encoder(self.connections[drug_b], self.degrees[drug_b],
                                            query_right_, query_right_ - query_left_)
        query = torch.cat((query_left, query_right), dim=-1)
        # Query sampling is z = mu + 1e-3 * exp(0.5 logvar) both in training and evaluation.
        output_q, z_mean_q, z_logvar_q, zq = self.vaemodel(query, is_support=False, is_eval=not self.training)
        reconstruction = F.mse_loss(input=output_q, target=query, reduction="mean")
        return {"logits": self.fc(zq), "reconstruction_mse": reconstruction, "z": zq,
                "z_mean": z_mean_q, "z_logvar": z_logvar_q, "pair": query,
                "structure_a": query_left_, "structure_b": query_right_, "nai_a": query_left, "nai_b": query_right}


def dimensions(model):
    blocks = model.model.blocks
    return {"graph_node_input": model.model.initial_node_feature.in_channels, "graph_edge_input":
            model.model.initial_edge_feature.in_channels, "cse_hidden": model.model.hidd_dim,
            "cse_blocks": [[b.n_heads, b.out_features] for b in blocks], "cse_output": KGE_DIM,
            "symbol_emb": list(model.symbol_emb.weight.shape), "pad_idx": model.pad_idx,
            "nai_gcn_w": [model.gcn_w.in_features, model.gcn_w.out_features], "nai_output": model.Linear_nei.out_features,
            "pair": 2 * model.embed_dim, "vae": [model.vaemodel.conv_1.in_features, model.vaemodel.fc_1.out_features],
            "head": [model.fc[0].in_features, model.fc[-1].out_features],
            "connections": list(model.connections.shape)}

