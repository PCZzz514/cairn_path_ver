class VAE(nn.Module):
    '''
    Input data:
        Shape = (batch, 120, 35)
    '''

    def __init__(self,emb_dim):
        super(VAE, self).__init__()

        self.conv_1 = nn.Linear(in_features=emb_dim, out_features=int(emb_dim/2))
        self.conv_2 = nn.Linear(in_features=int(emb_dim/2), out_features=int(emb_dim/4))
        self.conv_3 = nn.Linear(in_features=int(emb_dim/4), out_features=int(emb_dim/8))
        self.fc_0 = nn.Linear(in_features=int(emb_dim/8), out_features=int(emb_dim/2))
        self.fc_1 = nn.Linear(in_features=int(emb_dim/2), out_features=int(emb_dim/4))
        self.fc_2 = nn.Linear(in_features=int(emb_dim/2), out_features=int(emb_dim/4))
        self.fc_3 = nn.Linear(in_features=int(emb_dim/4), out_features=int(emb_dim/4))
        self.fc_4 = nn.Linear(in_features=int(emb_dim/4), out_features=emb_dim)

        self.relu = nn.ReLU()
        self.softmax = nn.Softmax()

    def encode(self, x):
        '''
        :param x:
        :return:
        Example
        import numpy
        import torch.nn as nn
        import torch.nn.functional as F
        import torch

        batch_size = 64
        x = torch.rand(batch_size, 120, 35)

        # Convolutional layer
        x = F.relu(nn.Conv1d(120, 9, kernel_size=9)(x))      # x.shape=torch.Size([64, 9, 27])
        x = F.relu(nn.Conv1d(9, 9, kernel_size=9)(x))        # x.shape=torch.Size([64, 9, 19])
        x = F.relu(nn.Conv1d(9, 10, kernel_size=11)(x))      # x.shape=torch.Size([64, 10, 9])

        # fatten 2 last dimensions but keep the batch_size
        x = x.view(x.size(0), -1)                            # x.shape=torch.Size([64, 90])

        # Fully connected layer
        x = F.selu(nn.Linear(90, 435)(x))                    # x.shape=torch.Size([64, 435])

        # Get z_mean and z_logvar (log-variance)
        z_mean = nn.Linear(435, 292)(x)                      # x.shape=torch.Size([64, 292])
        z_logvar = nn.Linear(435, 292)(x)                    # x.shape=torch.Size([64, 292])
        '''
        x = self.relu(self.conv_1(x))
        x = self.relu(self.conv_2(x))
        x = self.relu(self.conv_3(x))

        x = F.selu(self.fc_0(x))
        return self.fc_1(x), self.fc_2(x)

    def sampling(self, z_mean, z_logvar,is_support,is_eval):
        '''
        It is a parameterization trick to sample to get latent variable Z
        :param z_mean: an output tensor of a standard fully connected layer from encoder (rf. encode() function)
        :param z_logvar: an output tensor of a standard fully connected layer from encoder (rf. encode() function)
        :return: z (latent variable)
            z = z_mean + std * epsilon

        Note. torch.randn_like(input): Returns a tensor with the same size as input that
              is filled with random numbers from a normal distribution with mean 0 and
              variance 1. Therefore, input here is just to get shape.

        Example: continue with example in encode() method. Note: 64 is batch_size
        std = torch.exp(0.5 * z_logvar)               # std.shape=torch.Size([64, 292])
        epsilon = 1e-2 * torch.randn_like(input=std)  # epsilon.shape=torch.Size([64, 292])
        z = z_mean + std * epsilon                    # z.shape=torch.Size([64, 292])
        '''
        std = torch.exp(0.5 * z_logvar)
        # is_eval = False
        if is_eval:
            epsilon = 1e-3 * torch.ones_like(input=std)
        else:
            if is_support:
                epsilon = 1e-2 * torch.randn_like(input=std)
            else:
                epsilon = 1e-3 * torch.ones_like(input=std)
        return z_mean + std * epsilon

    def decode(self, z):
        '''
        :param z:
        :return:

        Example: continue with example in sampling() method
        z = F.selu(nn.Linear(292, 292)(z))                      # z.shape=torch.Size([64, 292])
        z = z.view(z.size(0), 1, z.size(-1)).repeat(1, 120, 1)  # z.shape=torch.Size([64, 120, 292])
        output, h_n = nn.GRU(292, 501,
                             num_layers=3,
                             batch_first=True)(z)               # output.shape=torch.Size([64, 120, 501])
                                                                # h_n.shape=torch.Size([3, 64, 501])
        out_reshape = output.contiguous()
                            .view(-1, output.size(-1))          # out_reshape=torch.Size([7680, 501]) # 7680=64*120

        y_out = nn.Linear(501, 35)(out_reshape)                 # y_out.shape=torch.Size([7680, 35])
        y_out = F.softmax(y_out, dim=1)                         # y_out.shape=torch.Size([7680, 35])
                                                                # dim=1 -> sum to 1 to every row
        y = y_out.contiguous()
                 .view(output.size(0), -1, y_out.size(-1))      # y.shape=torch.Size([64, 120, 35])
        '''
        z = F.selu(self.fc_3(z))
        y_out = self.fc_4(z)
        y = y_out
        return y

    def forward(self, x,is_support=True,is_eval=False):
        z_mean, z_logvar = self.encode(x)
        z = self.sampling(z_mean, z_logvar,is_support,is_eval)
        y = self.decode(z)
        return y, z_mean, z_logvar,z


class EmbedMatcher(nn.Module):
    """
    Matching metric based on KB Embeddings
    """
    def __init__(self, embed_dim, num_symbols, use_pretrain=True, embed=None, dropout=0.2, batch_size=64, finetune=False, aggregate='max'):
        super(EmbedMatcher, self).__init__()
        super(EmbedMatcher, self).__init__()
        self.embed_dim = embed_dim
        self.pad_idx = num_symbols
        self.symbol_emb = nn.Embedding(num_symbols + 1, embed_dim, padding_idx=num_symbols)
        self.aggregate = aggregate
        self.num_symbols = num_symbols

        self.gcn_w = nn.Linear(2*self.embed_dim, self.embed_dim)
        self.gcn_b = nn.Parameter(torch.FloatTensor(self.embed_dim))

        self.dropout = nn.Dropout(0.5)

        init.xavier_normal_(self.gcn_w.weight)
        init.constant_(self.gcn_b, 0)

        if use_pretrain:
            logging.info('LOADING KB EMBEDDINGS')
            self.symbol_emb.weight.data.copy_(torch.from_numpy(embed))
            if not finetune:
                logging.info('FIX KB EMBEDDING')
                self.symbol_emb.weight.requires_grad = False

        d_model = self.embed_dim * 2


        in_feats = 70
        hid_feats = 64
        dropout = 0.5
        n_iter = 3
        edge_feats = 6
        self.mlp = nn.Sequential(
            nn.Linear(in_feats, hid_feats),
            nn.BatchNorm1d(hid_feats),
            CustomDropout(dropout),
            nn.PReLU(),
            nn.Linear(hid_feats, hid_feats),
            nn.BatchNorm1d(hid_feats),
            CustomDropout(dropout),
            nn.PReLU(),
            nn.Linear(hid_feats, hid_feats),
            nn.BatchNorm1d(hid_feats),
            CustomDropout(dropout),
            nn.PReLU(),
        )
        self.h_gpool = GlobalAttentionPool(2*hid_feats)
        self.t_gpool = GlobalAttentionPool(2*hid_feats)
        self.w_j = nn.Linear(2*hid_feats, 2*hid_feats)
        self.w_i = nn.Linear(2*hid_feats, 2*hid_feats)
        self.prj_j = nn.Linear(2*hid_feats, 2*hid_feats)
        self.prj_i = nn.Linear(2*hid_feats, 2*hid_feats)
        self.lin = nn.Sequential(
            nn.Linear(hid_feats * 2, hid_feats * 2),
            nn.PReLU(),
            nn.Linear(hid_feats * 2, d_model),
        )
        self.propagation_layer = GmpnnBlock(edge_feats, hid_feats, n_iter, dropout)
        self.i_pro = nn.Parameter(torch.zeros(hid_feats * 2, hid_feats))
        self.j_pro = nn.Parameter(torch.zeros(hid_feats * 2, hid_feats))
        glorot(self.i_pro)
        glorot(self.j_pro)

        n_atom_feats = 55
        kge_dim = 128
        rel_total = 0
        self.model = MVN_DDI([n_atom_feats, 2048, 200], 17, kge_dim, kge_dim, rel_total, [64, 64],
                                 [2, 2], 64, 0.0)

        self.fc = nn.Sequential(
            nn.Linear(64, 128),  #
            nn.ReLU(),
            CustomDropout(dropout),
            nn.Linear(128, 64),
            nn.ReLU(),
            nn.Linear(64, 1)
        )#


        self.NeighborAggregator = AttentionSelectContext(dim=kge_dim, dropout=0.0)
        self.pad_idx = num_symbols
        self.pad_tensor = torch.tensor([self.pad_idx], requires_grad=False).to('cuda')
        self.fc_struc_net = nn.Sequential(
            nn.Linear(256, 128),
            nn.ReLU(),
            CustomDropout(dropout),
            nn.LayerNorm(128),
            nn.Linear(128, 128)
        )#

        self.Bilinear = nn.Bilinear(embed_dim, embed_dim, 1, bias=False)
        self.Linear_self = nn.Linear(embed_dim, embed_dim, bias=False)
        self.Linear_nei = nn.Linear(embed_dim, embed_dim, bias=False)
        self.Linear_weak_rel = nn.Linear(embed_dim, embed_dim, bias=False)

        self.num_transformer_layers=2
        self.num_transformer_heads=1
        self.dropout_layers=0.2
        self.RelationRepresentation = RelationRepresentation(emb_dim=embed_dim*2,
                                                             num_transformer_layers=self.num_transformer_layers,
                                                             num_transformer_heads=self.num_transformer_heads,
                                                             dropout_rate=self.dropout_layers)
        self.RelationRepresentation2 = RelationRepresentation(emb_dim=embed_dim*2,
                                                             num_transformer_layers=self.num_transformer_layers,
                                                             num_transformer_heads=self.num_transformer_heads,
                                                             dropout_rate=self.dropout_layers)

        self.vaemodel = VAE(emb_dim=embed_dim*2)



    def neighbor_encoder(self, connections, num_neighbors, self_feature,weak_rel):
        '''
        connections: (batch, 200, 2)
        num_neighbors: (batch,)
        '''
        num_neighbors = num_neighbors.unsqueeze(1)
        relations = connections[:,:,0].squeeze(-1)
        entities = connections[:,:,1].squeeze(-1)
        rel_embeds = self.dropout(self.symbol_emb(relations)) # (batch, 200, embed_dim)
        ent_embeds = self.dropout(self.symbol_emb(entities)) # (batch, 200, embed_dim)

        concat_embeds = torch.cat((rel_embeds, ent_embeds), dim=-1) # (batch, 200, 2*embed_dim)

        out = self.gcn_w(concat_embeds)

        weak_rel = self.Linear_weak_rel(weak_rel.unsqueeze(1).repeat(1, out.size(1), 1))
        score = self.Bilinear(weak_rel, out).squeeze(2)
        att = torch.softmax(score, dim=1).unsqueeze(dim=1)
        out = torch.bmm(att, out).squeeze(1)


        out = out * num_neighbors.bool().int()
        out = self.Linear_nei(out) + self.Linear_self(self_feature)

        return F.elu(out)

    def vae_loss(self,x_reconstructed, x, z_mean, z_logvar):
        mse_loss = F.mse_loss(input=x_reconstructed, target=x, reduction='mean')
        kl_loss = -0.5 * torch.sum(1 + z_logvar - z_mean.pow(2) - z_logvar.exp())
        return mse_loss + kl_loss

    def forward(self, query, support, query_meta=None, support_meta=None, query_batch=None, support_batch=None,optim_VAE=None,is_eval=False):
        '''
        query: (batch_size, 2)
        support: (few, 2)
        return: (batch_size, )
        '''

        query_left_connections, query_left_degrees, query_right_connections, query_right_degrees = query_meta
        support_left_connections, support_left_degrees, support_right_connections, support_right_degrees = support_meta
        query_left_,query_right_ = self.model(query_batch)
        support_left_,support_right_ = self.model(support_batch)
        query_left = self.neighbor_encoder(query_left_connections, query_left_degrees,query_left_,query_right_-query_left_)
        query_right = self.neighbor_encoder(query_right_connections, query_right_degrees,query_right_,query_right_-query_left_)
        support_left = self.neighbor_encoder(support_left_connections, support_left_degrees,support_left_,support_right_-support_left_)
        support_right = self.neighbor_encoder(support_right_connections, support_right_degrees,support_right_,support_right_-support_left_)

        query_neighbor = torch.cat((query_left, query_right), dim=-1) # tanh
        support_neighbor = torch.cat((support_left, support_right), dim=-1) #
        support = support_neighbor
        query = query_neighbor

        output_s, z_mean_s, z_logvar_s,zs = self.vaemodel(support,is_support=True,is_eval=is_eval)
        output_q, z_mean_q, z_logvar_q,zq = self.vaemodel(query,is_support=False,is_eval=is_eval)
        mse_loss = F.mse_loss(input=output_s, target=support, reduction='mean')+F.mse_loss(input=output_q, target=query, reduction='mean')
        zs = torch.mean(zs, dim=0, keepdim=True)
        return self.fc(torch.abs(zs.expand_as(zq) - zq)), 0.2*mse_loss
"""All classification averages specify the frozen 85-class universe."""
import numpy as np
import pandas as pd
from sklearn.metrics import (accuracy_score, average_precision_score, cohen_kappa_score,
                             confusion_matrix, f1_score, matthews_corrcoef,
                             precision_recall_fscore_support, roc_auc_score)

LABELS = np.arange(85)


def classification_metrics(y, probabilities):
    prediction = probabilities.argmax(1)
    precision, recall, f1, support = precision_recall_fscore_support(
        y, prediction, labels=LABELS, zero_division=0)
    records = []
    for label in LABELS:
        truth = y == label
        auc = float(roc_auc_score(truth, probabilities[:, label])) if truth.any() and not truth.all() else None
        ap = float(average_precision_score(truth, probabilities[:, label])) if truth.any() else None
        records.append({'event_id': int(label), 'precision': float(precision[label]),
                        'recall': float(recall[label]), 'f1': float(f1[label]), 'support': int(support[label]),
                        'predicted': int((prediction == label).sum()), 'roc_auc_ovr': auc, 'average_precision_ovr': ap})
    aucs = [r['roc_auc_ovr'] for r in records if r['roc_auc_ovr'] is not None]
    aps = [r['average_precision_ovr'] for r in records if r['average_precision_ovr'] is not None]
    metrics = {'rows': len(y), 'accuracy': float(accuracy_score(y, prediction)),
               'macro_f1_85': float(f1.mean()), 'macro_precision_85': float(precision.mean()),
               'macro_recall_85': float(recall.mean()),
               'weighted_f1': float(f1_score(y, prediction, labels=LABELS, average='weighted', zero_division=0)),
               'micro_f1': float(f1_score(y, prediction, labels=LABELS, average='micro', zero_division=0)),
               'mcc': float(matthews_corrcoef(y, prediction)), 'kappa': float(cohen_kappa_score(y, prediction, labels=LABELS)),
               'classes_present': int((support > 0).sum()),
               'macro_roc_auc_supported_classes': float(np.mean(aucs)) if aucs else None,
               'roc_auc_classes': len(aucs),
               'macro_ap_supported_classes': float(np.mean(aps)) if aps else None,
               'ap_classes': len(aps)}
    return metrics, pd.DataFrame(records), confusion_matrix(y, prediction, labels=LABELS)


def validation_selection_metric(y, probabilities):
    return float(f1_score(y, probabilities.argmax(1), labels=LABELS, average='macro', zero_division=0))
"""Confirm real progress of all four launched arms (no signals, read-only).

Per arm: wrapper/trainer PID, PPID, session, process identity; the start line;
the first training step and a 100-update progress line (or, for a finished
snapshot, the selected-best test export). Also records the original jobs.
Writes logs/accelerated_four/launch.json and updates status.json.
"""
import argparse
import json
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from accelerated_four.jobs import ARMS, STATE, live, process_start, read_json, write_json  # noqa: E402
from accelerated_four.status import update_status  # noqa: E402


def events(log):
    found = {}
    for line in Path(log).read_text(errors='replace').splitlines():
        if line.startswith('{'):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            phase = event.get('phase', 'epoch' if 'validation' in event else None)
            if phase == 'train_progress' and 'first_step' not in found:
                found['first_step'] = event
            if phase == 'train_progress' and event['update'] % 100 == 0:
                found['progress_100'] = event
            if phase:
                found[phase] = event
    return found


def ps(pid):
    out = subprocess.run(['ps', '-o', 'pid=,ppid=,pgid=,sid=,etime=,args=', '-p', str(pid)],
                         capture_output=True, text=True).stdout.strip()
    return out or None


def arm_state(arm):
    record = read_json(STATE / arm / 'record.json')
    process = STATE / arm / f'attempt_{record["attempt"]}_process.json'
    trainer = read_json(process) if process.exists() else None
    found = events(record['log'])
    ok = 'start' in found and (('first_step' in found and 'progress_100' in found) or 'best_checkpoint_test' in found)
    return {'pid': record['pid'], 'wrapper_ps': ps(record['pid']),
            'wrapper_ppid_is_1': (ps(record['pid']) or '').split()[1:2] == ['1'],
            'trainer': trainer, 'trainer_ps': ps(trainer['pid']) if trainer else None,
            'trainer_alive_same_process': bool(trainer) and process_start(trainer['pid']) == trainer['process_start'],
            'live': live(record), 'mode': record['mode'], 'log': record['log'],
            'start': found.get('start'), 'first_step': found.get('first_step'), 'progress_100': found.get('progress_100'),
            'test_export': found.get('best_checkpoint_test', {}).get('macro_f1_85'),
            'exit': read_json(Path(record['exit_file'])) if Path(record['exit_file']).exists() else None,
            'progress_confirmed': ok}


def originals():
    result = {}
    for arm in ARMS:
        record = read_json(ROOT / 'logs/server_jobs' / arm / 'record.json')
        process = read_json(ROOT / 'logs/server_jobs' / arm / f'attempt_{record["attempt"]}_process.json')
        result[arm] = {'pid': process['pid'], 'alive_same_process': process_start(process['pid']) == process['process_start'],
                       'exit': read_json(Path(record['exit_file'])) if Path(record['exit_file']).exists() else None}
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--wait', type=float, default=0.)
    args = parser.parse_args()
    deadline = time.time() + args.wait
    while True:
        arms = {arm: arm_state(arm) for arm in ARMS}
        done = all(a['progress_confirmed'] or a['exit'] is not None for a in arms.values())
        if done or time.time() > deadline:
            break
        time.sleep(15)
    gpus = subprocess.run(['nvidia-smi', '--query-compute-apps=gpu_uuid,pid,used_memory', '--format=csv,noheader'],
                          capture_output=True, text=True).stdout.splitlines()
    launch = {'checked_at': time.strftime('%Y-%m-%dT%H:%M:%S%z'), 'arms': arms, 'original_jobs': originals(),
              'gpu_compute_apps': gpus, 'loadavg': list(__import__('os').getloadavg()),
              'all_progress_confirmed': all(a['progress_confirmed'] for a in arms.values())}
    write_json(ROOT / 'logs/accelerated_four/launch.json', launch)
    update_status('launched_progress_confirmed' if launch['all_progress_confirmed'] else 'launched_progress_unconfirmed',
                  launch_check={'json': str(ROOT / 'logs/accelerated_four/launch.json'),
                                'all_progress_confirmed': launch['all_progress_confirmed'],
                                'pids': {a: v['pid'] for a, v in arms.items()},
                                'trainer_pids': {a: (v['trainer'] or {}).get('pid') for a, v in arms.items()}})
    print(json.dumps(launch, indent=1))
    return 0 if launch['all_progress_confirmed'] else 1


if __name__ == '__main__':
    sys.exit(main())
"""Merge implementation progress into logs/accelerated_four/status.json (shared with Codex)."""
import json
from pathlib import Path
import time

STATUS = Path(__file__).resolve().parents[1] / 'logs/accelerated_four/status.json'


def update_status(stage, **fields):
    status = json.loads(STATUS.read_text()) if STATUS.exists() else {}
    implementation = status.setdefault('implementation', {})
    implementation.update(fields)
    implementation['stage'] = stage
    implementation['updated_at'] = time.strftime('%Y-%m-%dT%H:%M:%S%z')
    status['stage'] = stage
    temporary = STATUS.with_name(STATUS.name + '.tmp')
    temporary.write_text(json.dumps(status, indent=1, allow_nan=False) + '\n')
    temporary.replace(STATUS)

