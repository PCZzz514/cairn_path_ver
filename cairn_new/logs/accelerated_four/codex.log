cd /data/interns/zhangpc/cairn_new
bash accelerated_four/launch_four.sh --launch-reviewed   # waits up to 30 min for real progress, writes logs/accelerated_four/launch.json
source accelerated_four/env.sh; CUDA_VISIBLE_DEVICES='' "$PYTHON_BIN" accelerated_four/jobs.py --status
bash accelerated_four/monitor/start_monitor.sh           # refuses until all four show progress
```

