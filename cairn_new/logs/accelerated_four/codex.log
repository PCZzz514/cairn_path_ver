ACCEL_DIR="$ROOT_DIR/accelerated_four"
LOG_DIR="$ROOT_DIR/logs/accelerated_four"
cd "$ROOT_DIR"
export PYTHONDONTWRITEBYTECODE=1
# accelerated_four.dsn (new) and cairn_dsn (read-only OLD reference) both resolve from ROOT.
