#!/usr/bin/env bash
# Host launch of all four accelerated replicas. Codex runs this ONLY after
# writing logs/accelerated_four/review_approval.json; the controller refuses
# otherwise. Each arm: detached session (wrapper orphaned -> PPID 1) holding
# its job.lock, inherited by the training child. Then waits (bounded) for real
# progress of every arm and records logs/accelerated_four/launch.json.
# Usage: bash accelerated_four/launch_four.sh --launch-reviewed
source "$(dirname -- "${BASH_SOURCE[0]}")/env.sh"
if [[ "${1:-}" != --launch-reviewed || $# != 1 ]]; then
  echo 'Usage: bash accelerated_four/launch_four.sh --launch-reviewed (only after Codex review approval)' >&2
  exit 2
fi
CUDA_VISIBLE_DEVICES='' "$PYTHON_BIN" accelerated_four/jobs.py --launch-reviewed
CUDA_VISIBLE_DEVICES='' "$PYTHON_BIN" accelerated_four/tools/confirm_launch.py --wait 1800
"""Confirm real progress of all four launched arms (no signals, read-only).

Per arm: wrapper/trainer PID, PPID, session, process identity; the start line;
the first training step and a 100-update progress line (or, for a finished
snapshot, the selected-best test export). Also records the original jobs.
Writes logs/accelerated_four/launch.json and updates status.json.
"""
import argparse
import json
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from accelerated_four.jobs import ARMS, STATE, live, process_start, read_json, write_json  # noqa: E402
from accelerated_four.status import update_status  # noqa: E402


def events(log):
    found = {}
    for line in Path(log).read_text(errors='replace').splitlines():
        if line.startswith('{'):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            phase = event.get('phase', 'epoch' if 'validation' in event else None)
            if phase == 'train_progress' and 'first_step' not in found:
                found['first_step'] = event
            if phase == 'train_progress' and event['update'] % 100 == 0:
                found['progress_100'] = event
            if phase:
                found[phase] = event
    return found


def ps(pid):
    out = subprocess.run(['ps', '-o', 'pid=,ppid=,pgid=,sid=,etime=,args=', '-p', str(pid)],
                         capture_output=True, text=True).stdout.strip()
    return out or None


def arm_state(arm):
    record = read_json(STATE / arm / 'record.json')
    process = STATE / arm / f'attempt_{record["attempt"]}_process.json'
    trainer = read_json(process) if process.exists() else None
    found = events(record['log'])
    ok = 'start' in found and (('first_step' in found and 'progress_100' in found) or 'best_checkpoint_test' in found)
    return {'pid': record['pid'], 'wrapper_ps': ps(record['pid']),
            'wrapper_ppid_is_1': (ps(record['pid']) or '').split()[1:2] == ['1'],
            'trainer': trainer, 'trainer_ps': ps(trainer['pid']) if trainer else None,
            'trainer_alive_same_process': bool(trainer) and process_start(trainer['pid']) == trainer['process_start'],
            'live': live(record), 'mode': record['mode'], 'log': record['log'],
            'start': found.get('start'), 'first_step': found.get('first_step'), 'progress_100': found.get('progress_100'),
            'test_export': found.get('best_checkpoint_test', {}).get('macro_f1_85'),
            'exit': read_json(Path(record['exit_file'])) if Path(record['exit_file']).exists() else None,
            'progress_confirmed': ok}


def originals():
    result = {}
    for arm in ARMS:
        record = read_json(ROOT / 'logs/server_jobs' / arm / 'record.json')
        process = read_json(ROOT / 'logs/server_jobs' / arm / f'attempt_{record["attempt"]}_process.json')
        result[arm] = {'pid': process['pid'], 'alive_same_process': process_start(process['pid']) == process['process_start'],
                       'exit': read_json(Path(record['exit_file'])) if Path(record['exit_file']).exists() else None}
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--wait', type=float, default=0.)
    args = parser.parse_args()
    deadline = time.time() + args.wait
    while True:
        arms = {arm: arm_state(arm) for arm in ARMS}
        done = all(a['progress_confirmed'] or a['exit'] is not None for a in arms.values())
        if done or time.time() > deadline:
            break
        time.sleep(15)
    gpus = subprocess.run(['nvidia-smi', '--query-compute-apps=gpu_uuid,pid,used_memory', '--format=csv,noheader'],
                          capture_output=True, text=True).stdout.splitlines()
    launch = {'checked_at': time.strftime('%Y-%m-%dT%H:%M:%S%z'), 'arms': arms, 'original_jobs': originals(),
              'gpu_compute_apps': gpus, 'loadavg': list(__import__('os').getloadavg()),
              'all_progress_confirmed': all(a['progress_confirmed'] for a in arms.values())}
    write_json(ROOT / 'logs/accelerated_four/launch.json', launch)
    update_status('launched_progress_confirmed' if launch['all_progress_confirmed'] else 'launched_progress_unconfirmed',
                  launch_check={'json': str(ROOT / 'logs/accelerated_four/launch.json'),
                                'all_progress_confirmed': launch['all_progress_confirmed'],
                                'pids': {a: v['pid'] for a, v in arms.items()},
                                'trainer_pids': {a: (v['trainer'] or {}).get('pid') for a, v in arms.items()}})
    print(json.dumps(launch, indent=1))
    return 0 if launch['all_progress_confirmed'] else 1


if __name__ == '__main__':
    sys.exit(main())
#!/usr/bin/env bash
# Detached accelerated_four monitor daemon (started only by start_monitor.sh).
# Pattern of scripts/monitor_loop.sh (left untouched): deterministic status,
# one gpt-6.1-sol LOW Codex check, host drain of recovery requests, after
# status, local note/notifications; a check starts every 2400 seconds.
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/../env.sh"
MONITOR_DIR="$LOG_DIR/monitor"
mkdir -p "$MONITOR_DIR"
exec 9>"$MONITOR_DIR/daemon.lock"
flock -n 9 || exit 0
echo "$$" > "$MONITOR_DIR/monitor.pid"
export CODEX_HOME="$ROOT_DIR/.codex_runtime"
export CUDA_VISIBLE_DEVICES=4,5,6,7
# Use the existing proxy service without shell initialization/history writes.
export http_proxy=http://127.0.0.1:7890 https_proxy=http://127.0.0.1:7890
export all_proxy=socks5://127.0.0.1:7890 no_proxy=localhost,127.0.0.1,::1
export HTTP_PROXY="$http_proxy" HTTPS_PROXY="$https_proxy"
export ALL_PROXY="$all_proxy" NO_PROXY="$no_proxy"
cd "$ROOT_DIR"
CLI_FAILURES=0
trap 'date -u +%FT%TZ > "$MONITOR_DIR/stopped_at.txt"' EXIT
status_to() {
  # A status/verifier error is recorded and never stops monitoring.
  CUDA_VISIBLE_DEVICES='' "$PYTHON_BIN" accelerated_four/jobs.py --status > "$1" 2> "$1.err" \
    || printf '{"all_complete": false, "status_error": true, "runs": {}}\n' > "$1"
}
while true; do
  CHECK_ID="$(date -u +%Y%m%dT%H%M%SZ)_$$"
  CHECK_DIR="$MONITOR_DIR/checks/$CHECK_ID"
  mkdir -p "$CHECK_DIR"
  date -u +%FT%TZ > "$MONITOR_DIR/last_check.txt"
  date -u -d '+2400 seconds' +%FT%TZ > "$MONITOR_DIR/next_check.txt"
  # Check lock covers both state reads, Codex, and the host recovery drain.
  exec 7>"$MONITOR_DIR/check.lock"
  flock 7
  status_to "$CHECK_DIR/before.json"
  cp "$CHECK_DIR/before.json" "$MONITOR_DIR/snapshot_summary.json"
  if "$PYTHON_BIN" - "$CHECK_DIR/before.json" <<'PY'
import json, sys
sys.exit(0 if json.load(open(sys.argv[1]))['all_complete'] else 1)
PY
  then
    cp "$CHECK_DIR/before.json" "$MONITOR_DIR/final_summary.json"
    "$PYTHON_BIN" accelerated_four/monitor/notify.py "$CHECK_DIR/before.json" complete || true
    echo 'complete' > "$MONITOR_DIR/state.txt"
    echo 'All four selected-best checkpoint tests and complete exports verified.'
    rm -f "$MONITOR_DIR/next_check.txt"
    exit 0
  fi
  echo 'monitoring' > "$MONITOR_DIR/state.txt"
  printf '%s model=gpt-6.1-sol reasoning=low interval_seconds=2400\n' "$CHECK_ID"
  # A CLI timeout affects ONLY this check, never a training process.
  if timeout --signal=TERM --kill-after=30s 1200s \
      /data/interns/zhangpc/.local/bin/codex exec \
      --skip-git-repo-check --ephemeral --ignore-user-config \
      -s workspace-write -c 'sandbox_workspace_write.network_access=true' \
      -c 'model_reasoning_effort="low"' -m gpt-6.1-sol -C "$ROOT_DIR" \
      -o "$CHECK_DIR/codex_final.txt" - < accelerated_four/monitor/prompt.md \
      > "$CHECK_DIR/codex.log" 2>&1; then
    CLI_FAILURES=0
  else
    CLI_EXIT=$?
    CLI_FAILURES=$((CLI_FAILURES + 1))
    printf '%s exit=%s consecutive_failures=%s\n' "$CHECK_ID" "$CLI_EXIT" "$CLI_FAILURES" >> "$MONITOR_DIR/cli_failures.log"
  fi
  # Launch recovery only here, outside the CLI timeout and its PID namespace.
  if CUDA_VISIBLE_DEVICES='' "$PYTHON_BIN" accelerated_four/monitor/drain_recovery_requests.py \
      > "$CHECK_DIR/recovery_drain.log" 2>&1; then
    :
  else
    DRAIN_EXIT=$?
    printf '%s drain_exit=%s\n' "$CHECK_ID" "$DRAIN_EXIT" >> "$MONITOR_DIR/recovery_drain_errors.log"
  fi
  status_to "$CHECK_DIR/after.json"
  cp "$CHECK_DIR/after.json" "$MONITOR_DIR/snapshot_summary.json"
  OUTCOME="$("$PYTHON_BIN" - "$CHECK_DIR/after.json" <<'PY' || echo monitoring
import json, sys
state = json.load(open(sys.argv[1]))
if state['all_complete']:
    print('complete')
elif state['runs'] and all(r['state'] in ('complete', 'exhausted') for r in state['runs'].values()):
    print('blocked_recovery_budget')
else:
    print('monitoring')
PY
  )"
  echo "$OUTCOME" > "$MONITOR_DIR/state.txt"
  "$PYTHON_BIN" accelerated_four/monitor/notify.py "$CHECK_DIR/after.json" "$OUTCOME" \
    > "$CHECK_DIR/notify.log" 2>&1 || true
  if [[ "$OUTCOME" != monitoring ]]; then
    cp "$CHECK_DIR/after.json" "$MONITOR_DIR/final_summary.json"
    rm -f "$MONITOR_DIR/next_check.txt"
    [[ "$OUTCOME" == complete ]] && exit 0
    echo "Monitor blocked: $OUTCOME; see final_summary.json and attempt logs" >&2
    exit 1
  fi
  flock -u 7
  # Maintain a 2400-second interval between check starts, including CLI time.
  NEXT_EPOCH="$(date -u -d "$(cat "$MONITOR_DIR/next_check.txt")" +%s)"
  NOW_EPOCH="$(date -u +%s)"
  if (( NEXT_EPOCH > NOW_EPOCH )); then
    sleep "$((NEXT_EPOCH - NOW_EPOCH))"
  fi
done
#!/usr/bin/env bash
# Start the detached accelerated_four monitor daemon ONLY after all four jobs
# have records and confirmed real progress. Safe to repeat while it is live.
# Usage: bash accelerated_four/monitor/start_monitor.sh
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/../env.sh"
export CUDA_VISIBLE_DEVICES=''
MONITOR_DIR="$LOG_DIR/monitor"
mkdir -p "$MONITOR_DIR"
# Serialize monitor launches separately from its long-lived daemon lock.
exec 8>"$MONITOR_DIR/launcher.lock"
flock -n 8 || { echo 'Another monitor launch is in progress' >&2; exit 1; }
if ! flock -n "$MONITOR_DIR/daemon.lock" true; then
  echo "Monitor is already running; see $MONITOR_DIR/monitor.pid"
  exit 0
fi
"$PYTHON_BIN" - "$MONITOR_DIR" <<'PY'
import subprocess
import sys
import time
from pathlib import Path
from accelerated_four.jobs import ARMS, STATE
from accelerated_four.tools.confirm_launch import arm_state
from accelerated_four.status import update_status
monitor = Path(sys.argv[1])
for arm in ARMS:
    if not (STATE / arm / 'record.json').is_file():
        raise SystemExit('Launch and confirm all four jobs before starting the monitor')
    state = arm_state(arm)
    if not (state['progress_confirmed'] or state['exit'] is not None):
        raise SystemExit(f'{arm}: no confirmed real progress yet (start line, first step and 100-update line)')
