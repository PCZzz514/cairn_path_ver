@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+# Source this from this workspace; the existing cairn environment is read-only.
+set -euo pipefail
+ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT_DIR"
+export PYTHONDONTWRITEBYTECODE=1
+export TMPDIR="$ROOT_DIR/tmp"
+export XDG_CACHE_HOME="$ROOT_DIR/.cache"
+export TORCH_HOME="$ROOT_DIR/.cache/torch"
+export TRITON_CACHE_DIR="$ROOT_DIR/.cache/triton"
+export CUDA_CACHE_PATH="$ROOT_DIR/.cache/cuda"
+export MPLCONFIGDIR="$ROOT_DIR/.cache/matplotlib"
+export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
+PYTHON_BIN="$ROOT_DIR/../cairn_dev/.conda/cairn/bin/python"
+mkdir -p "$TMPDIR" "$XDG_CACHE_HOME" "$TORCH_HOME" "$TRITON_CACHE_DIR" "$CUDA_CACHE_PATH" "$MPLCONFIGDIR" "$ROOT_DIR/logs"
diff --git a/scripts/train_arm.sh b/scripts/train_arm.sh
new file mode 100644
index 0000000000000000000000000000000000000000..6e59892b80beccde40502385e24fbad6f274e083
--- /dev/null
+++ b/scripts/train_arm.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+# Launch exactly one reviewed arm. No training starts by sourcing runtime.sh.
+set -euo pipefail
+source "$(dirname -- "${BASH_SOURCE[0]}")/runtime.sh"
+VARIANT="${1:?variant: path or no_path}"
+PROTOCOL="${2:?protocol: single_drugout or double_drugout}"
+shift 2
+case "$VARIANT/$PROTOCOL" in
+  path/single_drugout) export CUDA_VISIBLE_DEVICES=4 ;;
+  path/double_drugout) export CUDA_VISIBLE_DEVICES=5 ;;
+  no_path/single_drugout) export CUDA_VISIBLE_DEVICES=6 ;;
