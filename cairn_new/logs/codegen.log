"""RareDDIE's fixed 55-atom / 17-bond molecular representation.

Source: RareDDIE/data_preprocessing_t.py at the recorded upstream revision.
The values and directed-bond ordering match the active atom_features and
get_mol_edge_list_and_feat_mtx functions; no fingerprint branch is used.
"""
from rdkit import Chem
import torch
from torch_geometric.data import Data

ATOM_SYMBOLS = [
    "C", "N", "O", "S", "F", "Si", "P", "Cl", "Br", "Mg", "Na", "Ca",
    "Fe", "As", "Al", "I", "B", "V", "K", "Tl", "Yb", "Sb", "Sn", "Ag",
    "Pd", "Co", "Se", "Ti", "Zn", "H", "Li", "Ge", "Cu", "Au", "Ni", "Cd",
    "In", "Mn", "Zr", "Cr", "Pt", "Hg", "Pb", "Unknown",
]
HYBRIDIZATIONS = [
    Chem.rdchem.HybridizationType.SP,
    Chem.rdchem.HybridizationType.SP2,
    Chem.rdchem.HybridizationType.SP3,
    Chem.rdchem.HybridizationType.SP3D,
    Chem.rdchem.HybridizationType.SP3D2,
]


def one_hot_unknown(value, choices):
    value = value if value in choices else choices[-1]
    return [float(value == choice) for choice in choices]


def atom_features(atom):
    return torch.tensor(
        one_hot_unknown(atom.GetSymbol(), ATOM_SYMBOLS)
        + [
            atom.GetDegree() / 10.0,
            atom.GetValence(Chem.ValenceType.IMPLICIT),
            atom.GetFormalCharge(),
            atom.GetNumRadicalElectrons(),
        ]
        + one_hot_unknown(atom.GetHybridization(), HYBRIDIZATIONS)
        + [float(atom.GetIsAromatic()), atom.GetTotalNumHs()],
        dtype=torch.float32,
    )


def bond_features(bond):
    kind = bond.GetBondType()
    return torch.tensor(
        [
            kind == Chem.rdchem.BondType.SINGLE,
            kind == Chem.rdchem.BondType.DOUBLE,
            kind == Chem.rdchem.BondType.TRIPLE,
            kind == Chem.rdchem.BondType.AROMATIC,
            0,
            0,
        ]
        + one_hot_unknown(bond.GetIsConjugated(), [0, 1, "nonbond"])
        + one_hot_unknown(bond.IsInRing(), [0, 1, "nonbond"])
        + one_hot_unknown(
            str(bond.GetStereo()),
            ["STEREONONE", "STEREOANY", "STEREOZ", "STEREOE", "nonbond"],
        ),
        dtype=torch.float32,
    )


def smiles_to_graph(smiles: str) -> Data:
    mol = Chem.MolFromSmiles(smiles.strip())
    if mol is None or mol.GetNumAtoms() == 0:
        raise ValueError(f"Cannot construct a molecular graph for SMILES: {smiles!r}")
    x = torch.stack([atom_features(atom) for atom in mol.GetAtoms()])
    bonds = list(mol.GetBonds())
    if bonds:
        edges = torch.tensor(
            [[bond.GetBeginAtomIdx(), bond.GetEndAtomIdx()] for bond in bonds],
            dtype=torch.long,
        )
        edge_index = torch.cat([edges, edges[:, [1, 0]]], dim=0).T.contiguous()
        edge_attr = torch.stack([bond_features(bond) for bond in bonds]).repeat(2, 1)
    else:
        # This is the upstream representation for an isolated-atom molecule.
        edge_index = torch.zeros((2, 2), dtype=torch.long)
        edge_attr = torch.zeros((2, 17), dtype=torch.float32)
    return Data(x=x, edge_index=edge_index, edge_attr=edge_attr)

