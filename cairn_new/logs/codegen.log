"""Stage zero: actual 128-dimensional TransE on the filtered DRKG graph."""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path

os.environ["CUDA_VISIBLE_DEVICES"] = "0,1,2,3"

import torch
import torch.distributed as dist
import torch.nn.functional as F
import yaml
from torch import nn
from torch.nn.parallel import DistributedDataParallel
from torch.utils.data import DataLoader, DistributedSampler, TensorDataset


class TransE(nn.Module):
    def __init__(self, entities, relations, settings):
        super().__init__()
        self.entities = nn.Embedding(len(entities), int(settings["dimension"]))
        self.relations = nn.Embedding(len(relations), int(settings["dimension"]))
        nn.init.uniform_(self.entities.weight, -0.1, 0.1)
        nn.init.uniform_(self.relations.weight, -0.1, 0.1)
        self.norm = int(settings["norm"])
        self.negative_samples = int(settings["negative_samples"])
        types = sorted({entity.split("::", 1)[0] for entity in entities})
        type_rows = {name: i for i, name in enumerate(types)}
        entity_types = torch.tensor([type_rows[entity.split("::", 1)[0]] for entity in entities])
        grouped = [torch.where(entity_types == i)[0] for i in range(len(types))]
        counts = torch.tensor([len(group) for group in grouped])
        self.register_buffer("entity_types", entity_types, persistent=False)
        self.register_buffer("type_entities", torch.cat(grouped), persistent=False)
        self.register_buffer("type_counts", counts, persistent=False)
        self.register_buffer("type_offsets", counts.cumsum(0) - counts, persistent=False)

    def distance(self, head, relation, tail):
        head = F.normalize(self.entities(head), dim=-1)
        tail = F.normalize(self.entities(tail), dim=-1)
        return (head + self.relations(relation) - tail).norm(p=self.norm, dim=-1)

    def forward(self, triples):
        head, relation, tail = triples.unbind(dim=1)
        positive = self.distance(head, relation, tail)
        negatives = []
        for _ in range(self.negative_samples):
            corrupt_head = torch.rand(len(triples), device=triples.device) < 0.5
            original = torch.where(corrupt_head, head, tail)
            entity_type = self.entity_types[original]
            position = self.type_offsets[entity_type] + (
                torch.rand(len(triples), device=triples.device) * self.type_counts[entity_type]
            ).long()
            replacement = self.type_entities[position]
            negative_head = torch.where(corrupt_head, replacement, head)
            negative_tail = torch.where(corrupt_head, tail, replacement)
            negatives.append(self.distance(negative_head, relation, negative_tail))
        return positive, torch.stack(negatives, dim=1)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", default="configs/model.yaml")
    args = parser.parse_args()
    config = yaml.safe_load(Path(args.config).read_text())
    settings = config["fin"]
    rank = int(os.environ.get("RANK", "0"))
    world = int(os.environ.get("WORLD_SIZE", "1"))
    local_rank = int(os.environ.get("LOCAL_RANK", "0"))
    threads = int(config["runtime"]["threads_per_rank"])
    allowed = sorted(os.sched_getaffinity(0))
    os.sched_setaffinity(0, allowed[rank * threads:(rank + 1) * threads])
    torch.set_num_threads(threads)
    torch.cuda.set_device(local_rank)
    device = torch.device("cuda", local_rank)
    if world > 1:
        dist.init_process_group("nccl")
    torch.manual_seed(config["seed"])
    processed = Path(config["processed"])
    source = torch.load(processed / "drkg_triples.pt", map_location="cpu", weights_only=False)
    dataset = TensorDataset(source["triples"].long())
    sampler = DistributedSampler(dataset, num_replicas=world, rank=rank, seed=config["seed"])
    loader = DataLoader(dataset, batch_size=int(settings["global_batch"]) // world,
                        sampler=sampler, num_workers=0, pin_memory=True)
    model = TransE(source["entities"], source["relations"], settings).to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=float(settings["learning_rate"]))
    training_model = DistributedDataParallel(model, device_ids=[local_rank], broadcast_buffers=False) if world > 1 else model
    torch.manual_seed(config["seed"] + rank)
    output = Path(config["outputs"]) / "fin"
    output.mkdir(parents=True, exist_ok=True)
    if rank == 0:
        (output / "config.yaml").write_text(yaml.safe_dump(config, sort_keys=False))
        print(json.dumps({"stage": "fin", "triples": len(dataset), "entities": len(source["entities"]),
                          "relations": len(source["relations"]), "dimension": settings["dimension"],
                          "typed_negative_sampling": True}), flush=True)
    best = float("inf")
    bad_epochs = 0
    for epoch in range(1, int(settings["epochs"]) + 1):
        sampler.set_epoch(epoch)
        totals = torch.zeros(4, device=device, dtype=torch.float64)
        for (triples,) in loader:
            triples = triples.to(device, non_blocking=True)
            optimizer.zero_grad(set_to_none=True)
            positive, negative = training_model(triples)
            loss = F.relu(float(settings["margin"]) + positive[:, None] - negative).mean()
            loss.backward()
            optimizer.step()
            count = len(triples)
            totals += torch.stack((loss.detach().double() * count,
                                   positive.detach().double().sum(),
                                   negative.detach().double().mean(dim=1).sum(),
                                   torch.tensor(count, device=device, dtype=torch.float64)))
        if world > 1:
            dist.all_reduce(totals)
        mean_loss = float(totals[0] / totals[3])
        improved = mean_loss < best - float(settings["min_delta"])
        if improved:
            best = mean_loss
            bad_epochs = 0
        else:
            bad_epochs += 1
        if rank == 0:
            record = {"epoch": epoch, "loss": float(totals[0] / totals[3]),
                      "positive_distance": float(totals[1] / totals[3]),
                      "negative_distance": float(totals[2] / totals[3]),
                      "learning_rate": float(settings["learning_rate"])}
            with (output / "train.jsonl").open("a") as stream:
                stream.write(json.dumps(record) + "\n")
            print(json.dumps(record), flush=True)
            torch.save({"stage": "fin", "epoch": epoch, "model": model.state_dict(),
                        "optimizer": optimizer.state_dict(), "config": config,
                        "training_metrics": record}, output / "last.pt")
            if improved:
                torch.save({"entities": F.normalize(model.entities.weight.detach(), dim=-1).cpu(),
                        "relations": model.relations.weight.detach().cpu(),
                        "entity_ids": source["entities"], "relation_ids": source["relations"],
                        "epoch": epoch, "training_loss": record["loss"], "dimension": settings["dimension"]},
                           processed / "fin.pt")
        if world > 1:
            dist.barrier()
        if bad_epochs >= int(settings["patience"]):
            break
    if world > 1:
        dist.destroy_process_group()


if __name__ == "__main__":
    main()
