+++ b/cairn_dsn/prepare.py
@@ -0,0 +1,187 @@
+"""Prepare all real frozen DDI rows and reusable label-free graph topology on CPU."""
+import argparse
+from collections import Counter
+import json
+import multiprocessing as mp
+from pathlib import Path
+import shutil
+import numpy as np
+import pandas as pd
+import torch
+from .paths import RouteExtractor
+
+ROOT = Path(__file__).resolve().parents[1]
+DEV = ROOT.parent / 'cairn_dev'
+PROCESSED = DEV / 'data/processed'
+OUT = ROOT / 'data/prepared'
+EXTRACTOR = None
+DRUG_FIN = None
+
+
+def extract_job(job):
+    a, b = job
+    h, t = int(DRUG_FIN[a]), int(DRUG_FIN[b])
+    nodes, edges, present = EXTRACTOR.extract(h, t)
+    ends = [int(np.where(nodes == h)[0][0]), int(np.where(nodes == t)[0][-1])]
+    return nodes, edges, ends, present
+
+
+def main():
+    global EXTRACTOR, DRUG_FIN
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--workers', type=int, default=8)
+    parser.add_argument('--meeting-cap', type=int, default=32)
+    parser.add_argument('--arm-cap', type=int, default=2)
+    args = parser.parse_args()
+    OUT.mkdir(parents=True, exist_ok=True)
+    bundle = torch.load(PROCESSED / 'bundle.pt', map_location='cpu', weights_only=False)
+    fin = torch.load(PROCESSED / 'fin.pt', map_location='cpu', weights_only=False)
+    drkg = torch.load(PROCESSED / 'drkg_triples.pt', map_location='cpu', weights_only=False)
+    entities, relations = drkg['entities'], drkg['relations']
+    assert fin['entity_ids'] == entities and fin['relation_ids'] == relations
+    assert pd.read_csv(PROCESSED / 'drkg_entities.csv').entity.tolist() == entities
+    assert pd.read_csv(PROCESSED / 'drkg_relations.csv').relation.tolist() == relations
+    assert torch.equal(fin['entities'], bundle['fin_entities'])
+    assert torch.equal(fin['relations'], bundle['fin_relations'])
+    events = pd.read_csv(PROCESSED / 'ddi_events.csv')
+    assert events.event_id.tolist() == list(range(85))
+    assert events.template.tolist() == bundle['ddi_event_names']
+    frames, report = {}, {'protocols': {}}
+    expected = {'single_drugout': {'train': 149048, 'val': 20785, 'test': 16978},
+                'double_drugout': {'train': 149048, 'val': 760, 'test': 534}}
+    for protocol in expected:
+        source = DEV / 'data/experiments/reference85' / protocol / 'ddi.parquet'
+        frame = pd.read_parquet(source)
+        counts = frame.groupby('split').size().to_dict()
+        assert counts == expected[protocol]
+        assert frame.event_id.between(0, 84).all()
+        for col in ['drug_a', 'drug_b']:
+            assert frame[col].between(0, len(bundle['drug_ids']) - 1).all()
+        dest = OUT / protocol
+        dest.mkdir(exist_ok=True)
+        shutil.copyfile(source, dest / 'ddi.parquet')
+        assert pd.read_parquet(dest / 'ddi.parquet').equals(frame)
+        frames[protocol] = frame
+        report['protocols'][protocol] = {'counts': counts, 'source': str(source),
+                                          'exact_dataframe_equal': True, 'splits': {}}
+    shutil.copyfile(PROCESSED / 'ddi_events.csv', OUT / 'ddi_events.csv')
+    pairs = pd.concat([f[['drug_a', 'drug_b']] for f in frames.values()]).drop_duplicates().sort_values(['drug_a', 'drug_b'])
+    pairs = pairs.to_numpy(np.int32)
+    np.save(OUT / 'pairs.npy', pairs)
+    active = np.unique(pairs)
+    assert all(bundle['graphs'][int(d)].x.shape[1] == 55 and
+               bundle['graphs'][int(d)].edge_attr.shape[1] == 17 for d in active)
+    # Original IDs stay global; store only active molecular graphs.
+    graphs = {int(d): bundle['graphs'][int(d)] for d in active}
+    # Reuse the existing audited six-type neighborhood table (all DrugBank
+    # aliases + original XML target prefix). Select a deterministic balanced cap.
+    source_neigh = DEV / 'data/experiments/no_gene_embeddings_six_relations/shared/neighbours.parquet'
+    neighbors = pd.read_parquet(source_neigh)
+    six_file = DEV / 'references/RareDDIE_source/RareDDIE-f658cae053af1e93eecc88ad77dc3af2e33cf527/RareDDIE/dataset1/dti_rel.csv'
+    six = pd.read_csv(six_file, header=None).iloc[:, 0].tolist()
+    six_ids = [relations.index(name) for name in six]
+    assert set(neighbors.relation_idx.unique()) == set(six_ids)
+    assert all(entities[i].startswith('Gene::') for i in neighbors.fin_idx.unique())
+    assert all(bundle['drug_ids'][int(d)] == drug for d, drug in
+               neighbors[['drug', 'drug_id']].drop_duplicates().itertuples(index=False, name=None))
+    local_ent = torch.full((len(bundle['drug_ids']), 30), -1, dtype=torch.long)
+    local_rel = torch.full_like(local_ent, -1)
+    selected_rows = []
+    for drug, group in neighbors.groupby('drug', sort=False):
+        # Original slot order within each relation, round-robin in official
+        # dti_rel.csv relation order. Cap never changes DRKG or FIN indices.
+        buckets = [group[group.relation_idx == r].sort_values('slot').to_dict('records') for r in six_ids]
+        chosen = []
+        for position in range(30):
+            for bucket in buckets:
+                if position < len(bucket):
+                    chosen.append(bucket[position])
+                    if len(chosen) == 30:
+                        break
+            if len(chosen) == 30:
+                break
+        for slot, row in enumerate(chosen):
+            local_ent[int(drug), slot] = int(row['fin_idx'])
+            local_rel[int(drug), slot] = int(row['relation_idx'])
+            selected_rows.append({**row, 'selected_slot': slot})
+    pd.DataFrame(selected_rows).to_parquet(OUT / 'nai_neighbors.parquet', index=False)
+    DRUG_FIN = bundle['drug_fin_idx'].numpy()
+    torch.save({'graphs': graphs, 'drug_ids': bundle['drug_ids'], 'drug_fin_idx': bundle['drug_fin_idx'],
+                'fin_entities': fin['entities'], 'fin_relations': fin['relations'],
+                'fin_entity_ids': entities, 'fin_relation_ids': relations,
+                'neighbor_entities': local_ent, 'neighbor_relations': local_rel,
+                'ddi_event_names': bundle['ddi_event_names'], 'num_classes': 85}, OUT / 'assets.pt')
+    report['nai'] = {'source': str(source_neigh), 'cap': 30, 'selection': 'official relation order round-robin; original slot order within relation',
+                     'six_relation_ids': dict(zip(six, six_ids)), 'selected_per_relation': {relations[r]: int((local_rel == r).sum()) for r in six_ids},
+                     'active_drugs': len(active), 'active_with_neighbors': int((local_ent[active] >= 0).any(1).sum()),
+                     'active_truncated': int(neighbors.groupby('drug').size().reindex(active, fill_value=0).gt(30).sum())}
+    triples = drkg['triples'].numpy()
+    types = np.asarray([e.split('::', 1)[0] for e in entities])
+    assert not np.any((types[triples[:, 0]] == 'Compound') & (types[triples[:, 2]] == 'Compound'))
+    relation_counts = np.bincount(triples[:, 1], minlength=len(relations))
+    report['drkg'] = {'triples': len(triples), 'entities': len(entities), 'relations': len(relations),
+                      'compound_compound': 0, 'gene_gene': int(((types[triples[:, 0]] == 'Gene') & (types[triples[:, 2]] == 'Gene')).sum()),
+                      'gene_pathway': int(((types[triples[:, 0]] == 'Gene') & (types[triples[:, 2]] == 'Pathway')).sum() +
+                                          ((types[triples[:, 2]] == 'Gene') & (types[triples[:, 0]] == 'Pathway')).sum()),
+                      'relation_counts': dict(zip(relations, relation_counts.tolist()))}
+    print('Building full-graph two-hop endpoint balls', flush=True)
+    EXTRACTOR = RouteExtractor(triples, entities, len(relations), args.meeting_cap, args.arm_cap)
+    endpoints = np.unique(DRUG_FIN[active])
+    EXTRACTOR.build_balls(endpoints[endpoints >= 0])
+    print(f'Extracting {len(pairs)} full-data pair subgraphs', flush=True)
+    # Stream results to workspace binary files, then materialize mmap-friendly
+    # .npy arrays. This avoids retaining every subgraph in Python objects.
+    node_ptr, edge_ptr, endpoint_rows, masks = [0], [0], [], []
+    retained = Counter()
+    with (OUT / 'nodes.bin').open('wb') as nf, (OUT / 'edges.bin').open('wb') as ef:
+        with mp.get_context('fork').Pool(args.workers) as pool:
+            for i, (nodes, edges, ends, present) in enumerate(pool.imap(extract_job, pairs.tolist(), chunksize=128)):
+                nodes.tofile(nf)
+                edges.tofile(ef)
+                node_ptr.append(node_ptr[-1] + len(nodes))
+                edge_ptr.append(edge_ptr[-1] + len(edges))
+                endpoint_rows.append(ends)
+                masks.append(present)
+                retained.update(edges[:, 2].tolist())
+                if (i + 1) % 10000 == 0:
+                    print(f'prepared {i + 1}/{len(pairs)} pairs, {edge_ptr[-1]} edges', flush=True)
+    for name, shape in [('nodes', (node_ptr[-1],)), ('edges', (edge_ptr[-1], 4))]:
+        raw = np.memmap(OUT / f'{name}.bin', dtype=np.int32, mode='r', shape=shape)
+        dest = np.lib.format.open_memmap(OUT / f'{name}.npy', mode='w+', dtype=np.int32, shape=shape)
+        for start in range(0, len(raw), 1000000):
+            dest[start:start + 1000000] = raw[start:start + 1000000]
+        del dest, raw
+        (OUT / f'{name}.bin').unlink()
+    for name, array in [('node_ptr', node_ptr), ('edge_ptr', edge_ptr), ('endpoints', endpoint_rows), ('path_mask', masks)]:
+        np.save(OUT / f'{name}.npy', np.asarray(array, dtype=bool if name == 'path_mask' else np.int64))
+    pair_index = {tuple(p): i for i, p in enumerate(pairs.tolist())}
+    for protocol, frame in frames.items():
+        indices = np.asarray([pair_index[a, b] for a, b in frame[['drug_a', 'drug_b']].itertuples(index=False, name=None)], np.int64)
+        np.save(OUT / protocol / 'pair_indices.npy', indices)
+        for split in ['train', 'val', 'test']:
+            chosen = frame.split.eq(split).to_numpy()
+            rows = indices[chosen]
+            drugs = np.unique(frame.loc[chosen, ['drug_a', 'drug_b']].to_numpy())
+            report['protocols'][protocol]['splits'][split] = {
+                'rows': int(chosen.sum()), 'classes_present': int(frame.loc[chosen].event_id.nunique()),
+                'with_real_path_le4': int(np.asarray(masks)[rows].sum()),
+                'path_fraction': float(np.asarray(masks)[rows].mean()),
+                'mapped_drugs': int((DRUG_FIN[drugs] >= 0).sum()), 'drugs': len(drugs),
+                'nai_drugs_present': int((local_ent[drugs] >= 0).any(1).sum())}
+    report['paths'] = {'unique_ordered_pairs': len(pairs), 'depth': 4, 'meeting_cap': args.meeting_cap,
+                       'arm_cap': args.arm_cap, 'nodes': node_ptr[-1], 'edges_with_inverses_self': edge_ptr[-1],
+                       'max_nodes': int(np.diff(node_ptr).max()), 'max_edges': int(np.diff(edge_ptr).max()),
+                       'pairs_with_paths': int(sum(masks)), 'missing': int(len(masks) - sum(masks)),
+                       'coverage_test': 'full unbounded two-hop-ball intersection before selecting real routes',
+                       'retained_relation_counts': {str(k): v for k, v in sorted(retained.items())}}
+    records = [json.loads(line) for line in (DEV / 'outputs/fin/train.jsonl').read_text().splitlines()]
+    report['fin'] = {'selected_epoch': fin['epoch'], 'completed_epoch': records[-1]['epoch'],
+                     'dimension': fin['dimension'], 'training_loss': fin['training_loss'],
+                     'mapping_order_verified': True, 'published_embeddings_used': False,
+                     'source': str(PROCESSED / 'fin.pt')}
+    (OUT / 'preparation_report.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps({'complete': True, 'paths': report['paths'], 'protocols': report['protocols']}, indent=2), flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/cairn_dsn/train.py b/cairn_dsn/train.py
new file mode 100644
index 0000000000000000000000000000000000000000..e9a0f879a570765470dce79f4b809a6208f62504
--- /dev/null
+++ b/cairn_dsn/train.py
@@ -0,0 +1,246 @@
+"""Full DDI training, fixed85 validation selection, selected-checkpoint test export."""
+import argparse
+import json
+import math
+import os
+from pathlib import Path
+import random
+import time
+import numpy as np
+import pandas as pd
+import torch
+import torch.nn.functional as F
+from torch.utils.data import DataLoader
+import yaml
+from .data import DDIDataset, Collator, to_device
+from .metrics import classification_metrics, validation_selection_metric
+from .model import DSNRareDDI
+
+ROOT = Path(__file__).resolve().parents[1]
+GPU = {(True, 'single_drugout'): 4, (True, 'double_drugout'): 5,
+       (False, 'single_drugout'): 6, (False, 'double_drugout'): 7}
+
+
+def workspace_path(value):
+    path = Path(value)
+    path = (ROOT / path).resolve() if not path.is_absolute() else path.resolve()
+    if not path.is_relative_to(ROOT):
+        raise ValueError(f'Write/data workspace must remain inside {ROOT}: {path}')
+    return path
+
+
+def save_json(path, value):
+    path.write_text(json.dumps(value, indent=2, allow_nan=False) + '\n')
+
+
+def rng_state():
+    return {'python': random.getstate(), 'numpy': np.random.get_state(), 'torch': torch.get_rng_state(),
+            'cuda': torch.cuda.get_rng_state_all()}
+
+
+def restore_rng(state):
+    random.setstate(state['python'])
+    np.random.set_state(state['numpy'])
+    torch.set_rng_state(state['torch'].cpu())
+    torch.cuda.set_rng_state_all([value.cpu() for value in state['cuda']])
+
+
+@torch.no_grad()
+def evaluate(model, loader, device, config, beta):
+    model.eval()
+    totals = {name: 0. for name in ['ce', 'rec', 'kl', 'loss']}
+    probabilities, targets, original_rows, masks = [], [], [], []
+    # Reconstruction uses normal Gaussian samples; evaluation sampling never
+    # changes training RNG. Classifier always uses deterministic mu.
+    with torch.random.fork_rng(devices=[0]):
+        torch.manual_seed(config['seed'] + 10000)
+        for raw in loader:
+            batch = to_device(raw, device)
+            output = model(batch)
+            ce = F.cross_entropy(output['logits'], batch['label'])
+            loss = ce + config['reconstruction_weight'] * output['rec'] + beta * output['kl']
+            count = len(batch['label'])
+            for name, value in [('ce', ce), ('rec', output['rec']), ('kl', output['kl']), ('loss', loss)]:
+                totals[name] += float(value) * count
+            probabilities.append(output['logits'].softmax(-1).cpu().numpy())
+            targets.append(raw['label'].numpy())
+            original_rows.append(raw['row_index'].numpy())
+            masks.append(output['path_mask'].cpu().numpy())
+    n = len(loader.dataset)
+    totals = {k: v / n for k, v in totals.items()}
+    probs, y = np.concatenate(probabilities), np.concatenate(targets)
+    totals['macro_f1_85'] = validation_selection_metric(y, probs)
+    totals['kl_beta'] = beta
+    return totals, probs, y, np.concatenate(original_rows), np.concatenate(masks)
+
+
+def export_test(model, dataset, loader, device, config, output, best):
+    totals, probabilities, y, original_rows, masks = evaluate(model, loader, device, config, config['kl_weight'])
+    metrics, per_class, confusion = classification_metrics(y, probabilities)
+    metrics.update({'loss_terms': totals, 'checkpoint': 'best.pt', 'selected_epoch': best['epoch'],
+                    'selected_validation_macro_f1_85': best['best_metric'], 'selection': 'validation only'})
+    frame = dataset.frame.copy()
+    assert np.array_equal(original_rows, dataset.rows)
+    frame.insert(0, 'frozen_row_index', original_rows)
+    frame['predicted_event_id'] = probabilities.argmax(1)
+    frame['predicted_probability'] = probabilities.max(1)
+    if config['with_path']:
+        frame['path_v_to_u_present'] = masks[:, 0]
+        frame['path_u_to_v_present'] = masks[:, 1]
+    frame.to_parquet(output / 'test_predictions.parquet', index=False)
+    np.savez_compressed(output / 'test_probabilities.npz', probabilities=probabilities,
+                        event_ids=np.arange(85), labels=y, frozen_row_indices=original_rows, path_mask=masks)
+    events = pd.read_csv(workspace_path(config['prepared']) / 'ddi_events.csv')
+    per_class.merge(events, on='event_id', how='left').to_csv(output / 'test_per_class.csv', index=False)
+    pd.DataFrame(confusion, index=np.arange(85), columns=np.arange(85)).rename_axis('true_event_id').to_csv(output / 'test_confusion.csv')
+    save_json(output / 'test_metrics.json', metrics)
+    print(json.dumps({'phase': 'best_checkpoint_test', **metrics}), flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--config', required=True)
+    parser.add_argument('--batch-size', type=int)
+    parser.add_argument('--resume', action='store_true')
+    parser.add_argument('--test-only', action='store_true')
+    args = parser.parse_args()
+    config = yaml.safe_load(workspace_path(args.config).read_text())
+    if args.batch_size is not None:
+        config['batch_size'] = args.batch_size
+    # This is checked before the first CUDA operation. Only the assigned one
+    # physical device is visible, including RNG and allocator operations.
+    assigned = GPU[config['with_path'], config['protocol']]
+    if config['gpu'] != assigned or os.environ.get('CUDA_VISIBLE_DEVICES') != str(assigned):
+        raise ValueError(f'This arm requires CUDA_VISIBLE_DEVICES={assigned} and config gpu={assigned}')
+    torch.set_num_threads(config['cpu_threads'])
+    random.seed(config['seed'])
+    np.random.seed(config['seed'])
+    torch.manual_seed(config['seed'])
+    device = torch.device('cuda:0')
+    prepared = workspace_path(config['prepared'])
+    output_dir = workspace_path(config['output'])
+    output_dir.mkdir(parents=True, exist_ok=True)
+    if args.test_only:
+        selected = torch.load(output_dir / 'best.pt', map_location='cpu', weights_only=False)
+        assert selected['config']['gpu'] == assigned and selected['config']['protocol'] == config['protocol']
+        # Evaluation restores the authoritative training configuration and keeps
+        # config.yaml intact, even when the evaluation batch is overridden.
+        config = selected['config']
+        del selected
+    loader_batch = args.batch_size if args.test_only and args.batch_size else config['batch_size']
+    # Save the fully resolved settings (including memory-driven batch override).
+    if not args.test_only:
+        config.update({'prepared': str(prepared), 'output': str(output_dir), 'generator': 'gpt-6.1-sol high',
+                       'selection_metric': 'fixed85 validation macroF1', 'test_selection': False,
+                       'source_provenance': json.loads((ROOT / 'docs/source_provenance.json').read_text())})
+        (output_dir / 'config.yaml').write_text(yaml.safe_dump(config, sort_keys=False))
+    preparation = json.loads((prepared / 'preparation_report.json').read_text())
+    assert config['nai_cap'] == preparation['nai']['cap']
+    assert config['path_depth'] == preparation['paths']['depth']
+    assert config['path_meeting_cap'] == preparation['paths']['meeting_cap']
+    assert config['path_arm_cap'] == preparation['paths']['arm_cap']
+    # Full-data audit is a preparation requirement, not a toy model probe.
+    audit = json.loads((prepared / 'audit_report.json').read_text())
+    assert audit['all_cached_real_edges_found_in_source'] and audit['all_pairs_depth4_reachability_equals_explicit_mask']
+    assets = torch.load(prepared / 'assets.pt', map_location='cpu', weights_only=False)
+    model = DSNRareDDI(assets, config).to(device)
+    optimizer = torch.optim.AdamW(model.parameters(), lr=config['learning_rate'], weight_decay=config['weight_decay'])
+    collate = Collator(assets, prepared, config['with_path'])
+    datasets = {split: DDIDataset(prepared, config['protocol'], split) for split in ['train', 'val']}
+    loaders = {split: DataLoader(dataset, batch_size=loader_batch, shuffle=split == 'train',
+                                 num_workers=config['num_workers'], collate_fn=collate, pin_memory=True,
+                                 persistent_workers=config['num_workers'] > 0)
+               for split, dataset in datasets.items()}
+    planned_updates = config['planned_updates'] if args.test_only else config['epochs'] * len(loaders['train'])
+    warmup_updates = config['kl_warmup_updates'] if args.test_only else max(1, math.ceil(config['kl_warmup_fraction'] * planned_updates))
+    config['planned_updates'], config['kl_warmup_updates'] = planned_updates, warmup_updates
+    if not args.test_only:
+        (output_dir / 'config.yaml').write_text(yaml.safe_dump(config, sort_keys=False))
+    save_json(output_dir / 'model_inventory.json', {
+        'parameters': sum(p.numel() for p in model.parameters()),
+        'trainable_parameters': sum(p.numel() for p in model.parameters() if p.requires_grad),
+        'fin_trainable': model.fin_entities.weight.requires_grad and model.fin_relations.weight.requires_grad,
+        'fin_entity_table': list(model.fin_entities.weight.shape), 'fin_relation_table': list(model.fin_relations.weight.shape),
+        'classes': 85, 'latent': 128, 'pair_input': 514 if config['with_path'] else 256,
+        'path_depth': config['path_depth'] if config['with_path'] else 0,
+        'topology_cache': str(prepared), 'learned_state_cache': False})
+    best_metric, bad_epochs, update, start_epoch = -1., 0, 0, 1
+    if args.resume:
+        saved = torch.load(output_dir / 'last.pt', map_location=device, weights_only=False)
+        # Resume the exact optimization schedule, not a new warmup.
+        assert saved['config'] == config
+        model.load_state_dict(saved['model'])
+        optimizer.load_state_dict(saved['optimizer'])
+        restore_rng(saved['rng'])
+        best_metric, bad_epochs, update = saved['best_metric'], saved['bad_epochs'], saved['update']
+        start_epoch = saved['epoch'] + 1
+    elif not args.test_only and (output_dir / 'last.pt').exists():
+        raise ValueError('Existing training output: use --resume or a new output directory')
+    if not args.test_only:
+        for epoch in range(start_epoch, config['epochs'] + 1):
+            started = time.time()
+            model.train()
+            totals = {name: 0. for name in ['ce', 'rec', 'kl', 'loss', 'kl_weighted']}
+            count = 0
+            for raw in loaders['train']:
+                batch = to_device(raw, device)
+                optimizer.zero_grad(set_to_none=True)
+                result = model(batch)
+                ce = F.cross_entropy(result['logits'], batch['label'])
+                beta = config['kl_weight'] * min(1., (update + 1) / warmup_updates)
+                loss = ce + config['reconstruction_weight'] * result['rec'] + beta * result['kl']
+                loss.backward()
+                # Capture actual full-training first-step gradient norms for
+                # coordinator auditing, without a separate probe experiment.
+                if update == 0:
+                    groups = {'cse': model.cse, 'nai': model.nai, 'pvr': model.pvr,
+                              'classifier': model.classifier, 'fin_entities': model.fin_entities,
+                              'fin_relations': model.fin_relations}
+                    if config['with_path']:
+                        groups['path'] = model.path
+                    save_json(output_dir / 'first_update_gradients.json', {
+                        name: float(torch.stack([p.grad.detach().square().sum() for p in module.parameters()
+                                                 if p.grad is not None]).sum().sqrt()) for name, module in groups.items()})
+                optimizer.step()
+                n = len(batch['label'])
+                for name, value in [('ce', ce), ('rec', result['rec']), ('kl', result['kl']),
+                                    ('loss', loss), ('kl_weighted', beta * result['kl'])]:
+                    totals[name] += float(value.detach()) * n
+                count += n
+                update += 1
+            train = {k: v / count for k, v in totals.items()}
+            train['kl_beta_final'] = beta
+            val, _, _, _, _ = evaluate(model, loaders['val'], device, config, beta)
+            improved = val['macro_f1_85'] > best_metric
+            if improved:
+                best_metric, bad_epochs = val['macro_f1_85'], 0
+            else:
+                bad_epochs += 1
+            record = {'epoch': epoch, 'update': update, 'train': train, 'validation': val,
+                      'best_validation_macro_f1_85': best_metric, 'improved': improved,
+                      'bad_epochs': bad_epochs, 'seconds': time.time() - started}
+            with (output_dir / 'history.jsonl').open('a') as stream:
+                stream.write(json.dumps(record, allow_nan=False) + '\n')
+            print(json.dumps(record, allow_nan=False), flush=True)
+            checkpoint = {'epoch': epoch, 'update': update, 'model': model.state_dict(),
+                          'optimizer': optimizer.state_dict(), 'config': config, 'best_metric': best_metric,
+                          'bad_epochs': bad_epochs, 'metrics': record, 'rng': rng_state()}
+            torch.save(checkpoint, output_dir / 'last.pt')
+            if improved:
+                torch.save(checkpoint, output_dir / 'best.pt')
+            if bad_epochs >= config['patience']:
+                break
+    # Test is constructed and read by the training process only after validation
+    # selection has finished. Preprocessing used its endpoints, never labels.
+    best = torch.load(output_dir / 'best.pt', map_location=device, weights_only=False)
+    model.load_state_dict(best['model'])
+    test_data = DDIDataset(prepared, config['protocol'], 'test')
+    test_loader = DataLoader(test_data, batch_size=loader_batch, shuffle=False,
+                             num_workers=config['num_workers'], collate_fn=collate, pin_memory=True)
+    export_test(model, test_data, test_loader, device, config, output_dir, best)
+    (output_dir / 'test_config.yaml').write_text(yaml.safe_dump(
+        {**best['config'], 'evaluation_batch_size': loader_batch, 'evaluation_checkpoint': 'best.pt'}, sort_keys=False))
+
+
+if __name__ == '__main__':
+    main()
