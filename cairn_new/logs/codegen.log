"""no_gene_embeddings_six_relations: NAI neighbourhood views with the six RareDDIE Compound-Gene relations.

Authored by Claude Opus5.5 (claude-opus-5-5), 2026-10-11; see docs/no_gene_embeddings_six_relations_plan.md.
The ONLY scientific change relative to no_gene_embeddings/<arm> is the bundle's NAI neighbour arrays
target_fin_idx / target_relation_idx. Per catalog drug the new neighbour list is
  1. every baseline valid slot (FIN entity >= 0 and relation >= 0), unchanged and in its original order
     (DRUGBANK::target, with the baseline human-Entrez preference / FIN-only handling already applied), then
  2. the real DRKG edges of the five other relations of RareDDIE dataset1/dti_rel.csv
     (DRUGBANK::carrier/enzyme, Hetionet::CbG/CdG/CuG), Compound endpoint mapped through every DrugBank alias of
     the existing drugbank_to_drug bridge, Gene endpoint kept as its real FIN entity index, relation kept as its
     real DRKG relation index; exact per-drug (entity, relation) duplicates removed, sorted by (relation, entity).
No truncation: the padded width is the actual maximum neighbour count; padding -1. target_gene_idx is all -1 at
the same width (this family has no gene embeddings). All other bundle fields are the baseline objects unchanged.
Writes (refuses existing paths):
  data/experiments/no_gene_embeddings_six_relations/shared/{bundle.pt, neighbours.parquet}
  data/experiments/no_gene_embeddings_six_relations/<arm>/  symlinks to every baseline no_gene_embeddings/<arm>
      file (resolved) except bundle.pt / the old view json, bundle.pt -> ../shared/bundle.pt, and a view json
  configs/experiments/no_gene_embeddings_six_relations/<arm>.yaml  (baseline config; paths/family only)
  outputs/no_gene_embeddings_six_relations_coverage.{json,md}
"""
import json
import os
from pathlib import Path

import numpy as np
import pandas as pd
import torch
import yaml

ROOT = Path(__file__).resolve().parents[1]
FAMILY = "no_gene_embeddings_six_relations"
BASELINE = "no_gene_embeddings"
ARMS = ("single_drugout", "double_drugout")
SOURCE_BUNDLE = ROOT / "data/processed/bundle.pt"  # what both baseline arm views link to
BRIDGE = Path("/data/interns/zhangpc/cairn_v2/data/processed/drugbank_to_drug.parquet")  # as cairn/prepare.py
DTI_REL = ROOT / ("references/RareDDIE_source/RareDDIE-f658cae053af1e93eecc88ad77dc3af2e33cf527/"
                  "RareDDIE/dataset1/dti_rel.csv")
TARGET = "DRUGBANK::target::Compound:Gene"
REPLACED = ("target_fin_idx", "target_relation_idx", "target_gene_idx")
DATA = ROOT / "data/experiments" / FAMILY
AUTHOR = "Claude Opus5.5 (claude-opus-5-5), 2026-10-11"


def log(message):
    print(f"{pd.Timestamp.now().isoformat(timespec='seconds')} {message}", flush=True)


def degree_summary(counts):
    counts = np.asarray(counts)
    nonzero = counts[counts > 0]
    if not len(nonzero):
        return {"drugs": int(len(counts)), "with_neighbours": 0}
    return {"drugs": int(len(counts)), "with_neighbours": int(len(nonzero)),
            "median": float(np.median(nonzero)), "p95": float(np.percentile(nonzero, 95)), "max": int(nonzero.max())}


def flat(config, prefix=""):
    items = {}
    for key, value in config.items():
        items.update(flat(value, f"{prefix}{key}.") if isinstance(value, dict) else {f"{prefix}{key}": value})
    return items


def compare_bundle_field(old, new):
    if torch.is_tensor(old):  # kpgt_features keeps NaN rows for the drugs without KPGT
        return torch.equal(old, new) if not old.is_floating_point() else torch.allclose(old, new, rtol=0, atol=0, equal_nan=True)
    if isinstance(old, list) and old and hasattr(old[0], "keys"):  # PyG molecular graphs
        return len(old) == len(new) and all(
            a.keys() == b.keys() and all(torch.equal(a[k], b[k]) for k in a.keys()) for a, b in zip(old, new))
    return old == new


def main():
    six = pd.read_csv(DTI_REL, header=None).iloc[:, 0].tolist()
    drkg = torch.load(ROOT / "data/processed/drkg_triples.pt", map_location="cpu", weights_only=False)
    entities = np.asarray(drkg["entities"], dtype=object)
    relation_id = {name: drkg["relations"].index(name) for name in six}
    log(f"six relations from {DTI_REL.name}: {relation_id}")

    # --- Real DRKG edges of the six relations, typed Compound/Gene endpoints in either orientation.
    triples = drkg["triples"].numpy()
    triples = triples[np.isin(triples[:, 1], list(relation_id.values()))]
    head, tail = entities[triples[:, 0]], entities[triples[:, 2]]
    head_compound = np.char.startswith(head.astype(str), "Compound::")
    tail_compound = np.char.startswith(tail.astype(str), "Compound::")
    head_gene = np.char.startswith(head.astype(str), "Gene::")
    tail_gene = np.char.startswith(tail.astype(str), "Gene::")
    forward, reverse = head_compound & tail_gene, head_gene & tail_compound
    edges = pd.DataFrame({
        "compound": np.where(forward, head, tail), "fin_idx": np.where(forward, triples[:, 2], triples[:, 0]),
        "relation_idx": triples[:, 1], "orientation": np.where(forward, "Compound->Gene", "Gene->Compound")})
    edges = edges[forward | reverse]
    orientation = {name: edges[edges.relation_idx == rid].orientation.value_counts().to_dict()
                   for name, rid in relation_id.items()}
    untyped = int((~(forward | reverse)).sum())

    # --- Alias policy: every DrugBank ID of the existing bridge that maps to a catalog drug.
    bundle = torch.load(SOURCE_BUNDLE, map_location="cpu", weights_only=False)
    drug_index = {drug: i for i, drug in enumerate(bundle["drug_ids"])}
    full_bridge = pd.read_parquet(BRIDGE)
    bridge = full_bridge[full_bridge.drug_id.isin(drug_index)]
    db_to_index = {db: drug_index[drug] for db, drug in zip(bridge.drugbank_id, bridge.drug_id)}
    edges["drugbank_id"] = edges.compound.str.removeprefix("Compound::")
    edges["drug"] = edges.drugbank_id.map(db_to_index)
    unmapped_edges = edges[edges.drug.isna()]
    edges = edges.dropna(subset=["drug"]).astype({"drug": np.int64})
    log(f"{len(edges) + len(unmapped_edges)} six-relation edges, {len(edges)} on catalog drugs via the bridge")

    # --- Baseline valid slots, original order (all DRUGBANK::target in the current bundle).
    old_fin, old_rel = bundle["target_fin_idx"].numpy(), bundle["target_relation_idx"].numpy()
    old_valid = (old_fin >= 0) & (old_rel >= 0)
    rows, slots = np.nonzero(old_valid)
    baseline = pd.DataFrame({"drug": rows, "slot": slots, "fin_idx": old_fin[rows, slots],
                             "relation_idx": old_rel[rows, slots], "origin": "baseline_slot"})
    baseline_relations = sorted(drkg["relations"][r] for r in baseline.relation_idx.unique())
    target_id = relation_id[TARGET]
    drkg_target = edges[edges.relation_idx == target_id].drop_duplicates(["drug", "fin_idx", "relation_idx"])
    in_baseline = drkg_target.merge(baseline, on=["drug", "fin_idx", "relation_idx"], how="left",
                                    indicator=True)._merge.eq("both")

    # --- Five additional relations appended after the baseline slots.
    extra = edges[edges.relation_idx != target_id].drop_duplicates(["drug", "fin_idx", "relation_idx"])
    extra = extra.merge(baseline[["drug", "fin_idx", "relation_idx"]], how="left", indicator=True)
    extra_overlapping_baseline = int((extra._merge == "both").sum())
    extra = extra[extra._merge == "left_only"].sort_values(["drug", "relation_idx", "fin_idx"], kind="stable")
    extra = extra.assign(origin="drkg_" + extra.relation_idx.map({v: k for k, v in relation_id.items()}))
    neighbours = pd.concat([baseline.sort_values(["drug", "slot"]).drop(columns="slot"),
                            extra[["drug", "fin_idx", "relation_idx", "origin"]]], ignore_index=True)
    neighbours = neighbours.sort_values("drug", kind="stable").reset_index(drop=True)
    neighbours["slot"] = neighbours.groupby("drug").cumcount()
    width = int(neighbours.slot.max()) + 1
    log(f"{len(neighbours)} neighbour slots ({len(baseline)} baseline + {len(extra)} added), padded width {width}")

    shape = (len(bundle["drug_ids"]), width)
    new_fin = np.full(shape, -1, dtype=np.int64)
    new_rel = np.full(shape, -1, dtype=np.int64)
    new_fin[neighbours.drug, neighbours.slot] = neighbours.fin_idx
    new_rel[neighbours.drug, neighbours.slot] = neighbours.relation_idx
    old_count, new_count = old_valid.sum(1), (new_fin >= 0).sum(1)
    # Baseline slots are the first entries of each drug's list, unchanged and in order.
    prefix = all(np.array_equal(new_fin[d, :old_count[d]], old_fin[d][old_valid[d]]) and
                 np.array_equal(new_rel[d, :old_count[d]], old_rel[d][old_valid[d]]) for d in np.nonzero(old_count)[0])
    neighbour_entities = entities[np.unique(neighbours.fin_idx)].astype(str)

    DATA.mkdir(parents=True, exist_ok=False)
    (DATA / "shared").mkdir()
    neighbours.assign(drug_id=np.asarray(bundle["drug_ids"], dtype=object)[neighbours.drug],
                      fin_entity=entities[neighbours.fin_idx],
                      relation=[drkg["relations"][r] for r in neighbours.relation_idx]
                      ).to_parquet(DATA / "shared/neighbours.parquet", index=False)
    source = {key: bundle[key] for key in REPLACED}
    bundle["target_fin_idx"] = torch.from_numpy(new_fin)
    bundle["target_relation_idx"] = torch.from_numpy(new_rel)
    bundle["target_gene_idx"] = torch.full(shape, -1, dtype=torch.int64)
    log(f"writing {DATA / 'shared/bundle.pt'}")
    torch.save(bundle, DATA / "shared/bundle.pt")
    for key, value in source.items():
        bundle[key] = value
    reloaded = torch.load(DATA / "shared/bundle.pt", map_location="cpu", weights_only=False)
    preserved = {key: compare_bundle_field(bundle[key], reloaded[key]) for key in bundle if key not in REPLACED}
    log(f"other bundle fields preserved: {all(preserved.values())} ({len(preserved)} keys)")

    # --- Arm views and configs.
    arms = {}
    for arm in ARMS:
        old_view = ROOT / "data/experiments" / BASELINE / arm
        view = DATA / arm
        view.mkdir()
        linked = []
        for path in sorted(old_view.iterdir()):
            if path.name not in ("bundle.pt", f"{BASELINE}_view.json"):
                os.symlink(path.resolve(), view / path.name)
                linked.append(path.name)
        os.symlink("../shared/bundle.pt", view / "bundle.pt")
        config = yaml.safe_load((ROOT / "configs/experiments" / BASELINE / f"{arm}.yaml").read_text())
        config["processed"] = f"data/experiments/{FAMILY}/{arm}"
        config["outputs"] = f"outputs/experiments/{FAMILY}/{arm}"
        config["experiment"].update({
            "family": FAMILY,
            "meaning": "no_gene_embeddings with NAI neighbours from the six RareDDIE dti_rel Compound-Gene relations "
                       "(baseline DRUGBANK::target slots + carrier/enzyme/CbG/CdG/CuG DRKG edges); stage1 only",
            "baseline_config": f"configs/experiments/{BASELINE}/{arm}.yaml",
            "baseline_processed": f"data/experiments/{BASELINE}/{arm}",
            "stage2": "not run for this family",
            "launcher": "scripts/run_no_gene_six_relations.sh", "logs": f"logs/{FAMILY}/{arm}",
            "prepared_by": "scripts/prepare_no_gene_six_relations.py", "author": AUTHOR})
        path = ROOT / "configs/experiments" / FAMILY / f"{arm}.yaml"
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("x") as stream:
            yaml.safe_dump(config, stream, sort_keys=False)
        base_config = yaml.safe_load((ROOT / "configs/experiments" / BASELINE / f"{arm}.yaml").read_text())
        config_diff = sorted(key for key in set(flat(config)) | set(flat(base_config))
                             if flat(config).get(key) != flat(base_config).get(key))
        ddi = pd.read_parquet(view / "ddi.parquet")
        base_ddi = pd.read_parquet(old_view / "ddi.parquet")
        arms[arm] = {"view": str(view.relative_to(ROOT)), "linked_baseline_files": linked,
                     "config": str(path.relative_to(ROOT)), "config_keys_differing_from_baseline": config_diff,
                     "ddi_rows_split_order_labels_equal_baseline": bool(ddi.equals(base_ddi)),
                     "coverage": arm_coverage(ddi, old_count, new_count, bundle["drug_ids"])}
        (view / f"{FAMILY}_view.json").write_text(json.dumps(
            {"family": FAMILY, "arm": arm, "author": AUTHOR, "baseline_view": str(old_view.relative_to(ROOT)),
             "linked_baseline_files": linked, "bundle": "../shared/bundle.pt (target arrays replaced only)"},
            indent=2) + "\n")
        log(f"{arm}: view and config written")

    per_relation = {}
    for name, rid in relation_id.items():
        rel_edges = edges[edges.relation_idx == rid]
        per_relation[name] = {
            "relation_idx": rid, "drkg_edges": int((triples[:, 1] == rid).sum()), "orientation": orientation[name],
            "edges_on_catalog_drugs": int(len(rel_edges)),
            "distinct_drug_entity_pairs": int(len(rel_edges.drop_duplicates(["drug", "fin_idx"]))),
            "slots_in_new_arrays": int((new_rel == rid).sum()),
            "drugs_with_relation": int((new_rel == rid).any(1).sum())}
    report = {
        "family": FAMILY, "author": AUTHOR, "source_bundle": str(SOURCE_BUNDLE.relative_to(ROOT)),
        "six_relations_source": str(DTI_REL.relative_to(ROOT)), "relations": per_relation,
        "untyped_rows_excluded": untyped,
        "alias_policy": "Compound::DBxxxxx of every relation mapped through every DrugBank ID of the existing "
                        "drugbank_to_drug bridge whose drug is in the catalog (as cairn/prepare.py maps DRKG targets); "
                        "several aliases of one drug merge onto that drug; no new IDs",
        "aliases": {"bridge_drugbank_ids_on_catalog": int(len(bridge)),
                    "catalog_drugs_with_drugbank_alias": int(bridge.drug_id.nunique()),
                    "catalog_drugs_with_multiple_aliases": int((bridge.drug_id.value_counts() > 1).sum()),
                    "catalog_drugs_without_drugbank_alias": int(len(drug_index) - bridge.drug_id.nunique()),
                    "aliased_catalog_drugs_without_any_six_relation_edge":
                        int(len(set(bridge.drug_id.map(drug_index)) - set(edges.drug))),
                    "unmapped_compounds_with_six_relation_edges": int(unmapped_edges.drugbank_id.nunique()),
                    "unmapped_compounds_in_bridge_but_drug_not_in_catalog":
                        int(unmapped_edges.drugbank_id[unmapped_edges.drugbank_id.isin(full_bridge.drugbank_id)].nunique()),
                    "unmapped_edges": int(len(unmapped_edges)),
                    "unmapped_compound_examples": sorted(unmapped_edges.drugbank_id.unique())[:20]},
        "baseline": {"valid_slots": int(old_valid.sum()), "width": int(old_fin.shape[1]),
                     "relations": baseline_relations,
                     "valid_slots_retained": int(len(baseline)), "retained_as_ordered_prefix": bool(prefix),
                     "drkg_target_edges_on_catalog_drugs": int(len(drkg_target)),
                     "drkg_target_edges_already_baseline_slots": int(in_baseline.sum()),
                     "drkg_target_edges_not_in_baseline_not_added": int((~in_baseline).sum())},
        "added": {"slots": int(len(extra)), "extra_edges_identical_to_a_baseline_slot": extra_overlapping_baseline,
                  "per_relation": extra.origin.value_counts().to_dict()},
