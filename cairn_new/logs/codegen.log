"""Real task datasets and explicit-ID batch construction."""
from __future__ import annotations

import json
import math
import random
from pathlib import Path

import numpy as np
import pandas as pd
import torch
from torch.utils.data import Dataset, Sampler
from torch_geometric.data import Batch, Data


def load_bundle(processed: Path) -> dict:
    bundle = torch.load(processed / "bundle.pt", map_location="cpu", weights_only=False)
    fin = torch.load(processed / "fin.pt", map_location="cpu", weights_only=False)
    bundle["fin_entities"] = fin["entities"]
    bundle["fin_relations"] = fin["relations"]
    return bundle


class DDIDataset(Dataset):
    def __init__(self, processed: Path, split: str):
        frame = pd.read_parquet(processed / "ddi.parquet")
        frame = frame.loc[frame.split == split].reset_index(drop=True)
        self.drug_a = frame.drug_a.to_numpy(dtype=np.int64)
        self.drug_b = frame.drug_b.to_numpy(dtype=np.int64)
        self.labels = frame.event_id.to_numpy(dtype=np.int64)

    def __len__(self):
        return len(self.labels)

    def __getitem__(self, index):
        return {"drug_a": int(self.drug_a[index]), "drug_b": int(self.drug_b[index]),
                "label": int(self.labels[index]), "row_index": index}


class SynergyDataset(Dataset):
    def __init__(self, processed: Path, split: str):
        frame = pd.read_parquet(processed / "synergy.parquet")
        self.frame = frame.loc[frame.split == split].reset_index(drop=True)
        expression = np.load(processed / "cell_expression.npz", allow_pickle=False)
        cell_rows = {str(cell): i for i, cell in enumerate(expression["cells"])}
        self.expression = expression["values"].astype(np.float32, copy=False)
        self.cell_rows = np.asarray([cell_rows[str(cell)] for cell in self.frame.cell_id], dtype=np.int64)
        self.drug_a = self.frame.drug_a.to_numpy(dtype=np.int64)
        self.drug_b = self.frame.drug_b.to_numpy(dtype=np.int64)
        self.scores = self.frame.score.to_numpy(dtype=np.float32)
        self.normalization = json.loads((processed / "synergy_normalization.json").read_text())

    def __len__(self):
        return len(self.frame)

    def __getitem__(self, index):
        score = self.scores[index]
        return {"drug_a": int(self.drug_a[index]), "drug_b": int(self.drug_b[index]),
                "cell_expr": self.expression[self.cell_rows[index]],
                "target": (float(score) - self.normalization["mean"]) / self.normalization["std"],
                "score_original": float(score), "row_index": index}


class AuxiliaryDataset(Dataset):
    def __init__(self, processed: Path, task: str, split: str, dose_time_free: bool = False):
        archive = np.load(processed / f"{task}.npz", allow_pickle=False)
        rows = np.flatnonzero(archive["split"].astype(str) == split)
        names = ("drug", "cell_expr", "dose", "time_h", "delta", "mask") if task == "lincs" else ("cell_expr", "target", "mask")
        if task == "lincs" and dose_time_free:
            # DT_free batches carry no dose/time; its archive has no such fields.
            names = ("drug", "cell_expr", "delta", "mask")
        self.arrays = {name: archive[name][rows] for name in names}
        if task == "lincs":
            self.arrays["target"] = self.arrays.pop("delta")
        self.size = len(rows)

