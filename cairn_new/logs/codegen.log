def random_splits(groups, seed=42):
    groups = sorted(set(groups))
    order = np.random.default_rng(seed).permutation(len(groups))
    ntrain = int(len(groups) * .8)
    nval = int(len(groups) * .1)
    result = {}
    for name, indices in [("train", order[:ntrain]), ("val", order[ntrain:ntrain+nval]), ("test", order[ntrain+nval:])]:
        result.update((groups[int(i)], name) for i in indices)
    return result


def prepare_drkg():
    OUT.mkdir(parents=True, exist_ok=True)
    dest = RAW / "drkg"
    with tarfile.open(dest / "drkg.tar.gz", "r:gz") as archive:
        for name in ["drkg.tsv", "relation_glossary.tsv", "entity2src.tsv"]:
            with archive.extractfile(name) as inp, open(dest / name, "wb") as out:
                shutil.copyfileobj(inp, out)
    entities, relations = [], []
    entity_idx, relation_idx = {}, {}
    parts, targets = [], []
    removed = Counter()
    nsource = 0
    for frame in pd.read_csv(dest / "drkg.tsv", sep="\t", names=["head", "relation", "tail"], dtype=str, chunksize=250000):
        nsource += len(frame)
        both_compound = frame["head"].str.startswith("Compound::") & frame["tail"].str.startswith("Compound::")
        removed.update(frame.loc[both_compound, "relation"].value_counts().to_dict())
        frame = frame.loc[~both_compound].copy()
        for value in pd.concat([frame["head"], frame["tail"]]).unique():
            if value not in entity_idx:
                entity_idx[value] = len(entities)
                entities.append(value)
        for value in frame["relation"].unique():
            if value not in relation_idx:
                relation_idx[value] = len(relations)
                relations.append(value)
        parts.append(np.column_stack([frame["head"].map(entity_idx), frame["relation"].map(relation_idx), frame["tail"].map(entity_idx)]).astype(np.int64))
        direct_target = frame["relation"].str.startswith("DRUGBANK::target::")
        for row in frame.loc[direct_target].itertuples(index=False):
            if row.head.startswith("Compound::") and row.tail.startswith("Gene::"):
                targets.append((row.head.removeprefix("Compound::"), row.tail.removeprefix("Gene::"), entity_idx[row.tail], relation_idx[row.relation], row.relation))
            elif row.tail.startswith("Compound::") and row.head.startswith("Gene::"):
                targets.append((row.tail.removeprefix("Compound::"), row.head.removeprefix("Gene::"), entity_idx[row.head], relation_idx[row.relation], row.relation))
        print(f"DRKG read {nsource:,} rows; removed {sum(removed.values()):,} compound-compound", flush=True)
    triples = torch.from_numpy(np.concatenate(parts))
    torch.save({"triples": triples, "entities": entities, "relations": relations}, OUT / "drkg_triples.pt")
    pd.DataFrame({"entity_idx": range(len(entities)), "entity": entities}).to_csv(OUT / "drkg_entities.csv", index=False)
    pd.DataFrame({"relation_idx": range(len(relations)), "relation": relations}).to_csv(OUT / "drkg_relations.csv", index=False)
    pd.DataFrame(targets, columns=["drugbank_id", "gene_id", "fin_idx", "relation_idx", "relation"]).drop_duplicates().to_parquet(OUT / "drkg_target_annotations.parquet", index=False)
    report("drkg", source_rows=nsource, retained_rows=len(triples), entities=len(entities), relations=len(relations), removed_compound_compound_rows=sum(removed.values()), removed_relation_families=dict(removed), direct_drugbank_target_rows=len(targets), published_embeddings_used=False)


