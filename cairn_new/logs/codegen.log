@@ -0,0 +1,20 @@
+protocol: double_drugout
+with_path: false
+gpu: 7
+prepared: data/prepared
+output: outputs/no_path_double_drugout
+seed: 42
+epochs: 100
+patience: 15
+batch_size: 128
+learning_rate: 0.0001
+weight_decay: 0.0001
