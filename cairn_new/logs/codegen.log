@@ -0,0 +1,79 @@
+"""Frozen-row datasets; raw molecules and packed label-free pair subgraphs."""
+from pathlib import Path
+import numpy as np
+import pandas as pd
+import torch
+from torch.utils.data import Dataset
+from torch_geometric.data import Batch
+
+
+class DDIDataset(Dataset):
+    def __init__(self, prepared, protocol, split):
+        directory = Path(prepared) / protocol
+        frame = pd.read_parquet(directory / 'ddi.parquet')
+        rows = np.flatnonzero(frame.split.eq(split).to_numpy())
+        self.frame = frame.iloc[rows].copy()
+        self.rows = rows
+        self.pair_ids = np.load(directory / 'pair_indices.npy')[rows]
+        self.a = self.frame.drug_a.to_numpy(np.int64)
+        self.b = self.frame.drug_b.to_numpy(np.int64)
+        self.y = self.frame.event_id.to_numpy(np.int64)
+
+    def __len__(self):
+        return len(self.rows)
+
+    def __getitem__(self, i):
+        return int(self.a[i]), int(self.b[i]), int(self.y[i]), int(self.rows[i]), int(self.pair_ids[i])
+
+
+class Collator:
+    def __init__(self, assets, prepared, with_path):
+        self.graphs, self.with_path = assets['graphs'], with_path
+        if with_path:
+            self.paths = {name: np.load(Path(prepared) / f'{name}.npy', mmap_mode='r')
+                          for name in ['nodes', 'edges', 'node_ptr', 'edge_ptr', 'endpoints', 'path_mask']}
+
+    def __call__(self, rows):
+        a, b, y, original_rows, pairs = zip(*rows)
+        ga = [self.graphs[i] for i in a]
+        gb = [self.graphs[i] for i in b]
+        cross = []
+        for h, t in zip(ga, gb):
+            # np.meshgrid(x1,x2) ordering in original DSN preprocessing.
+            hi, ti = torch.meshgrid(torch.arange(h.num_nodes), torch.arange(t.num_nodes), indexing='xy')
+            cross.append(torch.stack([hi.flatten(), ti.flatten()]))
+        result = {'graph_a': Batch.from_data_list(ga), 'graph_b': Batch.from_data_list(gb),
+                  'cross_edges': cross, 'drug_a': torch.tensor(a), 'drug_b': torch.tensor(b),
+                  'label': torch.tensor(y), 'row_index': torch.tensor(original_rows)}
+        if self.with_path:
+            edge_rows, edge_pairs, head_nodes, tail_nodes, masks = [], [], [], [], []
+            offset = 0
+            for batch_idx, pair_id in enumerate(pairs):
+                start, end = self.paths['edge_ptr'][pair_id:pair_id + 2]
+                edges = np.array(self.paths['edges'][start:end], dtype=np.int64)
+                edges[:, :2] += offset
+                edge_rows.append(edges)
+                edge_pairs.append(np.full(len(edges), batch_idx, np.int64))
+                endpoints = self.paths['endpoints'][pair_id] + offset
+                head_nodes.append(int(endpoints[0]))
+                tail_nodes.append(int(endpoints[1]))
+                masks.append(bool(self.paths['path_mask'][pair_id]))
+                ns, ne = self.paths['node_ptr'][pair_id:pair_id + 2]
+                offset += int(ne - ns)
+            edges = torch.from_numpy(np.concatenate(edge_rows))
+            result['path_graph'] = {'edge_index': edges[:, :2].T.contiguous(), 'relations': edges[:, 2],
+                                    'multiplicity': edges[:, 3].float(),
+                                    'edge_pair': torch.from_numpy(np.concatenate(edge_pairs)),
+                                    'head_nodes': torch.tensor(head_nodes), 'tail_nodes': torch.tensor(tail_nodes),
+                                    'path_mask': torch.tensor(masks), 'n_nodes': offset}
+        return result
+
+
+def to_device(value, device):
+    if isinstance(value, dict):
+        return {k: to_device(v, device) for k, v in value.items()}
+    if isinstance(value, list):
+        return [to_device(v, device) for v in value]
+    if hasattr(value, 'to'):
+        return value.to(device, non_blocking=True)
+    return value
diff --git a/cairn_dsn/metrics.py b/cairn_dsn/metrics.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d853ce467c0cfebbad5ddab1303918e3edfd025
--- /dev/null
+++ b/cairn_dsn/metrics.py
@@ -0,0 +1,40 @@
+"""All classification averages specify the frozen 85-class universe."""
+import numpy as np
+import pandas as pd
+from sklearn.metrics import (accuracy_score, average_precision_score, cohen_kappa_score,
+                             confusion_matrix, f1_score, matthews_corrcoef,
+                             precision_recall_fscore_support, roc_auc_score)
+
+LABELS = np.arange(85)
+
+
+def classification_metrics(y, probabilities):
+    prediction = probabilities.argmax(1)
+    precision, recall, f1, support = precision_recall_fscore_support(
+        y, prediction, labels=LABELS, zero_division=0)
+    records = []
+    for label in LABELS:
+        truth = y == label
+        auc = float(roc_auc_score(truth, probabilities[:, label])) if truth.any() and not truth.all() else None
+        ap = float(average_precision_score(truth, probabilities[:, label])) if truth.any() else None
+        records.append({'event_id': int(label), 'precision': float(precision[label]),
+                        'recall': float(recall[label]), 'f1': float(f1[label]), 'support': int(support[label]),
+                        'predicted': int((prediction == label).sum()), 'roc_auc_ovr': auc, 'average_precision_ovr': ap})
+    aucs = [r['roc_auc_ovr'] for r in records if r['roc_auc_ovr'] is not None]
+    aps = [r['average_precision_ovr'] for r in records if r['average_precision_ovr'] is not None]
+    metrics = {'rows': len(y), 'accuracy': float(accuracy_score(y, prediction)),
+               'macro_f1_85': float(f1.mean()), 'macro_precision_85': float(precision.mean()),
+               'macro_recall_85': float(recall.mean()),
+               'weighted_f1': float(f1_score(y, prediction, labels=LABELS, average='weighted', zero_division=0)),
+               'micro_f1': float(f1_score(y, prediction, labels=LABELS, average='micro', zero_division=0)),
+               'mcc': float(matthews_corrcoef(y, prediction)), 'kappa': float(cohen_kappa_score(y, prediction, labels=LABELS)),
+               'classes_present': int((support > 0).sum()),
+               'macro_roc_auc_supported_classes': float(np.mean(aucs)) if aucs else None,
+               'roc_auc_classes': len(aucs),
+               'macro_ap_supported_classes': float(np.mean(aps)) if aps else None,
+               'ap_classes': len(aps)}
+    return metrics, pd.DataFrame(records), confusion_matrix(y, prediction, labels=LABELS)
+
+
+def validation_selection_metric(y, probabilities):
+    return float(f1_score(y, probabilities.argmax(1), labels=LABELS, average='macro', zero_division=0))
diff --git a/cairn_dsn/model.py b/cairn_dsn/model.py
new file mode 100644
index 0000000000000000000000000000000000000000..0b5c7b6ea1fa14b7679d631aa514e75c03923d0b
--- /dev/null
+++ b/cairn_dsn/model.py
@@ -0,0 +1,249 @@
+"""Original bond-aware RareDDIE order with the exact DSN inter-graph layer.
+
+All pair-conditioned states are freshly computed with gradients. The optional
+path branch ports EmerGNN's multiplicative sum propagation and shared ordered
+pair gates; only real cached topology, never learned states, is reused.
+"""
+from types import SimpleNamespace
+import torch
+from torch import nn
+import torch.nn.functional as F
+from torch_geometric.nn import TransformerConv, SAGPooling, LayerNorm, Linear, global_add_pool, GATConv
+
+
+class InterGraphAttention(nn.Module):
+    # Exact original class, references/DSN-DDI/drugbank_test/layers.py.
+    def __init__(self, input_dim):
+        super().__init__()
+        self.input_dim = input_dim
+        self.inter = GATConv((input_dim, input_dim), 32, 2)
+
+    def forward(self, h_data, t_data, b_graph):
+        edge_index = b_graph.edge_index
+        h_input = F.elu(h_data.x)
+        t_input = F.elu(t_data.x)
+        t_rep = self.inter((h_input, t_input), edge_index)
+        h_rep = self.inter((t_input, h_input), edge_index[[1, 0]])
+        return h_rep, t_rep
+
+
+class CSEBlock(nn.Module):
+    def __init__(self):
+        super().__init__()
+        # RareDDIE MVN_DDI_Block: two 2x64 TransformerConvs, bond64.
+        self.feature_conv = TransformerConv(128, 64, 2, edge_dim=64, dropout=0.)
+        self.lin_up = Linear(64, 64, bias=True, weight_initializer='glorot')
+        self.feature_conv2 = TransformerConv(128, 64, 2, edge_dim=64, dropout=0.)
+        self.lin_up2 = Linear(64, 64, bias=True, weight_initializer='glorot')
+        self.readout = SAGPooling(128, min_score=-1)
+        self.norm = LayerNorm(128)
+        self.norm2 = LayerNorm(128)
+        self.re_shape_e = Linear(64, 128, bias=True, weight_initializer='glorot')
+        # PyG2.0.4 upstream SAGPooling has no extra select scalar.
+        self.readout.select.weight.data.fill_(1.)
+        self.readout.select.weight.requires_grad_(False)
+        self.interAtt = InterGraphAttention(128)
+        self.inter_projection = Linear(192, 128, bias=True, weight_initializer='glorot')
+
+    def inter_pair_batch(self, h, t, cross_edges):
+        # Invoke the UNCHANGED layer separately per molecule pair. Default GAT
+        # self loops on ragged bipartite batches otherwise connect distinct pairs.
+        hs, ts = h.ptr.tolist(), t.ptr.tolist()
+        h_out, t_out = [], []
+        for i, edges in enumerate(cross_edges):
+            hi, ti = h.x[hs[i]:hs[i + 1]], t.x[ts[i]:ts[i + 1]]
+            ho, to = self.interAtt(SimpleNamespace(x=hi), SimpleNamespace(x=ti),
+                                   SimpleNamespace(edge_index=edges))
+            h_out.append(ho)
+            t_out.append(to)
+        return torch.cat(h_out), torch.cat(t_out)
+
+    def forward(self, h, t, cross_edges):
+        # Original ne_update order.
+        h.x = self.feature_conv(h.x, h.edge_index, h.edge_attr)
+        t.x = self.feature_conv(t.x, t.edge_index, t.edge_attr)
+        h.x = F.elu(self.norm(h.x, h.batch))
+        t.x = F.elu(self.norm(t.x, t.batch))
+        h.edge_attr = self.lin_up(h.edge_attr)
+        t.edge_attr = self.lin_up(t.edge_attr)
+        h.edge_attr = F.elu(h.edge_attr)
+        t.edge_attr = F.elu(t.edge_attr)
+        # Original second convolution and bond update before GlobalPool.
+        h.x = self.feature_conv2(h.x, h.edge_index, h.edge_attr)
+        t.x = self.feature_conv2(t.x, t.edge_index, t.edge_attr)
+        h.edge_attr = self.lin_up2(h.edge_attr)
+        t.edge_attr = self.lin_up2(t.edge_attr)
+        hi, ti = self.inter_pair_batch(h, t, cross_edges)
+        h.x = self.inter_projection(torch.cat([h.x, hi], dim=-1))
+        t.x = self.inter_projection(torch.cat([t.x, ti], dim=-1))
+        h_atoms, _, _, h_batch, _, _ = self.readout(h.x, h.edge_index, edge_attr=h.edge_attr, batch=h.batch)
+        t_atoms, _, _, t_batch, _, _ = self.readout(t.x, t.edge_index, edge_attr=t.edge_attr, batch=t.batch)
+        h_pool = global_add_pool(h_atoms, h_batch, size=h.num_graphs)
+        t_pool = global_add_pool(t_atoms, t_batch, size=t.num_graphs)
+        h_bond = global_add_pool(h.edge_attr, h.batch[h.edge_index[0]], size=h.num_graphs)
+        t_bond = global_add_pool(t.edge_attr, t.batch[t.edge_index[0]], size=t.num_graphs)
+        h_bond = F.elu(self.re_shape_e(h_bond))
+        t_bond = F.elu(self.re_shape_e(t_bond))
+        h_pool, t_pool = h_pool * h_bond, t_pool * t_bond
+        h_pool = F.elu(F.normalize(h_pool, p=2, dim=1))
+        t_pool = F.elu(F.normalize(t_pool, p=2, dim=1))
+        h.x = F.elu(self.norm2(h.x, h.batch))
+        t.x = F.elu(self.norm2(t.x, t.batch))
+        h.edge_attr, t.edge_attr = F.elu(h.edge_attr), F.elu(t.edge_attr)
+        return h, t, h_pool, t_pool
+
+
+class CSE(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.initial_node_feature = Linear(55, 128, bias=True, weight_initializer='glorot')
+        self.initial_edge_feature = Linear(17, 64, bias=True, weight_initializer='glorot')
+        self.initial_node_norm = LayerNorm(128)
+        self.blocks = nn.ModuleList([CSEBlock(), CSEBlock()])
+
+    def forward(self, batch):
+        # clone keeps the immutable molecular cache unmodified; no deepcopy of
+        # learned features occurs anywhere after this point.
+        h, t = batch['graph_a'].clone(), batch['graph_b'].clone()
+        h.x = self.initial_node_feature(h.x)
+        t.x = self.initial_node_feature(t.x)
+        h.x = self.initial_node_norm(h.x, h.batch)
+        t.x = self.initial_node_norm(t.x, t.batch)
+        h.x, t.x = F.elu(h.x), F.elu(t.x)
+        h.edge_attr = self.initial_edge_feature(h.edge_attr)
+        t.edge_attr = self.initial_edge_feature(t.edge_attr)
+        h.edge_attr, t.edge_attr = F.elu(h.edge_attr), F.elu(t.edge_attr)
+        repr_h, repr_t = [], []
+        for block in self.blocks:
+            h, t, rh, rt = block(h, t, batch['cross_edges'])
+            repr_h.append(rh)
+            repr_t.append(rt)
+        return .6 * repr_h[0] + .4 * repr_h[-1], .6 * repr_t[0] + .4 * repr_t[-1]
+
+
+class NAI(nn.Module):
+    """RareDDIE neighbor_encoder with an explicit padding softmax mask."""
+    def __init__(self):
+        super().__init__()
+        self.gcn_w = nn.Linear(256, 128)
+        nn.init.xavier_normal_(self.gcn_w.weight)
+        self.dropout = nn.Dropout(.5)
+        self.Bilinear = nn.Bilinear(128, 128, 1, bias=False)
+        self.Linear_self = nn.Linear(128, 128, bias=False)
+        self.Linear_nei = nn.Linear(128, 128, bias=False)
+        self.Linear_weak_rel = nn.Linear(128, 128, bias=False)
+
+    def forward(self, entity, relation, valid, feature, weak_rel):
+        out = self.gcn_w(torch.cat([self.dropout(relation), self.dropout(entity)], -1))
+        guide = self.Linear_weak_rel(weak_rel[:, None].expand_as(out))
+        score = self.Bilinear(guide, out).squeeze(-1)
+        # All-empty rows produce zero neighbor context, no biased padding.
+        score = score.masked_fill(~valid, -torch.inf)
+        score = torch.where(valid.any(1, keepdim=True), score, torch.zeros_like(score))
+        attention = score.softmax(1) * valid.to(score.dtype)
+        context = torch.bmm(attention[:, None], out).squeeze(1)
+        return F.elu(self.Linear_nei(context) + self.Linear_self(feature))
+
+
+class EmerGNNPath(nn.Module):
+    def __init__(self, n_rel, depth=4):
+        super().__init__()
+        self.depth = depth
+        self.rel_kg = nn.ModuleList([nn.Embedding(2 * n_rel + 1, 128) for _ in range(depth)])
+        self.linear = nn.ModuleList([nn.Linear(128, 128) for _ in range(depth)])
+        # Original init_weight affects relation embeddings and layer projections
+        # before relation gate modules are constructed, leaving gate init default.
+        for module in [self.rel_kg, self.linear]:
+            for parameter in module.parameters():
+                if parameter.ndim > 1:
+                    nn.init.xavier_uniform_(parameter)
+        self.relation_linear = nn.ModuleList([nn.Linear(256, 5) for _ in range(depth)])
+        self.attn_relation = nn.ModuleList([nn.Linear(5, 2 * n_rel + 1) for _ in range(depth)])
+
+    def propagate(self, source, source_nodes, target_nodes, graph, gates):
+        n_nodes = int(graph['n_nodes'])
+        state = source.new_zeros(n_nodes, 128).index_copy(0, source_nodes, source)
+        reachable = torch.zeros(n_nodes, dtype=torch.bool, device=source.device)
+        reachable[source_nodes] = True
+        src, dst, rel = graph['edge_index'][0], graph['edge_index'][1], graph['relations']
+        edge_pair, multiplicity = graph['edge_pair'], graph['multiplicity']
+        for layer in range(self.depth):
+            # Exactly gated elementwise multiplication, SUM, linear, ReLU.
+            relation_input = gates[layer][edge_pair, rel, None] * self.rel_kg[layer](rel)
+            message = state[src] * relation_input * multiplicity[:, None]
+            aggregated = state.new_zeros(n_nodes, 128).index_add(0, dst, message)
+            reach_count = torch.zeros(n_nodes, dtype=torch.long, device=source.device)
+            reach_count.index_add_(0, dst, reachable[src].long())
+            reachable = reach_count > 0
+            # Original linear bias can create features at unreachable nodes.
+            # Apply it only after a real source-reachable edge delivered a state.
+            state = F.relu(self.linear[layer](aggregated)) * reachable[:, None]
+        present = reachable[target_nodes] & graph['path_mask']
+        return state[target_nodes] * present[:, None], present
+
+    def forward(self, head, tail, graph):
+        ordered_pair = torch.cat([head, tail], -1)
+        # Both directions use these SAME gates from the SAME ordered pair.
+        gates = [torch.sigmoid(attn(F.relu(proj(ordered_pair))))
+                 for proj, attn in zip(self.relation_linear, self.attn_relation)]
+        tail_hid, ht = self.propagate(head, graph['head_nodes'], graph['tail_nodes'], graph, gates)
+        head_hid, th = self.propagate(tail, graph['tail_nodes'], graph['head_nodes'], graph, gates)
+        # Original readout order: [head_hid (v->u), tail_hid (u->v)].
+        return torch.cat([head_hid, tail_hid], -1), torch.stack([th, ht], -1)
+
+
+class PairVAE(nn.Module):
+    def __init__(self, input_dim):
+        super().__init__()
+        self.encoder = nn.Sequential(nn.Linear(input_dim, 256), nn.GELU())
+        self.mu = nn.Linear(256, 128)
+        self.logvar = nn.Linear(256, 128)
+        self.decoder = nn.Sequential(nn.Linear(128, 256), nn.GELU(), nn.Linear(256, input_dim))
+
+    def forward(self, pair):
+        encoded = self.encoder(pair)
+        mu, logvar = self.mu(encoded), self.logvar(encoded)
+        z = mu + torch.exp(.5 * logvar) * torch.randn_like(mu)
+        reconstructed = self.decoder(z)
+        rec = F.mse_loss(reconstructed, pair.detach(), reduction='mean')
+        kl = -.5 * (1 + logvar - mu.square() - logvar.exp()).mean()
+        return mu, rec, kl
+
+
+class DSNRareDDI(nn.Module):
+    def __init__(self, assets, config):
+        super().__init__()
+        self.fin_entities = nn.Embedding.from_pretrained(assets['fin_entities'].clone(), freeze=False)
+        self.fin_relations = nn.Embedding.from_pretrained(assets['fin_relations'].clone(), freeze=False)
+        self.register_buffer('neighbor_entities', assets['neighbor_entities'])
+        self.register_buffer('neighbor_relations', assets['neighbor_relations'])
+        self.cse = CSE()
+        self.nai = NAI()
+        self.with_path = config['with_path']
+        if self.with_path:
+            self.path = EmerGNNPath(len(assets['fin_relation_ids']), config['path_depth'])
+        self.pvr = PairVAE(514 if self.with_path else 256)
+        self.classifier = nn.Sequential(nn.LayerNorm(128), nn.Linear(128, 256), nn.GELU(),
+                                        nn.Dropout(.2), nn.Linear(256, 85))
+
+    def neighbors(self, drugs):
+        entity, relation = self.neighbor_entities[drugs], self.neighbor_relations[drugs]
+        valid = (entity >= 0) & (relation >= 0)
+        mask = valid[:, :, None]
+        return self.fin_entities(entity.clamp_min(0)) * mask, self.fin_relations(relation.clamp_min(0)) * mask, valid
+
+    def forward(self, batch):
+        head, tail = self.cse(batch)
+        # Original uses the SAME right-minus-left guide on BOTH endpoints.
+        guide = tail - head
+        nai_h = self.nai(*self.neighbors(batch['drug_a']), head, guide)
+        nai_t = self.nai(*self.neighbors(batch['drug_b']), tail, guide)
+        pair = torch.cat([nai_h, nai_t], -1)
+        masks = torch.empty((len(head), 0), dtype=torch.bool, device=head.device)
+        if self.with_path:
+            # Original source is a projected molecular vector; adapt to the live
+            # DSN-conditioned CSE molecular vector, keeping source-only init.
+            path, masks = self.path(head, tail, batch['path_graph'])
+            pair = torch.cat([pair, path, masks.to(pair.dtype)], -1)
+        mu, rec, kl = self.pvr(pair)
+        return {'logits': self.classifier(mu), 'rec': rec, 'kl': kl, 'path_mask': masks}
diff --git a/cairn_dsn/paths.py b/cairn_dsn/paths.py
new file mode 100644
index 0000000000000000000000000000000000000000..5f13aa16c73304072d0643d092bbd191f2b19811
--- /dev/null
+++ b/cairn_dsn/paths.py
@@ -0,0 +1,112 @@
+"""Label-independent bounded real routes from the complete non-DDI DRKG.
+
+Topology only is cached. A two-hop ball intersection is an exact test for an
+undirected path of length <=4 (inverse relations are deliberately present).
+We select meeting nodes by entity type, then up to two real two-hop arms per
+endpoint. No local NAI slots, event labels, or learned features enter extraction.
+"""
+from functools import lru_cache
+import numpy as np
+from scipy import sparse
+
+
+def spread(values, limit):
+    if len(values) <= limit:
+        return values
+    return values[np.linspace(0, len(values) - 1, limit, dtype=np.int64)]
+
+
+def balanced(values, types, limit):
+    """Round-robin entity types; spaced source indices within each type."""
+    groups = [values[types[values] == t] for t in np.unique(types[values])]
+    groups = [spread(g, limit) for g in groups]
+    selected = []
+    for slot in range(limit):
+        for group in groups:
+            if slot < len(group):
+                selected.append(group[slot])
+                if len(selected) == limit:
+                    return np.asarray(selected, dtype=np.int32)
+    return np.asarray(selected, dtype=np.int32)
+
+
+class RouteExtractor:
+    def __init__(self, triples, entities, n_rel, meeting_cap=32, arm_cap=2):
+        self.n_rel, self.meeting_cap, self.arm_cap = n_rel, meeting_cap, arm_cap
+        # triples are (head, relation, tail). Preserve source row multiplicity.
+        h, r, t = triples.T
+        self.src = np.concatenate([h, t]).astype(np.int32)
+        self.dst = np.concatenate([t, h]).astype(np.int32)
+        self.rel = np.concatenate([r, r + n_rel]).astype(np.int16)
+        order = np.lexsort((self.rel, self.dst, self.src))
+        self.src, self.dst, self.rel = self.src[order], self.dst[order], self.rel[order]
+        self.ptr = np.concatenate([[0], np.bincount(self.src, minlength=len(entities)).cumsum()])
+        # sum_duplicates compacts CSR indices in place. Keep the typed source
+        # arrays independent, since their row offsets preserve parallel facts.
+        self.adj = sparse.csr_matrix((np.ones(len(self.src), np.int32),
+                                     self.dst, self.ptr), shape=(len(entities), len(entities)), copy=True)
+        self.adj.sum_duplicates()
+        self.adj.data[:] = 1
+        names = [e.split('::', 1)[0] for e in entities]
+        type_names = sorted(set(names))
+        self.type_names = type_names
+        self.types = np.asarray([type_names.index(t) for t in names], np.int8)
+        self.balls = {}
+
+    def neighbors(self, node):
+        return self.adj.indices[self.adj.indptr[node]:self.adj.indptr[node + 1]]
+
+    def build_balls(self, endpoints):
+        for node in endpoints:
+            row = self.adj.getrow(int(node))
+            two = (row @ self.adj).indices
+            self.balls[int(node)] = np.unique(np.concatenate([[node], row.indices, two])).astype(np.int32)
+
+    def edges_between(self, u, v):
+        start, end = self.ptr[u:u + 2]
+        dest = self.dst[start:end]
+        left, right = np.searchsorted(dest, v, side='left'), np.searchsorted(dest, v, side='right')
+        return range(int(start + left), int(start + right))
+
+    @lru_cache(maxsize=65536)
+    def arm(self, endpoint, mid):
+        if endpoint == mid:
+            return ()
+        direct = tuple(self.edges_between(endpoint, mid))
+        if direct:
+            return direct
+        bridges = np.intersect1d(self.neighbors(endpoint), self.neighbors(mid), assume_unique=True)
+        bridges = balanced(bridges, self.types, self.arm_cap)
+        edge_ids = []
+        for bridge in bridges:
+            edge_ids.extend(self.edges_between(endpoint, int(bridge)))
+            edge_ids.extend(self.edges_between(int(bridge), mid))
+        return tuple(edge_ids)
+
+    def extract(self, head, tail):
+        if head < 0 or tail < 0:
+            return np.asarray([head, tail], np.int32), np.empty((0, 4), np.int32), False
+        mids = np.intersect1d(self.balls[head], self.balls[tail], assume_unique=True)
+        if not len(mids):
+            return np.asarray([head, tail], np.int32), np.empty((0, 4), np.int32), False
+        mids = balanced(mids, self.types, self.meeting_cap)
+        edge_ids = set()
+        for mid in mids:
+            edge_ids.update(self.arm(head, int(mid)))
+            edge_ids.update(self.arm(tail, int(mid)))
+        # Include inverse of every selected real row. Because rows are sorted,
+        # retrieve its reverse by endpoints and relation (including duplicates).
+        selected = sorted(edge_ids)
+        triples = {(int(self.src[i]), int(self.dst[i]), int(self.rel[i])) for i in selected}
+        inverse = {(v, u, r + self.n_rel if r < self.n_rel else r - self.n_rel) for u, v, r in triples}
+        topology = sorted(triples | inverse)
+        # Multiplicity of repeated source facts follows the original sparse KG.
+        counts = {}
+        for u, v, r in topology:
+            ids = self.edges_between(u, v)
+            counts[u, v, r] = sum(int(self.rel[i]) == r for i in ids)
+        nodes = np.asarray(sorted({head, tail} | {u for u, v, r in topology} | {v for u, v, r in topology}), np.int32)
+        local = {int(n): i for i, n in enumerate(nodes)}
+        edges = [(local[u], local[v], r, counts[u, v, r]) for u, v, r in topology]
+        edges += [(i, i, 2 * self.n_rel, 1) for i in range(len(nodes))]
+        return nodes, np.asarray(edges, np.int32).reshape(-1, 4), True
