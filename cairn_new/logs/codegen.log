"""no_gene_embeddings variant: CAIRN without a shared gene table or functional auxiliaries.

Authored by Claude Opus5.5 (claude-opus-5-5), 2026-10-06, following
docs/no_gene_embeddings_plan.md. Gated by the top-level config key
`model_variant: no_gene_embeddings`; every other config builds the unchanged CAIRN.

Removed relative to CAIRN: the shared learnable gene table E, the target gene
projection W_t, landmark expression pooling, the LINCS source adapter, the
perturbation/dependency heads and their per-gene biases. Retained unchanged:
the approved RareDDIE CSE/NAI/PVR widths and classes, DDI and contrastive heads,
KPGT drug adapter, A/B dual-query synergy head, and the frozen FIN/KPGT buffers.
NAI target context is the frozen FIN entity and relation only (valid when both
indices exist). The cell representation maps the 978 ordered, training-normalized
basal expression values directly to 1024, then the existing LayerNorm/ResidualMLP.

Opt-in `fin_finetune: true` (top-level config key; Claude Opus5.5, 2026-10-11,
docs/no_gene_embeddings_six_relations_FIN_tune_plan.md): fin_entities and
fin_relations become trainable nn.Parameters initialized from the same bundle
tensors, with the same state keys and shapes, as RareDDIE's finetune symbol_emb.
The index and KPGT inputs stay frozen buffers. Without the key, FIN stays a
frozen buffer exactly as before.

Opt-in `regression_variant: mu_ccle978` (top-level config key next to
`model_variant: no_gene_embeddings`; Claude Opus5.5, 2026-10-11,
docs/no_gene_embeddings_mu_ccle978_plan.md) builds NoGeneMuCCLE: the same frozen
FIN/index buffers, CSE/NAI/PVR, DDI and contrastive heads, whose synergy path is
only concat(directional PVR mu 512, training-normalized CCLE 978) -> MLP -> 1,
averaged over A,B and B,A. It has no KPGT buffer, drug adapter, cell encoder or
attention SynergyHead. Without the key, build_model is unchanged.
"""
import torch
from torch import nn

from .models import (CAIRN, DrugAdapter, PairVariationalRepresentation, RareCSE, RareNAI,
                     ResidualMLP, SynergyHead)

VARIANT = "no_gene_embeddings"
# Frozen input buffers (inference copies these from the explicit-ID bundle; see frozen_inputs).
FROZEN_BUFFERS = {"fin_entities", "fin_relations", "kpgt_features", "target_fin_idx",
                  "target_relation_idx", "drug_fin_idx"}
FIN_TABLES = ("fin_entities", "fin_relations")
# Opt-in regression_variant (NoGeneMuCCLE): no KPGT buffer, since nothing reads it.
REGRESSION_VARIANT = "mu_ccle978"
MU_CCLE_FROZEN_BUFFERS = FROZEN_BUFFERS - {"kpgt_features"}


def frozen_inputs(config):
    """Frozen buffers of the model this config builds; fin_finetune makes the FIN tables learned."""
    if config.get("regression_variant") == REGRESSION_VARIANT:
        return MU_CCLE_FROZEN_BUFFERS
    return FROZEN_BUFFERS - set(FIN_TABLES) if config.get("fin_finetune", False) else FROZEN_BUFFERS
# Synergy-only regression modules: frozen and optimizer-free in Stage1, freshly reset in Stage2.
REGRESSION_PREFIXES = ("drug_adapter.", "cell_encoder.", "synergy.")


class DirectCellEncoder(nn.Module):
    """Ordered 978 landmark expression -> 1024, then the approved LayerNorm and CellMLP.

    `expression` is one ordinary dense projection; its columns are never indexed,
    shared or reused as gene vectors.
    """

    def __init__(self, dropout):
        super().__init__()
        self.expression = nn.Linear(978, 1024)
        self.input_norm = nn.LayerNorm(1024)
        self.residual = ResidualMLP(dropout)

    def forward(self, expression):
        return self.residual(self.input_norm(self.expression(expression)))


class NoGeneCAIRN(nn.Module):
    def __init__(self, bundle: dict, config: dict):
        super().__init__()
        model_config = config.get("model", config)
        dropout = float(model_config.get("dropout", 0.1))
        self.config = config
        self.fin_finetune = bool(config.get("fin_finetune", False))
        for name in ("fin_entities", "fin_relations", "kpgt_features", "target_fin_idx",
                     "target_relation_idx", "drug_fin_idx"):
            tensor = torch.as_tensor(bundle[name]).detach().clone()
            if self.fin_finetune and name in FIN_TABLES:
                setattr(self, name, nn.Parameter(tensor))  # pretrained FIN as the initial value
            else:
                self.register_buffer(name, tensor)
        self.cse = RareCSE(dropout)
        self.nai = RareNAI(dropout)
        self.pvr = PairVariationalRepresentation(dropout)
        self.drug_adapter = DrugAdapter(self.kpgt_features.shape[1], dropout)
        self.cell_encoder = DirectCellEncoder(dropout)
        self.ddi_head = nn.Sequential(
            nn.Linear(512, 1024), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(1024, int(bundle["num_ddi_classes"])),
        )
        self.contrastive_head = nn.Sequential(
            nn.Linear(512, 512), nn.GELU(), nn.Linear(512, 256),
        )
        self.synergy = SynergyHead(dropout)

    def initialize_regression(self):
        """Stage two: fresh drug adapter, cell encoder and synergy head (all Linear/LayerNorm)."""
        for module in (self.drug_adapter, self.cell_encoder):
            for layer in module.modules():
                if isinstance(layer, (nn.Linear, nn.LayerNorm)):
                    layer.reset_parameters()
        self.synergy.reset_parameters()

    def target_features(self, drugs):
        entity_index = self.target_fin_idx[drugs]
        relation_index = self.target_relation_idx[drugs]
        valid = (entity_index >= 0) & (relation_index >= 0)
        # Invalid slots are zeroed (never FIN row zero) and excluded from NAI attention.
        present = valid[:, :, None].to(self.fin_entities.dtype)
        entities = self.fin_entities[entity_index.clamp_min(0)] * present
        relations = self.fin_relations[relation_index.clamp_min(0)] * present
        return entities, relations, valid

    # The approved CAIRN functions, reused unchanged: same partner guide, NAI/PVR
    # pair path, DDI outputs and multi-task dispatch.
    directional_pair = CAIRN.directional_pair
    forward_ddi = CAIRN.forward_ddi
    forward = CAIRN.forward

    def forward_synergy(self, batch):
        structure_a = self.cse(batch["graph_a"])
        structure_b = self.cse(batch["graph_b"])
        drug_a = self.drug_adapter(self.kpgt_features[batch["drug_a"]])
        drug_b = self.drug_adapter(self.kpgt_features[batch["drug_b"]])
        cell = self.cell_encoder(batch["cell_expr"])
        nai_a, nai_b, _, mu_ab, _ = self.directional_pair(
            batch["drug_a"], batch["drug_b"], structure_a, structure_b,
        )
        score_ab = self.synergy(drug_a, drug_b, cell, nai_a, nai_b, mu_ab)
        nai_ba, nai_ab, _, mu_ba, _ = self.directional_pair(
            batch["drug_b"], batch["drug_a"], structure_b, structure_a,
        )
        score_ba = self.synergy(drug_b, drug_a, cell, nai_ba, nai_ab, mu_ba)
        return {
            "score": 0.5 * (score_ab + score_ba),
            "directional_score_ab": score_ab,
            "directional_score_ba": score_ba,
        }


# Source NoGeneCAIRN Stage1 state not carried into NoGeneMuCCLE: the unused KPGT buffer and the
# never-trained (frozen in Stage1) regression modules.
MU_CCLE_DROPPED_SOURCE = ("kpgt_features",) + REGRESSION_PREFIXES


class NoGeneMuCCLE(nn.Module):
    """no_gene_embeddings DDI core with the direct mu + raw-CCLE synergy regressor.

    Synergy input x_AB = [mu_AB (512, deterministic PVR mean), cell_expr (978, the
    ordered training-normalized CCLE landmarks of the batch)], width 1490, into the
    source SynergyHead regressor layout with input 1490. The DDI path, state keys
    and shapes of the shared core equal NoGeneCAIRN's.
    """

    def __init__(self, bundle: dict, config: dict):
        super().__init__()
        model_config = config.get("model", config)
        dropout = float(model_config.get("dropout", 0.1))
        self.config = config
        for name in ("fin_entities", "fin_relations", "target_fin_idx", "target_relation_idx", "drug_fin_idx"):
            self.register_buffer(name, torch.as_tensor(bundle[name]).detach().clone())
        self.cse = RareCSE(dropout)
        self.nai = RareNAI(dropout)
        self.pvr = PairVariationalRepresentation(dropout)
        self.ddi_head = nn.Sequential(
            nn.Linear(512, 1024), nn.GELU(), nn.Dropout(dropout),
            nn.Linear(1024, int(bundle["num_ddi_classes"])),
        )
        self.contrastive_head = nn.Sequential(
            nn.Linear(512, 512), nn.GELU(), nn.Linear(512, 256),
        )
        width = self.pvr.mu.out_features + 978
        self.regressor = nn.Sequential(
            nn.Linear(width, 2048), nn.GELU(), nn.LayerNorm(2048), nn.Dropout(dropout),
            nn.Linear(2048, 1024), nn.GELU(), nn.LayerNorm(1024), nn.Dropout(dropout),
            nn.Linear(1024, 1),
        )

    def initialize_regression(self):
        """Stage two: fresh direct regressor (all Linear/LayerNorm)."""
        for layer in self.regressor:
            if isinstance(layer, (nn.Linear, nn.LayerNorm)):
                layer.reset_parameters()

    target_features = NoGeneCAIRN.target_features
    directional_pair = CAIRN.directional_pair
    forward_ddi = CAIRN.forward_ddi
    forward = CAIRN.forward

    def forward_synergy(self, batch):
        structure_a = self.cse(batch["graph_a"])
        structure_b = self.cse(batch["graph_b"])
        cell = batch["cell_expr"]
        _, _, _, mu_ab, _ = self.directional_pair(
            batch["drug_a"], batch["drug_b"], structure_a, structure_b,
        )
        score_ab = self.regressor(torch.cat([mu_ab, cell], dim=-1)).squeeze(-1)
        # B,A: its own directional NAI/PVR mean, the same cell expression.
        _, _, _, mu_ba, _ = self.directional_pair(
            batch["drug_b"], batch["drug_a"], structure_b, structure_a,
        )
        score_ba = self.regressor(torch.cat([mu_ba, cell], dim=-1)).squeeze(-1)
        return {
            "score": 0.5 * (score_ab + score_ba),
            "directional_score_ab": score_ab,
            "directional_score_ba": score_ba,
        }


def build_model(bundle: dict, config: dict):
    """Saved-config factory: the variant only when explicitly named, otherwise CAIRN."""
    if config.get("model_variant") == VARIANT:
        if config.get("regression_variant") == REGRESSION_VARIANT:
            return NoGeneMuCCLE(bundle, config)
        return NoGeneCAIRN(bundle, config)
    return CAIRN(bundle, config)
"""RareDDIE's fixed 55-atom / 17-bond molecular representation.

Source: RareDDIE/data_preprocessing_t.py at the recorded upstream revision.
The values and directed-bond ordering match the active atom_features and
get_mol_edge_list_and_feat_mtx functions; no fingerprint branch is used.
"""
from rdkit import Chem
import torch
from torch_geometric.data import Data

ATOM_SYMBOLS = [
    "C", "N", "O", "S", "F", "Si", "P", "Cl", "Br", "Mg", "Na", "Ca",
    "Fe", "As", "Al", "I", "B", "V", "K", "Tl", "Yb", "Sb", "Sn", "Ag",
    "Pd", "Co", "Se", "Ti", "Zn", "H", "Li", "Ge", "Cu", "Au", "Ni", "Cd",
    "In", "Mn", "Zr", "Cr", "Pt", "Hg", "Pb", "Unknown",
]
HYBRIDIZATIONS = [
    Chem.rdchem.HybridizationType.SP,
    Chem.rdchem.HybridizationType.SP2,
    Chem.rdchem.HybridizationType.SP3,
    Chem.rdchem.HybridizationType.SP3D,
    Chem.rdchem.HybridizationType.SP3D2,
]


def one_hot_unknown(value, choices):
    value = value if value in choices else choices[-1]
    return [float(value == choice) for choice in choices]


def atom_features(atom):
    return torch.tensor(
        one_hot_unknown(atom.GetSymbol(), ATOM_SYMBOLS)
        + [
            atom.GetDegree() / 10.0,
            atom.GetValence(Chem.ValenceType.IMPLICIT),
            atom.GetFormalCharge(),
            atom.GetNumRadicalElectrons(),
        ]
        + one_hot_unknown(atom.GetHybridization(), HYBRIDIZATIONS)
        + [float(atom.GetIsAromatic()), atom.GetTotalNumHs()],
        dtype=torch.float32,
    )


def bond_features(bond):
    kind = bond.GetBondType()
    return torch.tensor(
        [
            kind == Chem.rdchem.BondType.SINGLE,
            kind == Chem.rdchem.BondType.DOUBLE,
            kind == Chem.rdchem.BondType.TRIPLE,
            kind == Chem.rdchem.BondType.AROMATIC,
            0,
            0,
        ]
        + one_hot_unknown(bond.GetIsConjugated(), [0, 1, "nonbond"])
        + one_hot_unknown(bond.IsInRing(), [0, 1, "nonbond"])
        + one_hot_unknown(
            str(bond.GetStereo()),
            ["STEREONONE", "STEREOANY", "STEREOZ", "STEREOE", "nonbond"],
        ),
        dtype=torch.float32,
    )


def smiles_to_graph(smiles: str) -> Data:
    mol = Chem.MolFromSmiles(smiles.strip())
    if mol is None or mol.GetNumAtoms() == 0:
        raise ValueError(f"Cannot construct a molecular graph for SMILES: {smiles!r}")
    x = torch.stack([atom_features(atom) for atom in mol.GetAtoms()])
    bonds = list(mol.GetBonds())
    if bonds:
        edges = torch.tensor(
            [[bond.GetBeginAtomIdx(), bond.GetEndAtomIdx()] for bond in bonds],
            dtype=torch.long,
        )
        edge_index = torch.cat([edges, edges[:, [1, 0]]], dim=0).T.contiguous()
        edge_attr = torch.stack([bond_features(bond) for bond in bonds]).repeat(2, 1)
    else:
        # This is the upstream representation for an isolated-atom molecule.
        edge_index = torch.zeros((2, 2), dtype=torch.long)
        edge_attr = torch.zeros((2, 17), dtype=torch.float32)
    return Data(x=x, edge_index=edge_index, edge_attr=edge_attr)

