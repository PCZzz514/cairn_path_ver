automation.
#!/usr/bin/env bash
# Detached pairout_cellout monitor daemon (started only by start_monitor.sh).
# Pattern of accelerated_four/monitor/monitor_loop.sh (left untouched):
# deterministic status, one gpt-6.1-sol LOW Codex check, host drain of recovery
# requests, after status; first check immediately, then one every 2400 seconds.
# Local state only (logs/pairout_cellout/monitor, status.json); no notifications.
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/../env.sh"
MONITOR_DIR="$LOG_DIR/monitor"
mkdir -p "$MONITOR_DIR"
exec 9>"$MONITOR_DIR/daemon.lock"
flock -n 9 || exit 0
echo "$$" > "$MONITOR_DIR/monitor.pid"
export CODEX_HOME="$ROOT_DIR/.codex_runtime"
# The monitor never needs a GPU; training jobs run in their own sessions.
export CUDA_VISIBLE_DEVICES=''
# Use the existing proxy service without shell initialization/history writes.
export http_proxy=http://127.0.0.1:7890 https_proxy=http://127.0.0.1:7890
export all_proxy=socks5://127.0.0.1:7890 no_proxy=localhost,127.0.0.1,::1
export HTTP_PROXY="$http_proxy" HTTPS_PROXY="$https_proxy"
export ALL_PROXY="$all_proxy" NO_PROXY="$no_proxy"
cd "$ROOT_DIR"
CLI_FAILURES=0
trap 'date -u +%FT%TZ > "$MONITOR_DIR/stopped_at.txt"' EXIT
status_to() {
  # A status/verifier error is recorded and never stops monitoring.
  "$PYTHON_BIN" pairout_cellout/jobs.py --status > "$1" 2> "$1.err" \
    || printf '{"all_complete": false, "status_error": true, "runs": {}}\n' > "$1"
}
record_status() {
  # monitor section of logs/pairout_cellout/status.json; failures never stop monitoring.
  "$PYTHON_BIN" - "$MONITOR_DIR" "$CHECK_ID" "$1" "${CODEX_EXIT:-}" <<'PY' || true
import json, sys
from pathlib import Path
from pairout_cellout.status import update_status
monitor, check, outcome, codex_exit = Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
after = monitor / 'checks' / check / 'after.json'
runs = json.loads(after.read_text()).get('runs', {}) if after.exists() else {}
update_status('monitor_' + outcome, section='monitor', pid=int((monitor / 'monitor.pid').read_text()),
              last_check=check, last_codex_exit=int(codex_exit) if codex_exit else None,
              last_successful_check=(monitor / 'last_successful_check.txt').read_text().strip()
              if (monitor / 'last_successful_check.txt').exists() else None,
              next_check=(monitor / 'next_check.txt').read_text().strip() if (monitor / 'next_check.txt').exists() else None,
              interval_seconds=2400, model='gpt-6.1-sol low', outcome=outcome,
              runs={arm: {k: r.get(k) for k in ['state', 'attempt', 'recoveries', 'history_last_epoch',
                                                 'history_best_validation_macro_f1_85', 'history_bad_epochs']}
                    for arm, r in runs.items()})
PY
}
while true; do
  CHECK_ID="$(date -u +%Y%m%dT%H%M%SZ)_$$"
  CHECK_DIR="$MONITOR_DIR/checks/$CHECK_ID"
  CODEX_EXIT=''
  mkdir -p "$CHECK_DIR"
  date -u +%FT%TZ > "$MONITOR_DIR/last_check.txt"
  date -u -d '+2400 seconds' +%FT%TZ > "$MONITOR_DIR/next_check.txt"
  # Check lock covers both state reads, Codex, and the host recovery drain.
  exec 7>"$MONITOR_DIR/check.lock"
  flock 7
  status_to "$CHECK_DIR/before.json"
  cp "$CHECK_DIR/before.json" "$MONITOR_DIR/snapshot_summary.json"
  if "$PYTHON_BIN" - "$CHECK_DIR/before.json" <<'PY'
import json, sys
sys.exit(0 if json.load(open(sys.argv[1]))['all_complete'] else 1)
PY
  then
    cp "$CHECK_DIR/before.json" "$CHECK_DIR/after.json"
    cp "$CHECK_DIR/before.json" "$MONITOR_DIR/final_summary.json"
    echo 'complete' > "$MONITOR_DIR/state.txt"
    rm -f "$MONITOR_DIR/next_check.txt"
    record_status complete
    echo 'Both selected-best checkpoint tests and complete exports verified.'
    exit 0
  fi
  echo 'monitoring' > "$MONITOR_DIR/state.txt"
  printf '%s model=gpt-6.1-sol reasoning=low interval_seconds=2400\n' "$CHECK_ID"
  # A CLI timeout affects ONLY this check, never a training process.
  if timeout --signal=TERM --kill-after=30s 1200s \
      /data/interns/zhangpc/.local/bin/codex exec \
      --dangerously-bypass-approvals-and-sandbox --ignore-user-config --ephemeral --skip-git-repo-check \
      -c 'model_reasoning_effort="low"' -m gpt-6.1-sol -C "$ROOT_DIR" \
      -o "$CHECK_DIR/codex_final.txt" - < pairout_cellout/monitor/prompt.md \
      > "$CHECK_DIR/codex.log" 2>&1; then
    CODEX_EXIT=0
    CLI_FAILURES=0
  else
    CODEX_EXIT=$?
    CLI_FAILURES=$((CLI_FAILURES + 1))
    printf '%s exit=%s consecutive_failures=%s\n' "$CHECK_ID" "$CODEX_EXIT" "$CLI_FAILURES" >> "$MONITOR_DIR/cli_failures.log"
  fi
  echo "$CODEX_EXIT" > "$CHECK_DIR/codex_exit.txt"
  # Launch recovery only here, outside the CLI timeout and its PID namespace.
  if "$PYTHON_BIN" pairout_cellout/monitor/drain_recovery_requests.py \
      > "$CHECK_DIR/recovery_drain.log" 2>&1; then
    :
  else
    DRAIN_EXIT=$?
    printf '%s drain_exit=%s\n' "$CHECK_ID" "$DRAIN_EXIT" >> "$MONITOR_DIR/recovery_drain_errors.log"
  fi
  status_to "$CHECK_DIR/after.json"
  cp "$CHECK_DIR/after.json" "$MONITOR_DIR/snapshot_summary.json"
  # Successful check: Codex exit 0 and after.json persisted (next_check.txt above).
  [[ "$CODEX_EXIT" == 0 ]] && echo "$CHECK_ID" > "$MONITOR_DIR/last_successful_check.txt"
  OUTCOME="$("$PYTHON_BIN" - "$CHECK_DIR/after.json" <<'PY' || echo monitoring
import json, sys
state = json.load(open(sys.argv[1]))
if state['all_complete']:
    print('complete')
elif state['runs'] and all(r['state'] in ('complete', 'exhausted') for r in state['runs'].values()):
    print('blocked_recovery_budget')
else:
    print('monitoring')
PY
  )"
  echo "$OUTCOME" > "$MONITOR_DIR/state.txt"
  if [[ "$OUTCOME" != monitoring ]]; then
    cp "$CHECK_DIR/after.json" "$MONITOR_DIR/final_summary.json"
    rm -f "$MONITOR_DIR/next_check.txt"
    record_status "$OUTCOME"
    [[ "$OUTCOME" == complete ]] && exit 0
    echo "Monitor blocked: $OUTCOME; see final_summary.json and attempt logs" >&2
    exit 1
  fi
  record_status monitoring
  flock -u 7
  # Maintain a 2400-second interval between check starts, including CLI time.
  NEXT_EPOCH="$(date -u -d "$(cat "$MONITOR_DIR/next_check.txt")" +%s)"
  NOW_EPOCH="$(date -u +%s)"
  if (( NEXT_EPOCH > NOW_EPOCH )); then
    sleep "$((NEXT_EPOCH - NOW_EPOCH))"
  fi
done
"""Confirm real progress of both launched arms (no signals, read-only).

Per arm: wrapper/trainer PID, PPID, session, process identity; the fresh seed42
full-path start line; the actual first update (finite CE/rec/KL/loss, logits and
gradients of EVERY group including path, first_update.json), the parameter
inventory (accelerated_four path architecture, packed attention and path keys)
and initial RNG record; and a 100-update progress line.
Writes logs/pairout_cellout/launch.json and updates status.json.
"""
import argparse
import json
import math
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from pairout_cellout.jobs import ARMS, OUTPUTS, STATE, live, process_start, read_json, write_json  # noqa: E402
from pairout_cellout.dsn.train import GROUPS  # noqa: E402
from pairout_cellout.status import update_status  # noqa: E402

# accelerated_four/outputs/path_single_drugout/model_inventory.json (reviewed
# packed full-path model; same global FIN tables): 13522485 / 13522483.
PARAMETERS, TRAINABLE = 13522485, 13522483
REQUIRED_KEYS = ['cse.blocks.0.interAtt.inter.lin_src.weight', 'cse.blocks.1.interAtt.inter.att_dst',
                 'cse.blocks.1.inter_projection.weight', 'path.rel_kg.3.weight', 'path.attn_relation.3.weight',
                 'pvr.encoder.0.weight', 'classifier.4.weight', 'fin_entities.weight', 'fin_relations.weight']


def events(log):
    found = {}
    for line in Path(log).read_text(errors='replace').splitlines():
        if line.startswith('{'):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            phase = event.get('phase', 'epoch' if 'validation' in event else None)
            if phase == 'train_progress' and 'first_step' not in found:
                found['first_step'] = event
            if phase == 'train_progress' and event['update'] % 100 == 0:
                found['progress_100'] = event
            if phase:
                found[phase] = event
    return found


def ps(pid):
    out = subprocess.run(['ps', '-o', 'pid=,ppid=,pgid=,sid=,etime=,args=', '-p', str(pid)],
                         capture_output=True, text=True).stdout.strip()
    return out or None


def arm_state(arm):
    record = read_json(STATE / arm / 'record.json')
    process = STATE / arm / f'attempt_{record["attempt"]}_process.json'
    trainer = read_json(process) if process.exists() else None
    found = events(record['log'])
    output = OUTPUTS / arm
    first = read_json(output / 'first_update.json') if (output / 'first_update.json').exists() else None
    inventory = read_json(output / 'model_inventory.json') if (output / 'model_inventory.json').exists() else None
    # GPU3 evidence: the last CSE block's norm2 output is never consumed.
    first_ok = bool(first) and first['all_gradients_finite'] and first['logits_finite'] and all(
        math.isfinite(v) for v in [*first['loss_terms'].values(), *first['gradient_norms'].values()]) and sorted(
        first['gradient_norms']) == sorted(GROUPS) and all(v > 0 for v in first['gradient_norms'].values()) and sorted(
        first['trainable_without_gradient']) == ['cse.blocks.1.norm2.bias', 'cse.blocks.1.norm2.weight'] and (
        first['path_batch']['edges'] > 0 and first['path_batch']['pairs_with_cached_path'] > 0)
    inventory_ok = bool(inventory) and inventory['parameters'] == PARAMETERS and (
        inventory['trainable_parameters'] == TRAINABLE) and inventory['fin_trainable'] and (
        inventory['pair_input'] == 514 and inventory['path_depth'] == 4 and inventory['groups']['path'] > 0) and all(
        key in inventory['state_dict_keys'] for key in REQUIRED_KEYS)
    start = found.get('start') or {}
    fresh = (start.get('mode') == 'fresh' and start.get('seed') == 42 and start.get('with_path') is True and
             start.get('train_batches') == 1184 and start.get('planned_updates') == 118400 and
             start.get('kl_warmup_updates') == 23680 and start.get('batch_size') == 128) or record['mode'] != '--fresh'
    ok = 'start' in found and fresh and (('first_step' in found and 'progress_100' in found and first_ok
                                          and inventory_ok) or 'best_checkpoint_test' in found)
    return {'pid': record['pid'], 'wrapper_ps': ps(record['pid']),
            'wrapper_ppid_is_1': (ps(record['pid']) or '').split()[1:2] == ['1'],
            'trainer': trainer, 'trainer_ps': ps(trainer['pid']) if trainer else None,
            'trainer_alive_same_process': bool(trainer) and process_start(trainer['pid']) == trainer['process_start'],
            'live': live(record), 'mode': record['mode'], 'log': record['log'],
            'start': found.get('start'), 'first_step': found.get('first_step'), 'progress_100': found.get('progress_100'),
            'first_update': first, 'first_update_ok': first_ok, 'inventory_ok': inventory_ok,
            'initial_rng_recorded': (output / 'initial_rng.pt').is_file(),
            'test_export': found.get('best_checkpoint_test', {}).get('macro_f1_85'),
            'exit': read_json(Path(record['exit_file'])) if Path(record['exit_file']).exists() else None,
            'progress_confirmed': ok}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--wait', type=float, default=0.)
    args = parser.parse_args()
    deadline = time.time() + args.wait
    while True:
        arms = {arm: arm_state(arm) for arm in ARMS}
        done = all(a['progress_confirmed'] or a['exit'] is not None for a in arms.values())
        if done or time.time() > deadline:
            break
        time.sleep(15)
    gpus = subprocess.run(['nvidia-smi', '--query-compute-apps=gpu_uuid,pid,used_memory', '--format=csv,noheader'],
                          capture_output=True, text=True).stdout.splitlines()
    launch = {'checked_at': time.strftime('%Y-%m-%dT%H:%M:%S%z'), 'arms': arms,
              'gpu_compute_apps': gpus, 'loadavg': list(__import__('os').getloadavg()),
              'all_progress_confirmed': all(a['progress_confirmed'] for a in arms.values())}
    write_json(ROOT / 'logs/pairout_cellout/launch.json', launch)
    update_status('launched_progress_confirmed' if launch['all_progress_confirmed'] else 'launched_progress_unconfirmed',
                  launch_check={'json': str(ROOT / 'logs/pairout_cellout/launch.json'),
                                'all_progress_confirmed': launch['all_progress_confirmed'],
                                'pids': {a: v['pid'] for a, v in arms.items()},
                                'trainer_pids': {a: (v['trainer'] or {}).get('pid') for a, v in arms.items()}})
    print(json.dumps(launch, indent=1))
    return 0 if launch['all_progress_confirmed'] else 1


if __name__ == '__main__':
    sys.exit(main())

