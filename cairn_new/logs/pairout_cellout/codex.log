"""Original bond-aware RareDDIE order with the exact DSN inter-graph layer.

All pair-conditioned states are freshly computed with gradients. The optional
path branch ports EmerGNN's multiplicative sum propagation and shared ordered
pair gates; only real cached topology, never learned states, is reused.

GPU3 speed copy: the inter-graph GAT runs once per direction on the packed
disconnected bipartite batch. The collator already applied each pair's local
default-GATConv self-loop rule, so automatic loops are disabled only here.
"""
from types import SimpleNamespace
import torch
from torch import nn
import torch.nn.functional as F
from torch_geometric.nn import TransformerConv, SAGPooling, LayerNorm, Linear, global_add_pool, GATConv


class InterGraphAttention(nn.Module):
    # Original class, references/DSN-DDI/drugbank_test/layers.py. Same
    # parameters; per-pair self loops arrive explicitly in the packed edges.
    def __init__(self, input_dim):
        super().__init__()
        self.input_dim = input_dim
        self.inter = GATConv((input_dim, input_dim), 32, 2, add_self_loops=False)

    def forward(self, h_data, t_data, b_graph):
        edge_index = b_graph.edge_index
        h_input = F.elu(h_data.x)
        t_input = F.elu(t_data.x)
        t_rep = self.inter((h_input, t_input), edge_index)
        h_rep = self.inter((t_input, h_input), edge_index[[1, 0]])
        return h_rep, t_rep


class CSEBlock(nn.Module):
    def __init__(self):
        super().__init__()
        # RareDDIE MVN_DDI_Block: two 2x64 TransformerConvs, bond64.
        self.feature_conv = TransformerConv(128, 64, 2, edge_dim=64, dropout=0.)
        self.lin_up = Linear(64, 64, bias=True, weight_initializer='glorot')
        self.feature_conv2 = TransformerConv(128, 64, 2, edge_dim=64, dropout=0.)
        self.lin_up2 = Linear(64, 64, bias=True, weight_initializer='glorot')
        self.readout = SAGPooling(128, min_score=-1)
        self.norm = LayerNorm(128)
        self.norm2 = LayerNorm(128)
        self.re_shape_e = Linear(64, 128, bias=True, weight_initializer='glorot')
        # PyG2.0.4 upstream SAGPooling has no extra select scalar.
        self.readout.select.weight.data.fill_(1.)
        self.readout.select.weight.requires_grad_(False)
        self.interAtt = InterGraphAttention(128)
        self.inter_projection = Linear(192, 128, bias=True, weight_initializer='glorot')

    def inter_pair_batch(self, h, t, cross_edges):
        # One call on the packed batch: cross_edges holds only within-pair
        # edges (global offsets) with each pair's own min(n_h, n_t) local loops.
        return self.interAtt(SimpleNamespace(x=h.x), SimpleNamespace(x=t.x),
                             SimpleNamespace(edge_index=cross_edges))

    def forward(self, h, t, cross_edges):
        # Original ne_update order.
        h.x = self.feature_conv(h.x, h.edge_index, h.edge_attr)
        t.x = self.feature_conv(t.x, t.edge_index, t.edge_attr)
        h.x = F.elu(self.norm(h.x, h.batch))
        t.x = F.elu(self.norm(t.x, t.batch))
        h.edge_attr = self.lin_up(h.edge_attr)
        t.edge_attr = self.lin_up(t.edge_attr)
        h.edge_attr = F.elu(h.edge_attr)
        t.edge_attr = F.elu(t.edge_attr)
        # Original second convolution and bond update before GlobalPool.
        h.x = self.feature_conv2(h.x, h.edge_index, h.edge_attr)
        t.x = self.feature_conv2(t.x, t.edge_index, t.edge_attr)
        h.edge_attr = self.lin_up2(h.edge_attr)
        t.edge_attr = self.lin_up2(t.edge_attr)
        hi, ti = self.inter_pair_batch(h, t, cross_edges)
        h.x = self.inter_projection(torch.cat([h.x, hi], dim=-1))
        t.x = self.inter_projection(torch.cat([t.x, ti], dim=-1))
        h_atoms, _, _, h_batch, _, _ = self.readout(h.x, h.edge_index, edge_attr=h.edge_attr, batch=h.batch)
        t_atoms, _, _, t_batch, _, _ = self.readout(t.x, t.edge_index, edge_attr=t.edge_attr, batch=t.batch)
        h_pool = global_add_pool(h_atoms, h_batch, size=h.num_graphs)
        t_pool = global_add_pool(t_atoms, t_batch, size=t.num_graphs)
        h_bond = global_add_pool(h.edge_attr, h.batch[h.edge_index[0]], size=h.num_graphs)
        t_bond = global_add_pool(t.edge_attr, t.batch[t.edge_index[0]], size=t.num_graphs)
        h_bond = F.elu(self.re_shape_e(h_bond))
        t_bond = F.elu(self.re_shape_e(t_bond))
        h_pool, t_pool = h_pool * h_bond, t_pool * t_bond
        h_pool = F.elu(F.normalize(h_pool, p=2, dim=1))
        t_pool = F.elu(F.normalize(t_pool, p=2, dim=1))
        h.x = F.elu(self.norm2(h.x, h.batch))
        t.x = F.elu(self.norm2(t.x, t.batch))
        h.edge_attr, t.edge_attr = F.elu(h.edge_attr), F.elu(t.edge_attr)
        return h, t, h_pool, t_pool


class CSE(nn.Module):
    def __init__(self):
        super().__init__()
        self.initial_node_feature = Linear(55, 128, bias=True, weight_initializer='glorot')
        self.initial_edge_feature = Linear(17, 64, bias=True, weight_initializer='glorot')
        self.initial_node_norm = LayerNorm(128)
        self.blocks = nn.ModuleList([CSEBlock(), CSEBlock()])

    def forward(self, batch):
        # clone keeps the immutable molecular cache unmodified; no deepcopy of
        # learned features occurs anywhere after this point.
        h, t = batch['graph_a'].clone(), batch['graph_b'].clone()
        h.x = self.initial_node_feature(h.x)
        t.x = self.initial_node_feature(t.x)
        h.x = self.initial_node_norm(h.x, h.batch)
        t.x = self.initial_node_norm(t.x, t.batch)
        h.x, t.x = F.elu(h.x), F.elu(t.x)
        h.edge_attr = self.initial_edge_feature(h.edge_attr)
        t.edge_attr = self.initial_edge_feature(t.edge_attr)
        h.edge_attr, t.edge_attr = F.elu(h.edge_attr), F.elu(t.edge_attr)
        repr_h, repr_t = [], []
        for block in self.blocks:
            h, t, rh, rt = block(h, t, batch['cross_edges'])
            repr_h.append(rh)
            repr_t.append(rt)
        return .6 * repr_h[0] + .4 * repr_h[-1], .6 * repr_t[0] + .4 * repr_t[-1]


class NAI(nn.Module):
    """RareDDIE neighbor_encoder with an explicit padding softmax mask."""
    def __init__(self):
        super().__init__()
        self.gcn_w = nn.Linear(256, 128)
        nn.init.xavier_normal_(self.gcn_w.weight)
        self.dropout = nn.Dropout(.5)
        self.Bilinear = nn.Bilinear(128, 128, 1, bias=False)
        self.Linear_self = nn.Linear(128, 128, bias=False)
        self.Linear_nei = nn.Linear(128, 128, bias=False)
        self.Linear_weak_rel = nn.Linear(128, 128, bias=False)

    def forward(self, entity, relation, valid, feature, weak_rel):
        out = self.gcn_w(torch.cat([self.dropout(relation), self.dropout(entity)], -1))
        guide = self.Linear_weak_rel(weak_rel[:, None].expand_as(out))
        score = self.Bilinear(guide, out).squeeze(-1)
        # All-empty rows produce zero neighbor context, no biased padding.
        score = score.masked_fill(~valid, -torch.inf)
        score = torch.where(valid.any(1, keepdim=True), score, torch.zeros_like(score))
        attention = score.softmax(1) * valid.to(score.dtype)
        context = torch.bmm(attention[:, None], out).squeeze(1)
        return F.elu(self.Linear_nei(context) + self.Linear_self(feature))


class EmerGNNPath(nn.Module):
    def __init__(self, n_rel, depth=4):
        super().__init__()
        self.depth = depth
        self.rel_kg = nn.ModuleList([nn.Embedding(2 * n_rel + 1, 128) for _ in range(depth)])
        self.linear = nn.ModuleList([nn.Linear(128, 128) for _ in range(depth)])
        # Original init_weight affects relation embeddings and layer projections
        # before relation gate modules are constructed, leaving gate init default.
        for module in [self.rel_kg, self.linear]:
            for parameter in module.parameters():
                if parameter.ndim > 1:
                    nn.init.xavier_uniform_(parameter)
        self.relation_linear = nn.ModuleList([nn.Linear(256, 5) for _ in range(depth)])
        self.attn_relation = nn.ModuleList([nn.Linear(5, 2 * n_rel + 1) for _ in range(depth)])

    def propagate(self, source, source_nodes, target_nodes, graph, gates):
        n_nodes = int(graph['n_nodes'])
        state = source.new_zeros(n_nodes, 128).index_copy(0, source_nodes, source)
        reachable = torch.zeros(n_nodes, dtype=torch.bool, device=source.device)
        reachable[source_nodes] = True
        src, dst, rel = graph['edge_index'][0], graph['edge_index'][1], graph['relations']
        edge_pair, multiplicity = graph['edge_pair'], graph['multiplicity']
        for layer in range(self.depth):
            # Exactly gated elementwise multiplication, SUM, linear, ReLU.
            relation_input = gates[layer][edge_pair, rel, None] * self.rel_kg[layer](rel)
            message = state[src] * relation_input * multiplicity[:, None]
            aggregated = state.new_zeros(n_nodes, 128).index_add(0, dst, message)
            reach_count = torch.zeros(n_nodes, dtype=torch.long, device=source.device)
            reach_count.index_add_(0, dst, reachable[src].long())
            reachable = reach_count > 0
            # Original linear bias can create features at unreachable nodes.
            # Apply it only after a real source-reachable edge delivered a state.
            state = F.relu(self.linear[layer](aggregated)) * reachable[:, None]
        present = reachable[target_nodes] & graph['path_mask']
        return state[target_nodes] * present[:, None], present

    def forward(self, head, tail, graph):
        ordered_pair = torch.cat([head, tail], -1)
        # Both directions use these SAME gates from the SAME ordered pair.
        gates = [torch.sigmoid(attn(F.relu(proj(ordered_pair))))
                 for proj, attn in zip(self.relation_linear, self.attn_relation)]
        tail_hid, ht = self.propagate(head, graph['head_nodes'], graph['tail_nodes'], graph, gates)
        head_hid, th = self.propagate(tail, graph['tail_nodes'], graph['head_nodes'], graph, gates)
        # Original readout order: [head_hid (v->u), tail_hid (u->v)].
        return torch.cat([head_hid, tail_hid], -1), torch.stack([th, ht], -1)


class PairVAE(nn.Module):
    def __init__(self, feature_dim, presence_dim=0):
        super().__init__()
        self.feature_dim = feature_dim
        self.presence_dim = presence_dim
        self.encoder = nn.Sequential(nn.Linear(feature_dim + presence_dim, 256), nn.GELU())
        self.mu = nn.Linear(256, 128)
        self.logvar = nn.Linear(256, 128)
        self.decoder = nn.Sequential(nn.Linear(128, 256), nn.GELU(), nn.Linear(256, feature_dim))

    def forward(self, pair, path_masks):
        # Equalize each continuous 128-dimensional branch at the PVR boundary;
        # CSE/NAI/path formulas upstream remain unchanged. No learned affine.
        branches = pair.reshape(len(pair), self.feature_dim // 128, 128)
        valid = torch.ones(branches.shape[:2], dtype=torch.bool, device=pair.device)
        if self.presence_dim:
            valid = torch.cat([valid[:, :2], path_masks], dim=1)
        branches = F.layer_norm(branches, (128,)) * valid[:, :, None]
        continuous = branches.flatten(1)
        encoder_input = (torch.cat([continuous, path_masks.to(pair.dtype)], dim=1)
                         if self.presence_dim else continuous)
        encoded = self.encoder(encoder_input)
        mu, logvar = self.mu(encoded), self.logvar(encoded)
        z = mu + torch.exp(.5 * logvar) * torch.randn_like(mu)
        reconstructed = self.decoder(z)
        branch_mse = (reconstructed.reshape_as(branches) - branches.detach()).square().mean(-1)
        # Average over the actual valid branches PER SAMPLE, then over samples.
        # Every pair has equal weight regardless of missing path directions.
        # Flags and absent continuous branches have no reconstruction loss.
        rec = ((branch_mse * valid).sum(1) / valid.sum(1)).mean()
        kl = -.5 * (1 + logvar - mu.square() - logvar.exp()).mean()
        return mu, rec, kl


class DSNRareDDI(nn.Module):
    def __init__(self, assets, config):
        super().__init__()
        self.fin_entities = nn.Embedding.from_pretrained(assets['fin_entities'].clone(), freeze=False)
        self.fin_relations = nn.Embedding.from_pretrained(assets['fin_relations'].clone(), freeze=False)
        self.register_buffer('neighbor_entities', assets['neighbor_entities'])
        self.register_buffer('neighbor_relations', assets['neighbor_relations'])
        self.cse = CSE()
        self.nai = NAI()
"""Durable two-arm job records, real export verification, bounded recovery.

rareddie_control copy of accelerated_four/jobs.py: isolated state
(logs/rareddie_control/jobs), outputs (rareddie_control/outputs) and trainer
(rareddie_control.train). The reviewed initial launch is the ONLY --fresh run.
A recovery continues this run's own checkpoint with its exact recorded config
(--resume, or --test-only once its schedule is finished); it never restarts
from scratch, never reads DSN/accelerated/GPU3 state, never changes batch size.

CPU controller only. Training children receive exactly their assigned GPU.
No model forward, preparation, smoke run, or credential access here.
"""
import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import subprocess
import shutil
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
CONTROL = ROOT / 'rareddie_control'
STATE = ROOT / 'logs/rareddie_control/jobs'
OUTPUTS = CONTROL / 'outputs'
CONFIGS = CONTROL / 'configs'
APPROVAL = ROOT / 'logs/rareddie_control/review_approval.json'
EVIDENCE = CONTROL / 'evidence/cse_equivalence.json'
REVIEW_DIFF = CONTROL / 'review/implementation.diff'
ARMS = {'single_drugout': 6, 'double_drugout': 7}
NAMESPACE = 'rareddie_control'
MAX_RECOVERIES = 3


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + '.tmp')
    temporary.write_text(json.dumps(value, indent=2, allow_nan=False) + '\n')
    temporary.replace(path)


def read_json(path):
    return json.loads(path.read_text())


@contextmanager
def registry_lock():
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'registry.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def process_start(pid):
    try:
        # /proc comm may contain spaces; field 22 follows the closing ')'.
        fields = Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()
        return None if fields[0] == 'Z' else fields[19]
    except (FileNotFoundError, ProcessLookupError):
        return None


def busy(arm):
    # The training child inherits this lock. If its wrapper dies, the live
    # training process still prevents a duplicate launch.
    with (STATE / arm / 'job.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
        except BlockingIOError:
            return True


def live(record):
    pid = record['pid']
    return (record['process_start'] is not None and process_start(pid) == record['process_start']) or busy(record['arm'])


def checkpoint(output, name):
    import torch
    return torch.load(output / name, map_location='cpu', weights_only=False)


def history(output):
    path = output / 'history.jsonl'
    # Newline-terminated records only; a torn final append is not a record.
    return [json.loads(line) for line in path.read_text().split('\n')[:-1]] if path.exists() else []


def verify_exports(arm):
    """Completion means selected-best metrics AND all frozen test rows exported."""
    import numpy as np
    import pandas as pd
    import yaml
    from accelerated_four.dsn.metrics import classification_metrics
    from rareddie_control.train import top_k_accuracy

    output = OUTPUTS / arm
    required = ['best.pt', 'last.pt', 'test_metrics.json', 'test_predictions.parquet',
                'test_probabilities.npz', 'test_per_class.csv', 'test_confusion.csv',
                'test_config.yaml', 'test_complete.json']
    missing = [name for name in required if not (output / name).is_file()]
    if missing:
        return False, {'missing': missing}
    try:
        best = checkpoint(output, 'best.pt')
        last = checkpoint(output, 'last.pt')
        cfg = best['config']
        assert cfg['gpu'] == ARMS[arm] and cfg['protocol'] == arm and cfg['namespace'] == NAMESPACE
        assert Path(cfg['output']) == output
        assert last['config'] == cfg
        assert last['epoch'] >= cfg['epochs'] or last['bad_epochs'] >= cfg['patience']
        # Selected best is the strict fixed85 maximum of the full history.
        assert best['epoch'] <= last['epoch'] and best['best_metric'] == last['best_metric']
        records = history(output)
        assert [r['epoch'] for r in records] == list(range(1, last['epoch'] + 1))
        assert records[-1] == last['metrics'] and records[best['epoch'] - 1] == best['metrics']
        assert best['best_metric'] == records[best['epoch'] - 1]['validation']['macro_f1_85']
        assert all(r['validation']['macro_f1_85'] <= best['best_metric'] for r in records)
        assert all(r['validation']['macro_f1_85'] < best['best_metric'] for r in records[:best['epoch'] - 1])
        marker = read_json(output / 'test_complete.json')
        metrics = read_json(output / 'test_metrics.json')
        assert marker['checkpoint'] == metrics['checkpoint'] == 'best.pt'
        assert marker['selected_epoch'] == metrics['selected_epoch'] == best['epoch']
        assert marker['selected_update'] == best['update']
        assert metrics['selection'] == 'validation only'
        assert metrics['selected_validation_macro_f1_85'] == best['best_metric']
        eval_cfg = yaml.safe_load((output / 'test_config.yaml').read_text())
        assert all(eval_cfg.get(k) == v for k, v in cfg.items())
        assert eval_cfg['evaluation_checkpoint'] == 'best.pt'
        frozen = pd.read_parquet(Path(cfg['prepared']) / cfg['protocol'] / 'ddi.parquet')
        rows = np.flatnonzero(frozen.split.eq('test').to_numpy())
        expected = frozen.iloc[rows]
        prediction = pd.read_parquet(output / 'test_predictions.parquet')
        assert marker['rows'] == metrics['rows'] == len(prediction) == len(expected)
        assert prediction[expected.columns].reset_index(drop=True).equals(expected.reset_index(drop=True))
        with np.load(output / 'test_probabilities.npz', allow_pickle=False) as data:
            probabilities = data['probabilities']
            labels = data['labels']
            assert probabilities.shape == (len(rows), 85)
            assert np.isfinite(probabilities).all() and (probabilities >= 0).all() and (probabilities <= 1).all()
            assert np.allclose(probabilities.sum(1), 1., atol=1e-5)
            assert np.array_equal(data['event_ids'], np.arange(85))
            assert np.array_equal(labels, expected.event_id.to_numpy())
            assert np.array_equal(data['frozen_row_indices'], rows)
            assert np.array_equal(prediction.frozen_row_index.to_numpy(), rows)
            assert np.array_equal(prediction.predicted_event_id.to_numpy(), probabilities.argmax(1))
            assert np.allclose(prediction.predicted_probability.to_numpy(), probabilities.max(1))
        actual, per_class, confusion = classification_metrics(labels, probabilities)
        # Report-only Top-5 from the same exported probabilities.
        actual['top5_accuracy'] = top_k_accuracy(labels, probabilities)
        for key, value in actual.items():
            assert metrics[key] is None if value is None else np.isclose(metrics[key], value, rtol=1e-6, atol=1e-8)
        exported_class = pd.read_csv(output / 'test_per_class.csv')
        assert np.array_equal(exported_class.event_id, np.arange(85))
        for key in per_class.columns:
            assert np.allclose(exported_class[key], per_class[key], equal_nan=True)
        exported_confusion = pd.read_csv(output / 'test_confusion.csv', index_col=0)
        assert np.array_equal(exported_confusion.index.to_numpy(), np.arange(85))
        assert np.array_equal(exported_confusion.columns.astype(int), np.arange(85))
        assert np.array_equal(exported_confusion.to_numpy(), confusion)
        return True, {'selected_epoch': best['epoch'], 'last_epoch': last['epoch'], 'bad_epochs': last['bad_epochs'],
                      'rows': len(rows), 'metrics': actual}
    except Exception as exc:
        return False, {'verification_error': f'{type(exc).__name__}: {exc}'}


def last_log_event(path):
    """Most recent JSON phase line of an attempt log (progress/epoch/test)."""
    try:
        with open(path, 'rb') as stream:
            stream.seek(max(0, stream.seek(0, 2) - 65536))
            lines = stream.read().decode(errors='replace').splitlines()
    except FileNotFoundError:
        return None
    for line in reversed(lines):
        if line.startswith('{'):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            return {k: event[k] for k in ['phase', 'epoch', 'update', 'epoch_rows', 'epoch_seconds', 'seconds',
                                          'bad_epochs', 'best_validation_macro_f1_85', 'start_epoch'] if k in event}
    return None


def status():
    result = {}
    for arm, gpu in ARMS.items():
        record_path = STATE / arm / 'record.json'
        if not record_path.exists():
            result[arm] = {'state': 'not_launched', 'gpu': gpu}
            continue
        record = read_json(record_path)
        running = live(record)
        # Avoid reading checkpoints while the trainer is atomically publishing
        # its final files. A live process is always left alone.
        complete, evidence = (False, {}) if running else verify_exports(arm)
        records = history(OUTPUTS / arm)
        process_file = Path(record['log']).with_name(f'attempt_{record["attempt"]}_process.json')
        result[arm] = {'state': 'live' if running else 'complete' if complete else
                      'exhausted' if record['recoveries'] >= MAX_RECOVERIES else 'failed',
                      'gpu': gpu, 'pid': record['pid'], 'attempt': record['attempt'],
                      'recoveries': record['recoveries'], 'mode': record['mode'], 'log': record['log'],
                      'config': record['config'], 'evidence': evidence,
                      'train_process': read_json(process_file) if process_file.exists() else None,
                      'history_last_epoch': records[-1]['epoch'] if records else None,
                      'history_best_validation_macro_f1_85': records[-1]['best_validation_macro_f1_85'] if records else None,
                      'history_bad_epochs': records[-1]['bad_epochs'] if records else None,
                      'last_log_event': last_log_event(record['log']),
                      'blocked_reason': record.get('blocked_reason'),
                      'exit': read_json(Path(record['exit_file'])) if Path(record['exit_file']).exists() else None}
    snapshot = {'checked_at': time.time(), 'runs': result,
                'all_complete': all(r['state'] == 'complete' for r in result.values())}
    write_json(STATE / 'status.json', snapshot)
    if snapshot['all_complete']:
        write_json(STATE / 'final_summary.json', snapshot)
    return snapshot


def start(arm, config_path, mode, recoveries=0, reason='reviewed initial launch'):
    directory = STATE / arm
    directory.mkdir(parents=True, exist_ok=True)
    old_path = directory / 'record.json'
    old = read_json(old_path) if old_path.exists() else None
    if old and live(old):
        raise RuntimeError(f'{arm} is live; cannot relaunch')
    if mode not in ('--fresh', '--resume', '--test-only') or (mode == '--fresh') != (old is None and recoveries == 0):
"""Confirm real progress of both launched arms (no signals, read-only).

Per arm: wrapper/trainer PID, PPID, session, process identity; the fresh start
line; the actual first update (finite CE/loss and gradients, first_update.json),
the parameter inventory and initial RNG record; and a 100-update progress line.
Writes logs/rareddie_control/launch.json and updates status.json.
"""
import argparse
import json
import math
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from rareddie_control.jobs import ARMS, OUTPUTS, STATE, live, process_start, read_json, write_json  # noqa: E402
from rareddie_control.status import update_status  # noqa: E402


def events(log):
    found = {}
    for line in Path(log).read_text(errors='replace').splitlines():
        if line.startswith('{'):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            phase = event.get('phase', 'epoch' if 'validation' in event else None)
            if phase == 'train_progress' and 'first_step' not in found:
                found['first_step'] = event
            if phase == 'train_progress' and event['update'] % 100 == 0:
                found['progress_100'] = event
            if phase:
                found[phase] = event
    return found


def ps(pid):
    out = subprocess.run(['ps', '-o', 'pid=,ppid=,pgid=,sid=,etime=,args=', '-p', str(pid)],
                         capture_output=True, text=True).stdout.strip()
    return out or None


def arm_state(arm):
    record = read_json(STATE / arm / 'record.json')
    process = STATE / arm / f'attempt_{record["attempt"]}_process.json'
    trainer = read_json(process) if process.exists() else None
    found = events(record['log'])
    output = OUTPUTS / arm
    first = read_json(output / 'first_update.json') if (output / 'first_update.json').exists() else None
    inventory = read_json(output / 'model_inventory.json') if (output / 'model_inventory.json').exists() else None
    first_ok = bool(first) and first['all_gradients_finite'] and all(
        math.isfinite(v) for v in [*first['loss_terms'].values(), *first['gradient_norms'].values()]) and all(
        v > 0 for v in first['gradient_norms'].values()) and sorted(first['trainable_without_gradient']) == [
        'cse.blocks.1.norm2.bias', 'cse.blocks.1.norm2.weight']
    inventory_ok = bool(inventory) and not inventory['forbidden_name_matches'] and not (
        inventory['dsn_inter_attention_present'] or inventory['inter_projection_present']
        or inventory['path_modules_present']) and len(inventory['molecular_transformer_convs']) == 4
    fresh = (found.get('start') or {}).get('mode') == 'fresh' or record['mode'] != '--fresh'
    ok = 'start' in found and fresh and (('first_step' in found and 'progress_100' in found and first_ok
                                          and inventory_ok) or 'best_checkpoint_test' in found)
    return {'pid': record['pid'], 'wrapper_ps': ps(record['pid']),
            'wrapper_ppid_is_1': (ps(record['pid']) or '').split()[1:2] == ['1'],
            'trainer': trainer, 'trainer_ps': ps(trainer['pid']) if trainer else None,
            'trainer_alive_same_process': bool(trainer) and process_start(trainer['pid']) == trainer['process_start'],
            'live': live(record), 'mode': record['mode'], 'log': record['log'],
            'start': found.get('start'), 'first_step': found.get('first_step'), 'progress_100': found.get('progress_100'),
            'first_update': first, 'first_update_ok': first_ok, 'inventory_ok': inventory_ok,
            'initial_rng_recorded': (output / 'initial_rng.pt').is_file(),
            'test_export': found.get('best_checkpoint_test', {}).get('macro_f1_85'),
            'exit': read_json(Path(record['exit_file'])) if Path(record['exit_file']).exists() else None,
            'progress_confirmed': ok}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--wait', type=float, default=0.)
    args = parser.parse_args()
    deadline = time.time() + args.wait
    while True:
        arms = {arm: arm_state(arm) for arm in ARMS}
        done = all(a['progress_confirmed'] or a['exit'] is not None for a in arms.values())
        if done or time.time() > deadline:
            break
        time.sleep(15)
    gpus = subprocess.run(['nvidia-smi', '--query-compute-apps=gpu_uuid,pid,used_memory', '--format=csv,noheader'],
                          capture_output=True, text=True).stdout.splitlines()
    launch = {'checked_at': time.strftime('%Y-%m-%dT%H:%M:%S%z'), 'arms': arms,
              'gpu_compute_apps': gpus, 'loadavg': list(__import__('os').getloadavg()),
              'all_progress_confirmed': all(a['progress_confirmed'] for a in arms.values())}
    write_json(ROOT / 'logs/rareddie_control/launch.json', launch)
    update_status('launched_progress_confirmed' if launch['all_progress_confirmed'] else 'launched_progress_unconfirmed',
                  launch_check={'json': str(ROOT / 'logs/rareddie_control/launch.json'),
                                'all_progress_confirmed': launch['all_progress_confirmed'],
                                'pids': {a: v['pid'] for a, v in arms.items()},
                                'trainer_pids': {a: (v['trainer'] or {}).get('pid') for a, v in arms.items()}})
    print(json.dumps(launch, indent=1))
    return 0 if launch['all_progress_confirmed'] else 1


if __name__ == '__main__':
    sys.exit(main())
#!/usr/bin/env bash
# Detached rareddie_control monitor daemon (started only by start_monitor.sh).
# Pattern of accelerated_four/monitor/monitor_loop.sh (left untouched):
# deterministic status, one gpt-6.1-sol LOW Codex check, host drain of recovery
# requests, after status; first check immediately, then one every 2400 seconds.
# Local state only (logs/rareddie_control/monitor, status.json); no notifications.
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/../env.sh"
MONITOR_DIR="$LOG_DIR/monitor"
mkdir -p "$MONITOR_DIR"
exec 9>"$MONITOR_DIR/daemon.lock"
flock -n 9 || exit 0
echo "$$" > "$MONITOR_DIR/monitor.pid"
export CODEX_HOME="$ROOT_DIR/.codex_runtime"
# The monitor never needs a GPU; training jobs run in their own sessions.
export CUDA_VISIBLE_DEVICES=''
# Use the existing proxy service without shell initialization/history writes.
export http_proxy=http://127.0.0.1:7890 https_proxy=http://127.0.0.1:7890
export all_proxy=socks5://127.0.0.1:7890 no_proxy=localhost,127.0.0.1,::1
export HTTP_PROXY="$http_proxy" HTTPS_PROXY="$https_proxy"
export ALL_PROXY="$all_proxy" NO_PROXY="$no_proxy"
cd "$ROOT_DIR"
CLI_FAILURES=0
trap 'date -u +%FT%TZ > "$MONITOR_DIR/stopped_at.txt"' EXIT
status_to() {
  # A status/verifier error is recorded and never stops monitoring.
  "$PYTHON_BIN" rareddie_control/jobs.py --status > "$1" 2> "$1.err" \
    || printf '{"all_complete": false, "status_error": true, "runs": {}}\n' > "$1"
}
record_status() {
  # monitor section of logs/rareddie_control/status.json; failures never stop monitoring.
  "$PYTHON_BIN" - "$MONITOR_DIR" "$CHECK_ID" "$1" "${CODEX_EXIT:-}" <<'PY' || true
import json, sys
from pathlib import Path
from rareddie_control.status import update_status
monitor, check, outcome, codex_exit = Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
after = monitor / 'checks' / check / 'after.json'
runs = json.loads(after.read_text()).get('runs', {}) if after.exists() else {}
update_status('monitor_' + outcome, section='monitor', pid=int((monitor / 'monitor.pid').read_text()),
              last_check=check, last_codex_exit=int(codex_exit) if codex_exit else None,
              last_successful_check=(monitor / 'last_successful_check.txt').read_text().strip()
              if (monitor / 'last_successful_check.txt').exists() else None,
              next_check=(monitor / 'next_check.txt').read_text().strip() if (monitor / 'next_check.txt').exists() else None,
              interval_seconds=2400, model='gpt-6.1-sol low', outcome=outcome,
              runs={arm: {k: r.get(k) for k in ['state', 'attempt', 'recoveries', 'history_last_epoch',
                                                 'history_best_validation_macro_f1_85', 'history_bad_epochs']}
                    for arm, r in runs.items()})
PY
}
while true; do
  CHECK_ID="$(date -u +%Y%m%dT%H%M%SZ)_$$"
  CHECK_DIR="$MONITOR_DIR/checks/$CHECK_ID"
  CODEX_EXIT=''
  mkdir -p "$CHECK_DIR"
  date -u +%FT%TZ > "$MONITOR_DIR/last_check.txt"
  date -u -d '+2400 seconds' +%FT%TZ > "$MONITOR_DIR/next_check.txt"
  # Check lock covers both state reads, Codex, and the host recovery drain.
  exec 7>"$MONITOR_DIR/check.lock"
  flock 7
  status_to "$CHECK_DIR/before.json"
  cp "$CHECK_DIR/before.json" "$MONITOR_DIR/snapshot_summary.json"
  if "$PYTHON_BIN" - "$CHECK_DIR/before.json" <<'PY'
import json, sys
sys.exit(0 if json.load(open(sys.argv[1]))['all_complete'] else 1)
PY
  then
    cp "$CHECK_DIR/before.json" "$CHECK_DIR/after.json"
    cp "$CHECK_DIR/before.json" "$MONITOR_DIR/final_summary.json"
    echo 'complete' > "$MONITOR_DIR/state.txt"
    rm -f "$MONITOR_DIR/next_check.txt"
    record_status complete
    echo 'Both selected-best checkpoint tests and complete exports verified.'
    exit 0
  fi
  echo 'monitoring' > "$MONITOR_DIR/state.txt"
  printf '%s model=gpt-6.1-sol reasoning=low interval_seconds=2400\n' "$CHECK_ID"
  # A CLI timeout affects ONLY this check, never a training process.
  if timeout --signal=TERM --kill-after=30s 1200s \
      /data/interns/zhangpc/.local/bin/codex exec \
      --dangerously-bypass-approvals-and-sandbox --ignore-user-config --ephemeral --skip-git-repo-check \
      -c 'model_reasoning_effort="low"' -m gpt-6.1-sol -C "$ROOT_DIR" \
      -o "$CHECK_DIR/codex_final.txt" - < rareddie_control/monitor/prompt.md \
      > "$CHECK_DIR/codex.log" 2>&1; then
    CODEX_EXIT=0
    CLI_FAILURES=0
  else
    CODEX_EXIT=$?
    CLI_FAILURES=$((CLI_FAILURES + 1))
    printf '%s exit=%s consecutive_failures=%s\n' "$CHECK_ID" "$CODEX_EXIT" "$CLI_FAILURES" >> "$MONITOR_DIR/cli_failures.log"
  fi
  echo "$CODEX_EXIT" > "$CHECK_DIR/codex_exit.txt"
  # Launch recovery only here, outside the CLI timeout and its PID namespace.
  if "$PYTHON_BIN" rareddie_control/monitor/drain_recovery_requests.py \
      > "$CHECK_DIR/recovery_drain.log" 2>&1; then
    :
  else
    DRAIN_EXIT=$?
    printf '%s drain_exit=%s\n' "$CHECK_ID" "$DRAIN_EXIT" >> "$MONITOR_DIR/recovery_drain_errors.log"
  fi
  status_to "$CHECK_DIR/after.json"
  cp "$CHECK_DIR/after.json" "$MONITOR_DIR/snapshot_summary.json"
  # Successful check: Codex exit 0 and after.json persisted (next_check.txt above).
  [[ "$CODEX_EXIT" == 0 ]] && echo "$CHECK_ID" > "$MONITOR_DIR/last_successful_check.txt"
  OUTCOME="$("$PYTHON_BIN" - "$CHECK_DIR/after.json" <<'PY' || echo monitoring
import json, sys
state = json.load(open(sys.argv[1]))
if state['all_complete']:
    print('complete')
elif state['runs'] and all(r['state'] in ('complete', 'exhausted') for r in state['runs'].values()):
    print('blocked_recovery_budget')
else:
    print('monitoring')
PY
  )"
  echo "$OUTCOME" > "$MONITOR_DIR/state.txt"
  if [[ "$OUTCOME" != monitoring ]]; then
    cp "$CHECK_DIR/after.json" "$MONITOR_DIR/final_summary.json"
    rm -f "$MONITOR_DIR/next_check.txt"
    record_status "$OUTCOME"
    [[ "$OUTCOME" == complete ]] && exit 0
    echo "Monitor blocked: $OUTCOME; see final_summary.json and attempt logs" >&2
    exit 1
  fi
  record_status monitoring
  flock -u 7
  # Maintain a 2400-second interval between check starts, including CLI time.
  NEXT_EPOCH="$(date -u -d "$(cat "$MONITOR_DIR/next_check.txt")" +%s)"
  NOW_EPOCH="$(date -u +%s)"
  if (( NEXT_EPOCH > NOW_EPOCH )); then
    sleep "$((NEXT_EPOCH - NOW_EPOCH))"
  fi
done

