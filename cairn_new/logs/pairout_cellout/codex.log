        mu, rec, kl = self.pvr(pair, masks)
        return {'logits': self.classifier(mu), 'rec': rec, 'kl': kl, 'path_mask': masks}
    if mode not in ('--fresh', '--resume', '--test-only') or (mode == '--fresh') != (old is None and recoveries == 0):
