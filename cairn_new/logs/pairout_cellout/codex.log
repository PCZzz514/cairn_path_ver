    attempt = old['attempt'] + 1 if old else 1
    log = directory / f'attempt_{attempt}.log'
    if log.exists():
        raise RuntimeError(f'Refusing to overwrite {log}')
    config_path = config_path.resolve()
    if not config_path.is_relative_to(ROOT):
