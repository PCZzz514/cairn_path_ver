+#!/usr/bin/env bash
+set -euo pipefail
+source "$(dirname -- "${BASH_SOURCE[0]}")/runtime.sh"
+if [[ "${1:-}" != --launch-reviewed || $# != 1 ]]; then
+  echo 'Usage: bash scripts/launch_four.sh --launch-reviewed (only after coordinator review)' >&2
+  exit 2
+fi
+export CUDA_VISIBLE_DEVICES=''
+exec "$PYTHON_BIN" scripts/server_jobs.py --launch-reviewed
diff --git a/scripts/monitor_loop.sh b/scripts/monitor_loop.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5bc42df25d01df7e074d722919e8230f9c5a5f2d
--- /dev/null
+++ b/scripts/monitor_loop.sh
@@ -0,0 +1,93 @@
+#!/usr/bin/env bash
+set -euo pipefail
+source "$(dirname -- "${BASH_SOURCE[0]}")/runtime.sh"
+MONITOR_DIR="$ROOT_DIR/logs/server_monitor"
+mkdir -p "$MONITOR_DIR"
+exec 9>"$MONITOR_DIR/daemon.lock"
+flock -n 9 || exit 0
+echo "$$" > "$MONITOR_DIR/monitor.pid"
+export CODEX_HOME="$ROOT_DIR/.codex_runtime"
+export CUDA_VISIBLE_DEVICES=4,5,6,7
+# Reuse the network setup from run_codegen.sh without reading credentials.
+set +eu
+source /data/interns/zhangpc/.bashrc
+clashon
+NETWORK_EXIT=$?
+set -eu
+if (( NETWORK_EXIT != 0 )); then
+  echo 'blocked_network_setup' > "$MONITOR_DIR/state.txt"
+  echo 'Existing clashon network setup failed; see daemon.log' >&2
+  exit 1
+fi
+cd "$ROOT_DIR"
+# Reapply workspace cache paths if shell initialization changed them.
+source "$ROOT_DIR/scripts/runtime.sh"
+export CODEX_HOME="$ROOT_DIR/.codex_runtime" CUDA_VISIBLE_DEVICES=4,5,6,7
+CLI_FAILURES=0
+trap 'date -u +%FT%TZ > "$MONITOR_DIR/stopped_at.txt"' EXIT
+while true; do
+  CHECK_ID="$(date -u +%Y%m%dT%H%M%SZ)_$$"
+  CHECK_DIR="$MONITOR_DIR/$CHECK_ID"
+  mkdir -p "$CHECK_DIR"
+  date -u +%FT%TZ > "$MONITOR_DIR/last_check.txt"
+  date -u -d '+2400 seconds' +%FT%TZ > "$MONITOR_DIR/next_check.txt"
+  # Separate check lock covers BOTH state reads and the entire CLI invocation.
+  exec 7>"$MONITOR_DIR/check.lock"
+  flock 7
+  CUDA_VISIBLE_DEVICES='' "$PYTHON_BIN" scripts/server_jobs.py --status > "$CHECK_DIR/before.json"
+  if "$PYTHON_BIN" - "$CHECK_DIR/before.json" <<'PY'
+import json, sys
+sys.exit(0 if json.load(open(sys.argv[1]))['all_complete'] else 1)
+PY
+  then
+    cp "$CHECK_DIR/before.json" "$MONITOR_DIR/final_summary.json"
+    echo 'complete' > "$MONITOR_DIR/state.txt"
+    echo 'All four selected-best checkpoint tests and complete exports verified.'
+    rm -f "$MONITOR_DIR/next_check.txt"
+    exit 0
+  fi
+  echo 'monitoring' > "$MONITOR_DIR/state.txt"
+  # A CLI timeout affects ONLY this check, never a project training process.
+  if timeout --signal=TERM --kill-after=30s 1200s \
+      /data/interns/zhangpc/.local/bin/codex exec \
+      --skip-git-repo-check --ephemeral --ignore-user-config \
+      -s workspace-write -c 'sandbox_workspace_write.network_access=true' \
+      -c 'model_reasoning_effort="low"' -m gpt-6.1-sol -C "$ROOT_DIR" \
+      -o "$CHECK_DIR/codex_final.txt" - < docs/server_monitor_prompt.md \
+      > "$CHECK_DIR/codex.log" 2>&1; then
+    CLI_FAILURES=0
+  else
+    CLI_EXIT=$?
+    CLI_FAILURES=$((CLI_FAILURES + 1))
+    printf '%s exit=%s consecutive_failures=%s\n' "$CHECK_ID" "$CLI_EXIT" "$CLI_FAILURES" >> "$MONITOR_DIR/cli_failures.log"
+  fi
+  CUDA_VISIBLE_DEVICES='' "$PYTHON_BIN" scripts/server_jobs.py --status > "$CHECK_DIR/after.json"
+  OUTCOME="$("$PYTHON_BIN" - "$CHECK_DIR/after.json" "$CLI_FAILURES" <<'PY'
+import json, sys
+state = json.load(open(sys.argv[1]))
+if state['all_complete']:
+    print('complete')
+elif all(r['state'] in ('complete', 'exhausted') for r in state['runs'].values()):
+    print('blocked_recovery_budget')
+elif int(sys.argv[2]) >= 3:
+    print('blocked_codex_unavailable')
+else:
+    print('monitoring')
+PY
+  )"
+  echo "$OUTCOME" > "$MONITOR_DIR/state.txt"
+  if [[ "$OUTCOME" != monitoring ]]; then
+    cp "$CHECK_DIR/after.json" "$MONITOR_DIR/final_summary.json"
+    rm -f "$MONITOR_DIR/next_check.txt"
+    [[ "$OUTCOME" == complete ]] && exit 0
+    echo "Monitor blocked: $OUTCOME; see final_summary.json and attempt logs" >&2
+    exit 1
+  fi
+  flock -u 7
+  # Maintain a 2400-second interval between check starts, including CLI time.
+  NEXT_EPOCH="$(date -u -d "$(cat "$MONITOR_DIR/next_check.txt")" +%s)"
+  NOW_EPOCH="$(date -u +%s)"
+  if (( NEXT_EPOCH > NOW_EPOCH )); then
+    sleep "$((NEXT_EPOCH - NOW_EPOCH))"
+  fi
+done
