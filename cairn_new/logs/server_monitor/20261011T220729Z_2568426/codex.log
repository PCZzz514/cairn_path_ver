CUDA_VISIBLE_DEVICES='"'' \""'$PYTHON_BIN" - <<'"'PY'
import json, pathlib, datetime
root=pathlib.Path.cwd()
s=json.loads((root/'logs/server_jobs/status.json').read_text())
for arm, run in s['runs'].items():
 d=root/'logs/server_jobs'/arm
 rec=json.loads((d/'record.json').read_text())
 child=json.loads((d/f\"attempt_{rec['attempt']}_process.json\").read_text())
 for role, info in [('wrapper',rec),('child',child)]:
  p=pathlib.Path('/proc')/str(info['pid'])/'stat'
  if p.exists():
   stat=p.read_text().rsplit(')',1)[1].split()
   print(arm,role,info['pid'],'state',stat[0],'identity_matches',stat[19]==info['process_start'])
  else: print(arm,role,'absent')
 exitpath=pathlib.Path(rec['exit_file'])
 print(arm,'exit',json.loads(exitpath.read_text()) if exitpath.exists() else None)
 out=root/'outputs'/arm
 print(arm,'output_files',[(p.name,p.stat().st_size) for p in out.iterdir() if p.is_file()])
 for p in out.glob('*history*'):
  if p.is_file(): print(arm,p.name,'tail',p.read_text().splitlines()[-1:])
if all(v['state'] in ('live','complete') for v in s['runs'].values()):
 note={'checked_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'runs':{a:v['state'] for a,v in s['runs'].items()},'changed':False}
 dest=root/'logs/server_monitor/check_note.json'
 dest.parent.mkdir(parents=True,exist_ok=True)
 tmp=dest.with_suffix('.tmp')
 tmp.write_text(json.dumps(note,indent=2)+'\\n')
 tmp.replace(dest)
