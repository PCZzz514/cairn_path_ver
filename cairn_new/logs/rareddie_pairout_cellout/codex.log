#!/usr/bin/env bash
# Source only. Runtime for the isolated rareddie_control arms. The cairn
# environment, cairn_dev, accelerated_four, cairn_dsn and scripts/ are
# read-only; caches/temporary files stay under rareddie_control and its logs.
set -euo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CONTROL_DIR="$ROOT_DIR/rareddie_control"
LOG_DIR="$ROOT_DIR/logs/rareddie_control"
cd "$ROOT_DIR"
export PYTHONDONTWRITEBYTECODE=1
# rareddie_control (new) and accelerated_four (reused, read-only) resolve from ROOT.
export PYTHONPATH="$ROOT_DIR"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export TMPDIR="$LOG_DIR/tmp"
export XDG_CACHE_HOME="$CONTROL_DIR/.cache"
export TORCH_HOME="$CONTROL_DIR/.cache/torch"
export TRITON_CACHE_DIR="$CONTROL_DIR/.cache/triton"
export CUDA_CACHE_PATH="$CONTROL_DIR/.cache/cuda"
export MPLCONFIGDIR="$CONTROL_DIR/.cache/matplotlib"
export NUMBA_CACHE_DIR="$CONTROL_DIR/.cache/numba"
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
PYTHON_BIN="$ROOT_DIR/../cairn_dev/.conda/cairn/bin/python"
mkdir -p "$TMPDIR" "$XDG_CACHE_HOME" "$TORCH_HOME" "$TRITON_CACHE_DIR" "$CUDA_CACHE_PATH" "$MPLCONFIGDIR" "$NUMBA_CACHE_DIR"
#!/usr/bin/env bash
# Host launch of both rareddie_control arms (GPU6 single_drugout, GPU7
# double_drugout). Codex runs this ONLY after writing
# logs/rareddie_control/review_approval.json; the controller refuses otherwise.
# Each arm: detached session (wrapper orphaned -> PPID 1) holding its job.lock,
# inherited by the training child, --fresh. Then waits (bounded) for the actual
# first update and a 100-update line of both arms; writes launch.json.
# Usage: bash rareddie_control/launch.sh --launch-reviewed
source "$(dirname -- "${BASH_SOURCE[0]}")/env.sh"
if [[ "${1:-}" != --launch-reviewed || $# != 1 ]]; then
  echo 'Usage: bash rareddie_control/launch.sh --launch-reviewed (only after Codex review approval)' >&2
  exit 2
fi
CUDA_VISIBLE_DEVICES='' "$PYTHON_BIN" rareddie_control/jobs.py --launch-reviewed
CUDA_VISIBLE_DEVICES='' "$PYTHON_BIN" rareddie_control/confirm_launch.py --wait 1800
#!/usr/bin/env bash
# Start the detached rareddie_control monitor daemon ONLY after both jobs have
# records and confirmed real progress. The daemon is double-forked (setsid -f,
# PPID 1, own session). Waits for its FIRST SUCCESSFUL check: Codex exit 0,
# after.json and next_check.txt persisted. Safe to repeat while it is live.
# Usage: bash rareddie_control/monitor/start_monitor.sh
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/../env.sh"
export CUDA_VISIBLE_DEVICES=''
MONITOR_DIR="$LOG_DIR/monitor"
mkdir -p "$MONITOR_DIR"
# Serialize monitor launches separately from its long-lived daemon lock.
exec 8>"$MONITOR_DIR/launcher.lock"
flock -n 8 || { echo 'Another monitor launch is in progress' >&2; exit 1; }
if ! flock -n "$MONITOR_DIR/daemon.lock" true; then
  echo "Monitor is already running; see $MONITOR_DIR/monitor.pid"
  exit 0
fi
"$PYTHON_BIN" - "$MONITOR_DIR" <<'PY'
import subprocess
import sys
import time
from pathlib import Path
from rareddie_control.jobs import ARMS, STATE, process_start
from rareddie_control.confirm_launch import arm_state, ps
from rareddie_control.status import update_status
monitor = Path(sys.argv[1])
for arm in ARMS:
    if not (STATE / arm / 'record.json').is_file():
        raise SystemExit('Launch and confirm both jobs before starting the monitor')
    state = arm_state(arm)
    if not (state['progress_confirmed'] or state['exit'] is not None):
        raise SystemExit(f'{arm}: no confirmed real progress yet (fresh start, first update, 100-update line)')
if not Path('/data/interns/zhangpc/.local/bin/codex').is_file():
    raise SystemExit('Existing Codex CLI is unavailable')
root = Path.cwd()
(monitor / 'monitor.pid').unlink(missing_ok=True)
started = time.time()
with (monitor / 'daemon.log').open('a') as log:
    subprocess.run(['setsid', '-f', 'bash', str(root / 'rareddie_control/monitor/monitor_loop.sh')], cwd=root,
                   stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, close_fds=True, check=True)
for _ in range(300):
    if (monitor / 'monitor.pid').is_file() and (monitor / 'monitor.pid').read_text().strip():
        break
    time.sleep(0.1)
else:
    raise SystemExit(f'Monitor did not start; see {monitor}/daemon.log')
pid = int((monitor / 'monitor.pid').read_text())
# First check is immediate; Codex is bounded by 1200 s plus 30 s kill grace.
deadline = started + 1500
while time.time() < deadline:
    if process_start(pid) is None:
        raise SystemExit(f'Monitor PID {pid} exited before its first check completed; see {monitor}/daemon.log')
    checks = sorted((monitor / 'checks').glob(f'*_{pid}'))
